<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="#121212">
<meta property="og:title" content="{{basics.fullName}} | {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}{{/if}}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ═══ DESIGNER PORTFOLIO — Bold Dark Creative Theme ═══ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --font-head: 'Space Grotesk', sans-serif;
  --font-body: 'Inter', sans-serif;
  --bg: {{#if customization.bgColor}}{{customization.bgColor}}{{else}}#121212{{/if}};
  --bg-deep: #0a0a0a;
  --bg-card: rgba(26,26,26,0.7);
  --primary: {{#if customization.primaryColor}}{{customization.primaryColor}}{{else}}#ff6b6b{{/if}};
  --primary-glow: rgba(255,107,107,0.35);
  --primary-dim: rgba(255,107,107,0.1);
  --secondary: {{#if customization.accentColor}}{{customization.accentColor}}{{else}}#a78bfa{{/if}};
  --secondary-dim: rgba(167,139,250,0.1);
  --accent: #fafafa; --text: #fafafa; --text-secondary: #a0a0a0;
  --text-muted: #606060; --border: rgba(255,107,107,0.08);
  --radius: 12px; --radius-sm: 8px;
  --ease: cubic-bezier(0.25,0.46,0.45,0.94);
}
html { scroll-behavior: smooth; font-size: 16px; }
body { font-family: var(--font-body); background: var(--bg); color: var(--text); line-height: 1.7; -webkit-font-smoothing: antialiased; }
a { text-decoration: none; color: inherit; }
img { max-width: 100%; display: block; }

@keyframes fadeInUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
@keyframes underlineDraw { from { stroke-dashoffset:300; } to { stroke-dashoffset:0; } }
@keyframes pulseGlow { 0%,100% { box-shadow:0 0 0 0 var(--primary-glow); } 50% { box-shadow:0 0 20px 4px var(--primary-glow); } }

/* ═══ NAV ═══ */
.nav { position:fixed; top:0; left:0; right:0; z-index:1000; padding:20px 48px; display:flex; justify-content:space-between; align-items:center; background:rgba(18,18,18,0.9); backdrop-filter:blur(14px); border-bottom:1px solid var(--border); }
.nav-brand { font-family:var(--font-head); font-weight:600; font-size:1.1rem; color:var(--text); }
.nav-brand span { color:var(--primary); }
.nav-links { display:flex; gap:28px; }
.nav-links a { color:var(--text-secondary); font-size:0.85rem; font-weight:500; transition:color 200ms; }
.nav-links a:hover { color:var(--primary); }
.mobile-toggle { display:none; background:none; border:none; cursor:pointer; flex-direction:column; gap:5px; padding:4px; }
.mobile-toggle span { display:block; width:22px; height:1.5px; background:var(--text); }

/* ═══ LAYOUT ═══ */
.container { max-width:1200px; margin:0 auto; padding:0 40px; }
.section { padding:100px 0; }
.section-label { font-family:var(--font-head); font-size:0.75rem; font-weight:500; text-transform:uppercase; letter-spacing:0.12em; color:var(--primary); margin-bottom:12px; }
.section-title { font-family:var(--font-head); font-size:2.2rem; font-weight:700; line-height:1.2; letter-spacing:-0.02em; color:var(--text); margin-bottom:48px; }
.section-title em { font-style:normal; color:var(--primary); }

/* ═══ HERO ═══ */
.hero { min-height:100vh; display:flex; align-items:center; background:var(--bg-deep); padding-top:80px; position:relative; overflow:hidden; }
.hero::before { content:''; position:absolute; top:-40%; right:-20%; width:600px; height:600px; border-radius:50%; background:radial-gradient(circle,var(--primary-glow) 0%,transparent 70%); pointer-events:none; opacity:0.3; }
.hero-content { position:relative; z-index:1; max-width:800px; animation:fadeInUp 0.8s var(--ease) both; }
.hero-name { font-family:var(--font-head); font-size:clamp(3rem,7vw,5.5rem); font-weight:700; line-height:1.05; letter-spacing:-0.03em; color:var(--text); display:inline-block; }
.hero-name-underline { display:block; width:100%; margin-top:4px; }
.hero-name-underline path { stroke:var(--primary); stroke-width:3; fill:none; stroke-dasharray:300; stroke-dashoffset:300; animation:underlineDraw 1.2s 0.6s var(--ease) forwards; }
.hero-subtitle { font-family:var(--font-head); font-size:clamp(1.1rem,2.5vw,1.5rem); font-weight:400; color:var(--secondary); margin-top:20px; }
.hero-bio { font-size:1.05rem; color:var(--text-secondary); line-height:1.8; margin-top:24px; max-width:600px; }
.hero-actions { display:flex; gap:16px; margin-top:40px; flex-wrap:wrap; }
.hero-metrics { display:flex; gap:40px; margin-top:48px; flex-wrap:wrap; }
.hero-metric-val { font-family:var(--font-head); font-size:2rem; font-weight:700; color:var(--primary); line-height:1; }
.hero-metric-label { font-size:0.78rem; color:var(--text-muted); margin-top:6px; text-transform:uppercase; letter-spacing:0.06em; }

/* ═══ BUTTONS ═══ */
.btn { display:inline-flex; align-items:center; justify-content:center; padding:14px 32px; font-family:var(--font-body); font-size:0.88rem; font-weight:600; letter-spacing:0.02em; border-radius:var(--radius-sm); transition:all 250ms var(--ease); cursor:pointer; border:none; }
.btn-coral { background:var(--primary); color:#fff; box-shadow:0 4px 16px var(--primary-glow); }
.btn-coral:hover { transform:translateY(-2px); box-shadow:0 8px 28px var(--primary-glow); }
.btn-ghost { background:transparent; color:var(--text); border:1.5px solid var(--border); }
.btn-ghost:hover { border-color:var(--primary); color:var(--primary); }

/* ═══ MASONRY / PROJECTS ═══ */
.masonry { columns:2; column-gap:24px; }
.masonry-card { break-inside:avoid; margin-bottom:24px; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; transition:all 350ms var(--ease); }
.masonry-card:hover { transform:scale(1.02); border-color:rgba(255,107,107,0.25); box-shadow:0 8px 40px var(--primary-glow); }
.masonry-card:nth-child(odd) .masonry-body { min-height:200px; }
.masonry-card:nth-child(even) .masonry-body { min-height:140px; }
.masonry-body { padding:28px; }
.masonry-title { font-family:var(--font-head); font-size:1.15rem; font-weight:600; color:var(--text); margin-bottom:10px; }
.masonry-desc { font-size:0.92rem; color:var(--text-secondary); line-height:1.7; }
.masonry-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:16px; }
.masonry-tag { font-size:0.72rem; font-weight:500; padding:4px 12px; border-radius:100px; background:var(--secondary-dim); color:var(--secondary); text-transform:uppercase; letter-spacing:0.03em; }
.masonry-link { display:inline-flex; align-items:center; gap:6px; font-size:0.82rem; font-weight:500; color:var(--primary); margin-top:14px; transition:gap 200ms; }
.masonry-link:hover { gap:10px; }

/* ═══ SKILLS ═══ */
.skills-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:32px; }
.skill-group-title { font-family:var(--font-head); font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); margin-bottom:16px; }
.skill-tags { display:flex; flex-wrap:wrap; gap:8px; }
.skill-tag { font-size:0.82rem; padding:6px 16px; border-radius:100px; background:var(--secondary-dim); color:var(--secondary); font-weight:500; transition:all 200ms; }
.skill-tag:hover { background:var(--secondary); color:var(--bg-deep); }

/* ═══ DESIGN PROCESS ═══ */
.process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:24px; }
.process-step { position:relative; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:32px 24px; text-align:center; transition:all 300ms var(--ease); }
.process-step:hover { border-color:var(--primary); transform:translateY(-4px); box-shadow:0 12px 32px rgba(0,0,0,0.3); }
.process-num { font-family:var(--font-head); font-size:3rem; font-weight:700; color:var(--primary-dim); line-height:1; margin-bottom:12px; }
.process-icon { width:48px; height:48px; margin:0 auto 16px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:var(--primary-dim); }
.process-icon svg { width:24px; height:24px; color:var(--primary); }
.process-label { font-family:var(--font-head); font-size:1rem; font-weight:600; color:var(--text); margin-bottom:8px; }
.process-desc { font-size:0.82rem; color:var(--text-secondary); line-height:1.6; }
.process-step::after { content:''; position:absolute; top:50%; right:-13px; width:24px; height:1px; background:var(--border); }
.process-step:last-child::after { display:none; }

/* ═══ EXPERIENCE TIMELINE ═══ */
.timeline { position:relative; padding-left:32px; }
.timeline::before { content:''; position:absolute; left:0; top:0; bottom:0; width:2px; background:linear-gradient(to bottom,var(--primary),var(--secondary)); border-radius:2px; }
.timeline-item { position:relative; padding:0 0 48px 28px; }
.timeline-item:last-child { padding-bottom:0; }
.timeline-item::before { content:''; position:absolute; left:-37px; top:6px; width:12px; height:12px; border-radius:50%; background:var(--primary); border:3px solid var(--bg); box-shadow:0 0 0 2px var(--primary); }
.timeline-company { display:inline-flex; padding:4px 14px; background:var(--primary-dim); border-radius:100px; font-size:0.78rem; font-weight:600; color:var(--primary); margin-bottom:8px; }
.timeline-role { font-family:var(--font-head); font-size:1.15rem; font-weight:600; color:var(--text); }
.timeline-date { font-size:0.82rem; color:var(--text-muted); margin-top:4px; font-weight:500; }
.timeline-desc { font-size:0.92rem; color:var(--text-secondary); margin-top:10px; line-height:1.7; }

/* ═══ EDUCATION ═══ */
.edu-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:24px; }
.edu-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:28px; transition:all 300ms var(--ease); }
.edu-card:hover { transform:scale(1.02); border-color:rgba(255,107,107,0.25); box-shadow:0 8px 40px var(--primary-glow); }
.edu-degree { font-family:var(--font-head); font-size:1.05rem; font-weight:600; color:var(--text); }
.edu-institution { font-size:0.92rem; color:var(--secondary); margin-top:6px; }
.edu-year { font-size:0.78rem; color:var(--text-muted); margin-top:8px; font-weight:500; }

/* ═══ ENDORSEMENTS ═══ */
.endorsement-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(340px,1fr)); gap:24px; }
.endorsement-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:32px; position:relative; transition:all 300ms var(--ease); }
.endorsement-card:hover { transform:scale(1.02); border-color:rgba(255,107,107,0.25); box-shadow:0 8px 40px var(--primary-glow); }
.endorsement-mark { font-family:var(--font-head); font-size:3.5rem; line-height:1; color:var(--primary); opacity:0.5; position:absolute; top:20px; left:28px; }
.endorsement-text { font-size:0.95rem; color:var(--text-secondary); line-height:1.8; font-style:italic; margin-top:24px; }
.endorsement-author { margin-top:20px; }
.endorsement-name { font-family:var(--font-head); font-size:0.92rem; font-weight:600; color:var(--text); }
.endorsement-role { font-size:0.78rem; color:var(--text-muted); margin-top:2px; }

/* ═══ CERTIFICATIONS & LANGUAGES ═══ */
.cert-strip { display:flex; flex-wrap:wrap; gap:16px; }
.cert-badge { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius-sm); padding:16px 24px; transition:all 200ms var(--ease); }
.cert-badge:hover { border-color:var(--secondary); box-shadow:0 4px 16px rgba(167,139,250,0.15); }
.cert-name { font-family:var(--font-head); font-size:0.88rem; font-weight:600; color:var(--text); }
.cert-issuer { font-size:0.78rem; color:var(--text-muted); margin-top:4px; }
.lang-list { display:flex; flex-wrap:wrap; gap:12px; }
.lang-chip { display:flex; align-items:center; gap:8px; padding:8px 18px; border-radius:100px; background:var(--bg-card); border:1px solid var(--border); font-size:0.85rem; color:var(--text); }
.lang-chip .level { font-size:0.72rem; color:var(--text-muted); font-weight:500; }

/* ═══ FOOTER ═══ */
.footer { background:var(--bg-deep); border-top:1px solid var(--border); padding:80px 0 40px; }
.footer-cta { text-align:center; margin-bottom:60px; }
.footer-cta-title { font-family:var(--font-head); font-size:2.5rem; font-weight:700; color:var(--text); letter-spacing:-0.02em; }
.footer-cta-title em { font-style:normal; color:var(--primary); }
.footer-cta-sub { font-size:1rem; color:var(--text-secondary); margin-top:12px; }
.footer-cta .btn-coral { margin-top:28px; padding:16px 40px; font-size:0.95rem; animation:pulseGlow 3s ease-in-out infinite; }
.footer-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:40px; padding-top:40px; border-top:1px solid var(--border); }
.footer-col h4 { font-family:var(--font-head); font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-muted); margin-bottom:12px; }
.footer-col p, .footer-col a { font-size:0.92rem; color:var(--text-secondary); line-height:1.8; }
.footer-col a:hover { color:var(--primary); }
.footer-social { display:flex; gap:12px; margin-top:12px; }
.footer-social a { display:inline-flex; align-items:center; justify-content:center; width:40px; height:40px; border-radius:50%; border:1px solid var(--border); color:var(--text-secondary); transition:all 200ms; }
.footer-social a:hover { color:var(--primary); border-color:var(--primary); background:var(--primary-dim); }
.footer-social svg { width:18px; height:18px; }
.footer-bottom { text-align:center; margin-top:40px; padding-top:20px; border-top:1px solid var(--border); font-size:0.78rem; color:var(--text-muted); }

/* ═══ PRINT ═══ */
@media print {
  .nav { position:static; background:#fff; }
  body, .hero, .footer, .section { background:#fff !important; color:#111 !important; }
  .hero::before { display:none; }
  .hero-name, .section-title, .masonry-title, .timeline-role, .edu-degree, .endorsement-name, .footer-cta-title { color:#111 !important; }
  .hero-subtitle { color:#6b21a8 !important; }
  .hero-bio, .masonry-desc, .timeline-desc, .endorsement-text, .process-desc { color:#444 !important; }
  .section-label, .timeline-company, .masonry-link { color:#dc2626 !important; }
  .masonry-card, .edu-card, .endorsement-card, .process-step, .cert-badge { background:#fff !important; border-color:#ddd !important; box-shadow:none !important; break-inside:avoid; }
  .skill-tag, .masonry-tag { background:#f3f4f6 !important; color:#374151 !important; }
}

/* ═══ RESPONSIVE ═══ */
@media (max-width:1024px) {
  .process-grid { grid-template-columns:repeat(2,1fr); }
  .process-step:nth-child(2)::after { display:none; }
  .footer-grid { grid-template-columns:1fr 1fr; }
}
@media (max-width:768px) {
  .nav { padding:14px 24px; }
  .nav-links { display:none; }
  .mobile-toggle { display:flex; }
  .nav-links.open { display:flex; flex-direction:column; position:absolute; top:100%; left:0; right:0; background:rgba(18,18,18,0.95); backdrop-filter:blur(14px); padding:16px 24px; gap:0; border-bottom:1px solid var(--border); }
  .nav-links.open a { display:block; padding:12px 0; }
  .container { padding:0 24px; }
  .section { padding:64px 0; }
  .hero { min-height:auto; padding:120px 0 80px; }
  .hero-name { font-size:2.6rem; }
  .masonry { columns:1; }
  .skills-grid, .process-grid, .edu-grid, .endorsement-grid { grid-template-columns:1fr; }
  .process-step::after { display:none; }
  .footer-grid { grid-template-columns:1fr; gap:28px; }
}

/* ═══ RTL ═══ */
[dir="rtl"] .timeline { padding-left:0; padding-right:32px; }
[dir="rtl"] .timeline::before { left:auto; right:0; }
[dir="rtl"] .timeline-item { padding-left:0; padding-right:28px; }
[dir="rtl"] .timeline-item::before { left:auto; right:-37px; }
[dir="rtl"] .process-step::after { right:auto; left:-13px; }
[dir="rtl"] .endorsement-mark { left:auto; right:28px; }
</style>
</head>
<body>

<!-- ═══ NAV ═══ -->
<nav class="nav">
  <div class="nav-brand">{{basics.fullName}}<span>.</span></div>
  <div class="nav-links">
    <a href="#hero">Home</a>
    {{#if projects}}<a href="#portfolio">Portfolio</a>{{/if}}
    {{#if skills}}<a href="#skills">Skills</a>{{/if}}
    {{#if experience}}<a href="#experience">Experience</a>{{/if}}
    {{#if education}}<a href="#education">Education</a>{{/if}}
    <a href="#contact">Contact</a>
  </div>
  <button class="mobile-toggle" aria-label="Menu"><span></span><span></span><span></span></button>
</nav>

<!-- ═══ 1. HERO ═══ -->
{{#unless (isHidden "hero")}}
<section class="hero section" id="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-name">
        {{basics.fullName}}
        <svg class="hero-name-underline" viewBox="0 0 300 12" preserveAspectRatio="none"><path d="M0 9 Q75 0 150 6 Q225 12 300 3"/></svg>
      </h1>
      <div class="hero-subtitle">{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{/if}}</div>
      {{#if basics.bio}}<p class="hero-bio">{{basics.bio}}</p>{{else}}{{#if basics.valueProposition}}<p class="hero-bio">{{basics.valueProposition}}</p>{{/if}}{{/if}}
      {{#if metrics}}
      <div class="hero-metrics">
        {{#each metrics}}<div><div class="hero-metric-val">{{this.value}}</div><div class="hero-metric-label">{{this.label}}</div></div>{{/each}}
      </div>
      {{/if}}
      <div class="hero-actions">
        {{#if basics.email}}<a href="mailto:{{basics.email}}" class="btn btn-coral">Get in Touch</a>{{/if}}
        {{#if projects}}<a href="#portfolio" class="btn btn-ghost">View Portfolio</a>{{/if}}
      </div>
    </div>
  </div>
</section>
{{/unless}}

<!-- ═══ 2. PORTFOLIO / PROJECTS ═══ -->
{{#if projects}}
{{#unless (isHidden "portfolio")}}
<section class="section" id="portfolio" style="background:var(--bg);">
  <div class="container">
    <div class="section-label">Selected Work</div>
    <div class="section-title">Creative <em>Portfolio</em></div>
    <div class="masonry">
      {{#each projects}}
      <article class="masonry-card">
        <div class="masonry-body">
          <h3 class="masonry-title">{{title}}</h3>
          {{#if description}}<p class="masonry-desc">{{description}}</p>{{/if}}
          {{#if technologies}}<div class="masonry-tags">{{#each technologies}}<span class="masonry-tag">{{this}}</span>{{/each}}</div>{{/if}}
          {{#if link}}<a href="{{link}}" target="_blank" class="masonry-link">View Project <svg fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" style="width:14px;height:14px"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg></a>{{/if}}
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ 3. SKILLS ═══ -->
{{#if skills}}
{{#unless (isHidden "skills")}}
<section class="section" id="skills" style="background:var(--bg-deep);">
  <div class="container">
    <div class="section-label">Expertise</div>
    <div class="section-title">Skills &amp; <em>Tools</em></div>
    <div class="skills-grid">
      {{#each skills}}
      <div>
        <div class="skill-group-title">{{category}}</div>
        <div class="skill-tags">{{#each items}}<span class="skill-tag">{{this}}</span>{{/each}}</div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ 4. DESIGN PROCESS ═══ -->
{{#if experience}}
{{#unless (isHidden "design-process")}}
<section class="section" id="process" style="background:var(--bg);">
  <div class="container">
    <div class="section-label">How I Work</div>
    <div class="section-title">Design <em>Process</em></div>
    <div class="process-grid">
      <div class="process-step">
        <div class="process-num">01</div>
        <div class="process-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg></div>
        <div class="process-label">Research</div>
        <div class="process-desc">Understanding users, business goals, and market context to define the problem space.</div>
      </div>
      <div class="process-step">
        <div class="process-num">02</div>
        <div class="process-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg></div>
        <div class="process-label">Design</div>
        <div class="process-desc">Exploring concepts through wireframes, prototypes, and visual explorations.</div>
      </div>
      <div class="process-step">
        <div class="process-num">03</div>
        <div class="process-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg></div>
        <div class="process-label">Build</div>
        <div class="process-desc">Translating designs into pixel-perfect, accessible, and performant interfaces.</div>
      </div>
      <div class="process-step">
        <div class="process-num">04</div>
        <div class="process-icon"><svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg></div>
        <div class="process-label">Ship</div>
        <div class="process-desc">Launching, measuring impact, iterating based on real user feedback and data.</div>
      </div>
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ 5. EXPERIENCE ═══ -->
{{#if experience}}
{{#unless (isHidden "experience")}}
<section class="section" id="experience" style="background:var(--bg-deep);">
  <div class="container">
    <div class="section-label">Career</div>
    <div class="section-title">Professional <em>Experience</em></div>
    <div class="timeline">
      {{#each experience}}
      <article class="timeline-item">
        <div class="timeline-company">{{company}}</div>
        <h3 class="timeline-role">{{title}}</h3>
        <div class="timeline-date">{{startDate}}{{#if endDate}} — {{endDate}}{{else}} — Present{{/if}}</div>
        {{#if description}}<p class="timeline-desc">{{description}}</p>{{/if}}
      </article>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ 6. EDUCATION ═══ -->
{{#if education}}
{{#unless (isHidden "education")}}
<section class="section" id="education" style="background:var(--bg);">
  <div class="container">
    <div class="section-label">Background</div>
    <div class="section-title">Education &amp; <em>Training</em></div>
    <div class="edu-grid">
      {{#each education}}
      <article class="edu-card">
        <h3 class="edu-degree">{{degree}}</h3>
        <div class="edu-institution">{{institution}}</div>
        <div class="edu-year">{{year}}</div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ CERTIFICATIONS ═══ -->
{{#if certifications}}
{{#unless (isHidden "certifications")}}
<section class="section" style="background:var(--bg-deep);">
  <div class="container">
    <div class="section-label">Credentials</div>
    <div class="section-title"><em>Certifications</em></div>
    <div class="cert-strip">
      {{#each certifications}}
      <div class="cert-badge"><div class="cert-name">{{this.name}}</div><div class="cert-issuer">{{this.issuer}}</div></div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ LANGUAGES ═══ -->
{{#if languages}}
{{#unless (isHidden "languages")}}
<section class="section" style="background:var(--bg);">
  <div class="container">
    <div class="section-label">Communication</div>
    <div class="section-title"><em>Languages</em></div>
    <div class="lang-list">
      {{#each languages}}<div class="lang-chip">{{this.name}}{{#if this.level}} <span class="level">{{this.level}}</span>{{/if}}</div>{{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ 7. ENDORSEMENTS ═══ -->
{{#if endorsements}}
{{#unless (isHidden "endorsements")}}
<section class="section" id="endorsements" style="background:var(--bg-deep);">
  <div class="container">
    <div class="section-label">Testimonials</div>
    <div class="section-title">What People <em>Say</em></div>
    <div class="endorsement-grid">
      {{#each endorsements}}
      <article class="endorsement-card">
        <div class="endorsement-mark">&ldquo;</div>
        <p class="endorsement-text">{{this.quote}}</p>
        <div class="endorsement-author">
          <div class="endorsement-name">{{this.name}}</div>
          <div class="endorsement-role">{{this.title}}{{#if this.company}}, {{this.company}}{{/if}}</div>
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- ═══ 8. CONTACT / FOOTER ═══ -->
{{#unless (isHidden "contact")}}
<footer class="footer" id="contact">
  <div class="container">
    <div class="footer-cta">
      <h2 class="footer-cta-title">Let's create something <em>amazing</em></h2>
      <p class="footer-cta-sub">Have a project in mind? I'd love to hear about it.</p>
      {{#if basics.email}}<a href="mailto:{{basics.email}}" class="btn btn-coral">Start a Conversation</a>{{/if}}
    </div>
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Location</h4>
        <p>{{#if basics.location}}{{basics.location}}{{else}}Remote{{/if}}</p>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        {{#if basics.email}}<p><a href="mailto:{{basics.email}}">{{basics.email}}</a></p>{{/if}}
        {{#if basics.phone}}<p><a href="tel:{{basics.phone}}">{{basics.phone}}</a></p>{{/if}}
      </div>
      <div class="footer-col">
        <h4>Follow</h4>
        <div class="footer-social">
          {{#if basics.linkedin}}<a href="{{basics.linkedin}}" target="_blank" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>{{/if}}
          {{#if basics.github}}<a href="{{basics.github}}" target="_blank" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a>{{/if}}
          {{#if basics.dribbble}}<a href="{{basics.dribbble}}" target="_blank" aria-label="Dribbble"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 24C5.385 24 0 18.615 0 12S5.385 0 12 0s12 5.385 12 12-5.385 12-12 12zm10.12-10.358c-.35-.11-3.17-.953-6.384-.438 1.34 3.684 1.887 6.684 1.992 7.308a10.29 10.29 0 004.395-6.87zm-6.115 7.808c-.153-.9-.75-4.032-2.19-7.77l-.066.02c-5.79 2.015-7.86 6.025-8.04 6.4a10.161 10.161 0 006.29 2.166c1.42 0 2.77-.29 4.006-.816zM4.095 18.69c.24-.415 3.03-5.023 8.336-6.72.135-.045.27-.084.405-.12-.26-.585-.54-1.167-.832-1.74C7.17 11.775 2.535 11.715 1.92 11.7l-.015.36c0 2.568.96 4.92 2.535 6.69l.015-.06zM2.11 10.035c.63.012 4.635.03 9.21-1.26C9.54 5.79 7.44 3.48 7.14 3.135a10.236 10.236 0 00-5.03 6.9zM8.865 2.55c.315.36 2.445 2.67 4.2 5.73 4.005-1.5 5.7-3.78 5.865-4.02A10.152 10.152 0 0012 1.8c-1.095 0-2.145.18-3.135.75zM20.37 5.4c-.21.27-2.085 2.685-6.24 4.38.24.48.465.975.675 1.47.075.18.15.36.225.54 3.45-.435 6.885.264 7.23.33-.015-2.49-.915-4.77-1.89-6.72z"/></svg></a>{{/if}}
          {{#if basics.behance}}<a href="{{basics.behance}}" target="_blank" aria-label="Behance"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.938 4.503c.702 0 1.34.06 1.92.188.577.13 1.07.33 1.485.61.41.28.733.65.96 1.12.225.47.34 1.05.34 1.73 0 .74-.17 1.36-.507 1.86-.338.5-.837.9-1.502 1.22.906.26 1.576.72 2.022 1.37.448.66.665 1.45.665 2.36 0 .75-.13 1.39-.41 1.93-.28.55-.67 1-1.16 1.35-.48.348-1.05.6-1.67.767-.63.165-1.27.25-1.95.25H0V4.51h6.938v-.007zm9.055 11.07c.44.428 1.073.643 1.9.643.59 0 1.1-.148 1.53-.447.424-.3.68-.61.78-.93h2.548c-.41 1.23-1.04 2.11-1.9 2.63-.858.52-1.9.78-3.12.78-.86 0-1.63-.13-2.32-.4-.69-.27-1.28-.65-1.77-1.14-.49-.49-.87-1.07-1.13-1.77-.27-.69-.4-1.45-.4-2.28 0-.8.13-1.54.4-2.22.27-.68.65-1.27 1.14-1.76.49-.49 1.07-.87 1.75-1.14.68-.27 1.43-.41 2.25-.41.94 0 1.76.18 2.46.56.7.37 1.27.88 1.73 1.52.45.64.78 1.37.97 2.21.19.83.26 1.72.2 2.67h-7.59c.02.94.32 1.7.76 2.12zM15.44 6.3h5.97v1.2h-5.97V6.3z"/></svg></a>{{/if}}
        </div>
      </div>
    </div>
    <div class="footer-bottom">&copy; {{basics.fullName}} — {{basics.title}}</div>
  </div>
</footer>
{{/unless}}

<script>
/* Mobile nav toggle */
var mobileToggle = document.querySelector('.mobile-toggle');
var navLinks = document.querySelector('.nav-links');
if (mobileToggle && navLinks) {
  mobileToggle.addEventListener('click', function() { navLinks.classList.toggle('open'); });
  navLinks.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() { navLinks.classList.remove('open'); });
  });
}
/* Smooth scroll */
document.querySelectorAll('a[href^="#"]').forEach(function(a) {
  a.addEventListener('click', function(e) {
    e.preventDefault();
    var t = document.querySelector(a.getAttribute('href'));
    if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});
</script>
</body>
</html>
