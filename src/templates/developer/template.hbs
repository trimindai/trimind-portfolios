<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{titleCase basics.fullName}}{{#if basics.title}} — {{basics.title}}{{/if}}</title>
<meta name="description" content="{{#if basics.valueProposition}}{{basics.valueProposition}}{{else if basics.bio}}{{basics.bio}}{{else}}{{basics.title}}{{/if}}">
{{faviconLink basics.fullName customization.primaryColor customization.bgColor}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@100;200;300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
{{{personJsonLd basics portfolioUrl}}}
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}

/* ═══════════════════════════════════════════════════════════════
   DEVELOPER — "Spacebar"
   A space-dark developer portfolio: a real 3D keyboard floating in a
   star-field, thin gradient display type, blur-in reveals, a timeline
   of experience, screenshot project cards with a modal, an elastic
   cursor, and buttery smooth scroll.
   Design language adapted from Naresh Khatri's open-source 3D
   portfolio (free to use — credited in the footer).
   ═══════════════════════════════════════════════════════════════ */
:root{
  --bg:{{#if customization.bgColor}}{{safeColor customization.bgColor "#020617"}}{{else}}#020617{{/if}};
  --bg-2:#0b1222;
  --card:rgba(15,23,42,0.55);
  --card-hover:rgba(20,30,55,0.72);
  --fg:#f8fafc;
  --muted:#94a3b8;
  --muted-2:#64748b;
  --border:rgba(148,163,184,0.14);
  --border-strong:rgba(148,163,184,0.28);
  --brand:{{#if customization.primaryColor}}{{safeColor customization.primaryColor "#7c5cff"}}{{else}}#7c5cff{{/if}};
  --accent:{{#if customization.accentColor}}{{safeColor customization.accentColor "#38bdf8"}}{{else}}#38bdf8{{/if}};
  --brand-glow:color-mix(in srgb, var(--brand) 40%, transparent);
  --accent-glow:color-mix(in srgb, var(--accent) 38%, transparent);
  --radius:16px;
  --max:1180px;
  --font-display:"Archivo Black","Inter",sans-serif;
  --font-sans:"Inter",system-ui,sans-serif;
  --font-mono:"JetBrains Mono",ui-monospace,monospace;
}

html{scroll-behavior:smooth}
body{
  font-family:var(--font-sans);
  background:var(--bg);
  color:var(--fg);
  line-height:1.6;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}
/* Deep-space gradient + vignette painted under the 3D scene */
body::before{
  content:"";position:fixed;inset:0;z-index:-3;pointer-events:none;
  background:
    radial-gradient(1200px 800px at 78% 6%, color-mix(in srgb,var(--brand) 14%,transparent), transparent 60%),
    radial-gradient(900px 700px at 8% 92%, color-mix(in srgb,var(--accent) 12%,transparent), transparent 60%),
    linear-gradient(180deg,var(--bg) 0%, var(--bg-2) 50%, var(--bg) 100%);
}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
::selection{background:var(--brand);color:#fff}

/* ── star-field background layer ─────────────────────────────── */
#stars{position:fixed;inset:0;z-index:-2;pointer-events:none}

/* ── scroll progress ────────────────────────────────────────── */
#progress{
  position:fixed;top:0;left:0;height:2px;width:0;z-index:90;
  background:linear-gradient(90deg,var(--brand),var(--accent));
  box-shadow:0 0 12px var(--brand-glow);
}

/* ── elastic cursor (desktop only) ──────────────────────────── */
#cursor,#cursor-dot{position:fixed;top:0;left:0;z-index:100;pointer-events:none;will-change:transform}
#cursor{
  width:34px;height:34px;margin:-17px 0 0 -17px;border-radius:50%;
  border:1.5px solid color-mix(in srgb,var(--fg) 65%,transparent);
  mix-blend-mode:difference;transition:width .25s,height .25s,opacity .25s,background .25s;
}
#cursor-dot{width:5px;height:5px;margin:-2.5px 0 0 -2.5px;border-radius:50%;background:var(--fg);mix-blend-mode:difference}
#cursor.hover{width:56px;height:56px;margin:-28px 0 0 -28px;background:color-mix(in srgb,var(--fg) 12%,transparent)}
@media (hover:none),(pointer:coarse){#cursor,#cursor-dot{display:none}}

/* ── preloader ──────────────────────────────────────────────── */
#preloader{
  position:fixed;inset:0;z-index:200;background:var(--bg);
  display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18px;
  transition:transform .9s cubic-bezier(.76,0,.24,1);
}
#preloader.done{transform:translateY(-101%)}
#preloader .word{font-family:var(--font-display);font-size:clamp(1.4rem,4vw,2.4rem);opacity:.9;display:flex;align-items:center;gap:.5rem}
#preloader .word::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--brand);box-shadow:0 0 16px var(--brand)}
#preloader .pct{font-family:var(--font-mono);color:var(--muted);font-size:.95rem;letter-spacing:.1em}
#preloader .bar{width:min(240px,60vw);height:2px;background:var(--border);overflow:hidden;border-radius:2px}
#preloader .bar > i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--brand),var(--accent))}

/* ── nav ────────────────────────────────────────────────────── */
nav{
  position:fixed;left:50%;transform:translateX(-50%);bottom:22px;z-index:80;
  display:flex;align-items:center;gap:4px;padding:6px;
  background:color-mix(in srgb,var(--bg) 70%,transparent);
  border:1px solid var(--border);border-radius:999px;backdrop-filter:blur(14px);
  box-shadow:0 10px 40px rgba(0,0,0,.45);
}
nav a{font-size:.8rem;color:var(--muted);padding:8px 14px;border-radius:999px;transition:color .2s,background .2s;white-space:nowrap}
nav a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:4px}
nav a.active{color:var(--fg);background:color-mix(in srgb,var(--brand) 22%,transparent)}
@media(max-width:640px){nav a span{display:none}nav a{padding:10px 12px}nav a i{font-size:1rem}}

/* ── layout ─────────────────────────────────────────────────── */
.wrap{max-width:var(--max);margin:0 auto;padding:0 24px}
section{position:relative;z-index:1}
.sec-head{margin-bottom:48px}
.sec-head .eyebrow{font-family:var(--font-mono);color:var(--brand);font-size:.8rem;letter-spacing:.18em;text-transform:uppercase;display:flex;align-items:center;gap:10px}
.sec-head .eyebrow::before{content:"";width:28px;height:1px;background:var(--brand)}
.sec-head h2{font-family:var(--font-display);font-size:clamp(2rem,6vw,3.6rem);line-height:1.02;margin-top:14px;letter-spacing:-.01em}
.sec-head p{color:var(--muted);margin-top:12px;max-width:46ch}

/* ── reveal primitives ──────────────────────────────────────── */
.blur-in{opacity:0;filter:blur(10px);transform:translateY(8px);transition:opacity .9s ease,filter .9s ease,transform .9s ease}
.blur-in.in{opacity:1;filter:blur(0);transform:none}
.box-reveal{opacity:0;transform:translateY(60px);transition:opacity .6s ease,transform .6s cubic-bezier(.22,1,.36,1)}
.box-reveal.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .blur-in,.box-reveal{opacity:1;filter:none;transform:none;transition:none}
  .kbd-deck{animation:none}
}

/* ── hero ───────────────────────────────────────────────────── */
#hero{min-height:100svh;display:flex;align-items:center;padding:120px 0 80px}
#hero .wrap{position:relative}
#hero .grid{display:grid;grid-template-columns:minmax(0,1fr);gap:8px;position:relative;z-index:1}
@media(min-width:900px){#hero .grid{max-width:440px}} /* text owns the left column; the 3D keyboard render owns the right */
/* photoreal split-keyboard hero render (Blender) */
.hero-kbd{position:absolute;right:0;top:50%;transform:translateY(-50%);width:min(48%,660px);height:auto;pointer-events:none;z-index:0;
  filter:drop-shadow(0 30px 50px rgba(0,0,0,.6));
  -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 26%);mask-image:linear-gradient(90deg,transparent 0,#000 26%)}
@media(max-width:900px){.hero-kbd{position:static;transform:none;display:block;width:100%;max-width:520px;margin:28px auto 0;opacity:.92;
  -webkit-mask-image:none;mask-image:none;filter:drop-shadow(0 20px 36px rgba(0,0,0,.55))}}
#hero .hello{font-family:var(--font-mono);color:var(--accent);font-size:.95rem;letter-spacing:.08em;margin-bottom:18px}
#hero h1{
  font-family:var(--font-display);font-weight:400;
  font-size:clamp(2.6rem,11vw,8rem);line-height:.92;letter-spacing:-.02em;margin-left:-.04em;
  background:linear-gradient(180deg,#fff 0%, #cdd6e6 45%, var(--muted-2) 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
#hero .role{font-family:var(--font-display);font-size:clamp(1.1rem,3.4vw,1.9rem);color:var(--muted);margin-top:18px}
#hero .pitch{max-width:54ch;color:var(--muted);margin-top:22px;font-size:1.05rem}
#hero .cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:34px}
.btn{
  display:inline-flex;align-items:center;gap:9px;font-size:.92rem;font-weight:500;
  padding:12px 20px;border-radius:12px;border:1px solid var(--border-strong);
  background:var(--card);transition:transform .2s,border-color .2s,background .2s,box-shadow .2s;
}
.btn:hover{transform:translateY(-2px);border-color:var(--brand);box-shadow:0 0 0 1px var(--brand-glow),0 10px 30px rgba(0,0,0,.4)}
.btn.primary{background:var(--brand);border-color:transparent;color:#fff}
.btn.primary:hover{box-shadow:0 10px 34px var(--brand-glow)}
.btn.icon{padding:12px 14px}
.scroll-cue{margin-top:60px;display:inline-flex;flex-direction:column;align-items:center;gap:6px;color:var(--muted-2);font-family:var(--font-mono);font-size:.72rem;letter-spacing:.2em}
.scroll-cue .mouse{width:22px;height:34px;border:1.5px solid var(--muted-2);border-radius:12px;position:relative}
.scroll-cue .mouse::after{content:"";position:absolute;left:50%;top:7px;width:3px;height:6px;background:var(--muted);border-radius:2px;transform:translateX(-50%);animation:wheel 1.5s infinite}
@keyframes wheel{0%{opacity:0;transform:translate(-50%,0)}40%{opacity:1}100%{opacity:0;transform:translate(-50%,10px)}}

/* ── skills / Dygma-style split 3D keyboard ──────────────────── */
#skills{padding:80px 0 110px;--ks:62px;--glow:#2f6bff;--body:#243049}
.kbd-toolbar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:10px}
.kbd-hint{font-family:var(--font-mono);color:var(--muted-2);font-size:.85rem}
.kbd-sound-wrap{margin-inline-start:auto;display:inline-flex;align-items:center;gap:9px;padding:7px 11px;border-radius:10px;border:1px solid var(--border-strong);background:var(--card);color:var(--muted);transition:border-color .2s,color .2s}
.kbd-sound-wrap:hover{border-color:var(--brand);color:var(--fg)}
.kbd-sound-wrap i{font-size:.8rem}
.kbd-sound{appearance:none;-webkit-appearance:none;background:transparent;border:none;color:var(--fg);font-family:var(--font-mono);font-size:.74rem;letter-spacing:.04em;cursor:pointer;padding-right:4px}
.kbd-sound:focus{outline:none}
.kbd-sound option{background:var(--bg-2);color:var(--fg)}

.kbd-wrap{display:grid;grid-template-columns:1fr;gap:26px;margin-top:36px}
@media(min-width:1040px){.kbd-wrap{grid-template-columns:minmax(0,1fr) 322px;align-items:center}}

/* perspective stage + floating, glowing split chassis */
.kbd-stage{perspective:1800px;perspective-origin:50% 22%}
.kbd-deck{
  position:relative;transform-style:preserve-3d;
  display:flex;justify-content:center;align-items:flex-start;gap:clamp(16px,3vw,46px);
  padding:clamp(22px,2.6vw,40px) clamp(20px,3vw,52px) clamp(28px,3vw,46px);
  border-radius:30px;
  background:linear-gradient(180deg,#1b2335 0%,#11192b 50%,#0a1120 100%);
  border:1px solid rgba(148,163,184,.18);
  box-shadow:0 2px 0 rgba(255,255,255,.06) inset,0 -16px 40px rgba(0,0,0,.5) inset,0 40px 80px -28px rgba(0,0,0,.85),0 12px 0 #060a14,0 0 46px 3px var(--glow),0 0 100px 12px color-mix(in srgb,var(--glow) 45%,transparent);
  transform:rotateX(22deg) rotateY(-5deg);  /* static — no float */
}

/* chassis body colour — per user: black (default) / white / gray */
.kbd-deck.kbd-light{--body:#e9edf4;background:linear-gradient(180deg,#f2f4f8 0%,#dce1ea 50%,#c5cbd8 100%);border-color:rgba(2,6,23,.14);
  box-shadow:0 2px 0 rgba(255,255,255,.7) inset,0 -16px 40px rgba(120,130,150,.32) inset,0 40px 80px -28px rgba(0,0,0,.55),0 12px 0 #9aa2b4,0 0 46px 3px var(--glow),0 0 100px 12px color-mix(in srgb,var(--glow) 45%,transparent)}
.kbd-deck.kbd-light::before{background:radial-gradient(120% 80% at 50% -12%,rgba(124,92,255,.08),transparent 60%)}
.kbd-deck.kbd-light .kbd-palm{background:linear-gradient(180deg,#ffffff,#e3e7ef);box-shadow:0 6px 0 #b7bdcc,0 10px 16px rgba(0,0,0,.25)}
.kbd-deck.kbd-light .key.blank{--kc:#c9cfdb;background:linear-gradient(180deg,#e9ecf2,#cfd5e1)}
.kbd-deck.kbd-gray{--body:#39414f;background:linear-gradient(180deg,#3b4150 0%,#2b303b 50%,#1e222b 100%)}
.kbd-deck.kbd-gray .kbd-palm{background:linear-gradient(180deg,#cdd2dc,#9aa1b0)}
.kbd-deck.kbd-gray .key.blank{--kc:#4a5160;background:linear-gradient(180deg,#4a5160,#333944)}

/* two ergonomic hand clusters (built by JS) — Charybdis-style split body */
.kbd-hand{position:relative;display:flex;flex-direction:column;gap:clamp(8px,1.2vw,14px);padding:18px 18px 14px;transform-style:preserve-3d}
.kbd-hand.left{align-items:flex-start;transform:rotateZ(-8deg)}
.kbd-hand.right{align-items:flex-end;transform:rotateZ(8deg)}
/* moulded shell behind each half (follows the body colour) */
.kbd-hand::before{content:"";position:absolute;inset:-6px;z-index:-1;border-radius:24px;
  background:linear-gradient(165deg,color-mix(in srgb,var(--body) 86%,#fff 14%),var(--body) 58%,color-mix(in srgb,var(--body) 70%,#000 30%));
  box-shadow:0 12px 0 color-mix(in srgb,var(--body) 50%,#000 50%),0 24px 36px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.10)}
.kbd-hand.left::before{clip-path:polygon(0 9%,80% 0,100% 44%,100% 72%,60% 100%,28% 100%,0 78%)}
.kbd-hand.right::before{clip-path:polygon(20% 0,100% 9%,100% 78%,72% 100%,40% 100%,0 72%,0 44%)}
.kbd-cols{display:flex;gap:clamp(7px,.9vw,11px);align-items:flex-start}
.kbd-col{display:flex;flex-direction:column;gap:clamp(7px,.9vw,11px)} /* translateY stagger set inline by JS */

/* thumb cluster + trackball — the split-ergo signature */
.kbd-thumbwrap{display:flex;align-items:center;gap:10px}
.kbd-hand.left .kbd-thumbwrap{align-self:flex-end;transform:translate(-4px,2px) rotate(15deg);transform-origin:right top}
.kbd-hand.right .kbd-thumbwrap{align-self:flex-start;transform:translate(4px,2px) rotate(-15deg);transform-origin:left top}
.kbd-thumb{display:flex;gap:clamp(6px,.8vw,10px)}
.kbd-thumb .key{width:calc(var(--ks)*.92);height:calc(var(--ks)*.92)}
.kbd-trackball{flex:none;width:calc(var(--ks)*1.3);height:calc(var(--ks)*1.3);border-radius:50%;
  background:radial-gradient(36% 30% at 38% 30%,#ffb3b3,#e11d2b 42%,#6f0d14 100%);
  box-shadow:0 0 0 5px color-mix(in srgb,var(--body) 70%,#000 30%),0 10px 16px rgba(0,0,0,.6),inset 0 -8px 14px rgba(0,0,0,.55),inset 0 6px 12px rgba(255,255,255,.3)}

.kbd-palm{width:72%;height:calc(var(--ks)*.7);margin-top:8px;
  background:linear-gradient(180deg,color-mix(in srgb,var(--body) 70%,#fff 30%),color-mix(in srgb,var(--body) 92%,#000 8%));
  box-shadow:0 9px 0 color-mix(in srgb,var(--body) 45%,#000 55%),0 16px 20px rgba(0,0,0,.45)}
.kbd-hand.left .kbd-palm{align-self:flex-start;clip-path:polygon(0 0,100% 16%,84% 100%,0 100%)}
.kbd-hand.right .kbd-palm{align-self:flex-end;clip-path:polygon(0 16%,100% 0,100% 100%,16% 100%)}

/* tinted mechanical keycap — the cap colour IS the tool colour */
.key{
  --kc:#5b6478;
  position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;
  width:var(--ks);height:var(--ks);
  border:none;border-radius:9px;cursor:pointer;color:#fff;font-family:inherit;
  /* cube TOP face */
  background:linear-gradient(158deg,color-mix(in srgb,var(--kc) 70%,#fff 24%),color-mix(in srgb,var(--kc) 95%,#000 5%) 58%,color-mix(in srgb,var(--kc) 86%,#000 14%));
  /* extruded SIDES (cube body) — stacked darker tool-colour layers = real height */
  box-shadow:0 1px 0 rgba(255,255,255,.4) inset,0 -2px 4px rgba(0,0,0,.32) inset,0 4px 0 color-mix(in srgb,var(--kc) 72%,#000 28%),0 8px 0 color-mix(in srgb,var(--kc) 58%,#000 42%),0 12px 0 color-mix(in srgb,var(--kc) 44%,#000 56%),0 15px 18px rgba(0,0,0,.55);
  transition:transform .06s ease,box-shadow .06s ease,filter .2s ease;
  -webkit-tap-highlight-color:transparent;
}
.key::after{content:"";position:absolute;left:7%;right:7%;top:6%;height:40%;border-radius:7px;
  background:linear-gradient(180deg,rgba(255,255,255,.32),transparent);pointer-events:none}
.key i{font-size:clamp(1.1rem,1.9vw,1.5rem);color:#fff;filter:drop-shadow(0 1px 2px rgba(0,0,0,.6));z-index:1}
.key .abbr{font-family:var(--font-mono);font-size:clamp(.7rem,1.3vw,.92rem);font-weight:700;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.6);z-index:1}
.key .label{font-size:clamp(.4rem,.8vw,.5rem);color:rgba(255,255,255,.95);max-width:92%;text-align:center;line-height:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-shadow:0 1px 2px rgba(0,0,0,.55);z-index:1}
.key:hover{transform:translateY(-3px);filter:brightness(1.09)}
.key:focus-visible{outline:2px solid #fff;outline-offset:3px}
.key.pressed,.key:active{transform:translateY(11px);box-shadow:0 1px 0 rgba(255,255,255,.3) inset,0 -2px 4px rgba(0,0,0,.32) inset,0 2px 0 color-mix(in srgb,var(--kc) 58%,#000 42%),0 4px 9px rgba(0,0,0,.55)}
.key.active{box-shadow:0 1px 0 rgba(255,255,255,.4) inset,0 -2px 4px rgba(0,0,0,.32) inset,0 4px 0 color-mix(in srgb,var(--kc) 72%,#000 28%),0 8px 0 color-mix(in srgb,var(--kc) 58%,#000 42%),0 12px 0 color-mix(in srgb,var(--kc) 44%,#000 56%),0 16px 30px color-mix(in srgb,var(--kc) 75%,transparent)}
.key.blank{--kc:#39435c;cursor:default}
.key.blank>*{display:none}
/* category colour fallback when a tool has no brand colour */
.kc-0{--kc:#a78bfa}.kc-1{--kc:#38bdf8}.kc-2{--kc:#34d399}.kc-3{--kc:#f472b6}.kc-4{--kc:#fbbf24}.kc-5{--kc:#fb7185}

/* info panel: tool name + custom description */
.kbd-panel{align-self:center;border:1px solid var(--border-strong);border-radius:16px;
  background:linear-gradient(180deg,var(--card-hover),var(--card));padding:22px;min-height:178px;position:relative;overflow:hidden}
.kbd-panel::before{content:"";position:absolute;inset:0;pointer-events:none;transition:background .35s ease;
  background:radial-gradient(90% 60% at 100% 0%,color-mix(in srgb,var(--pk,#7c5cff) 18%,transparent),transparent 60%)}
.kbd-panel .pk-cat{font-family:var(--font-mono);font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:var(--pk,#a78bfa);position:relative}
.kbd-panel .pk-name{font-family:var(--font-display);font-size:1.5rem;margin:8px 0 10px;line-height:1.12;position:relative}
.kbd-panel .pk-desc{color:var(--muted);font-size:.92rem;line-height:1.55;position:relative}
.kbd-panel.empty .pk-cat,.kbd-panel.empty .pk-name{opacity:.5}

/* all-skills list tab (full list; also holds any skills beyond the keyboard) */
.kbd-listwrap{margin-top:44px}
.kbd-listhead{font-family:var(--font-mono);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-2);text-align:center;margin-bottom:14px}
.kbd-list{display:flex;flex-wrap:wrap;gap:9px;justify-content:center;max-width:920px;margin:0 auto}
.kbd-chip{--kc:#a78bfa;display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border-radius:999px;border:1px solid var(--border-strong);background:var(--card);font-size:.82rem;color:var(--fg);cursor:pointer;transition:border-color .2s,transform .12s,background .2s}
.kbd-chip .dot{width:9px;height:9px;border-radius:50%;background:var(--kc);box-shadow:0 0 8px var(--kc)}
.kbd-chip i{color:var(--kc);font-size:.95rem}
.kbd-chip:hover{border-color:var(--kc);transform:translateY(-2px)}
.kbd-chip.active{border-color:var(--kc);background:color-mix(in srgb,var(--kc) 14%,var(--card))}

@media(max-width:1040px){
  .kbd-deck{transform:rotateX(16deg) rotateY(-4deg)}
}
@media(max-width:768px){#skills{--ks:54px}}
@media(max-width:560px){
  #skills{--ks:44px}
  .kbd-deck{gap:14px;padding:18px 14px 24px;animation:none;transform:rotateX(10deg)}
  .kbd-hand.left,.kbd-hand.right{transform:none}
  .kbd-sound-wrap{margin-inline-start:0}
  .kbd-panel{min-height:0}
}

/* ── experience timeline ────────────────────────────────────── */
#experience{padding:90px 0}
.timeline{position:relative;margin-left:6px}
.timeline::before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:1px;background:linear-gradient(180deg,var(--brand),transparent)}
.tl-item{position:relative;padding-left:38px;padding-bottom:38px}
.tl-item:last-child{padding-bottom:0}
.tl-item::before{content:"";position:absolute;left:0;top:6px;width:16px;height:16px;border-radius:50%;background:var(--bg);border:2px solid var(--brand);box-shadow:0 0 0 4px color-mix(in srgb,var(--brand) 14%,transparent)}
.tl-card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:24px;transition:border-color .25s,transform .25s,background .25s}
.tl-card:hover{border-color:var(--border-strong);transform:translateY(-3px);background:var(--card-hover)}
.tl-head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:flex-start}
.tl-card h3{font-size:1.2rem;font-weight:700;letter-spacing:-.01em}
.tl-card .co{color:var(--brand);font-weight:500;margin-top:2px}
.tl-date{font-family:var(--font-mono);font-size:.74rem;color:var(--muted);border:1px solid var(--border);border-radius:999px;padding:4px 12px;white-space:nowrap}
.tl-card ul{margin:16px 0 0;padding-left:18px;color:var(--muted);display:flex;flex-direction:column;gap:8px}
.tl-card ul li::marker{color:var(--brand)}
.tl-card .desc{color:var(--muted);margin-top:12px}

/* ── projects ───────────────────────────────────────────────── */
#projects{padding:90px 0}
.proj-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:22px}
.proj{position:relative;border-radius:var(--radius);overflow:hidden;cursor:pointer;border:1px solid var(--border);aspect-ratio:3/2;background:var(--card)}
.proj .ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:2.4rem;color:color-mix(in srgb,var(--fg) 22%,transparent);background:
  radial-gradient(120% 120% at 20% 0%, color-mix(in srgb,var(--brand) 30%,transparent), transparent 55%),
  radial-gradient(120% 120% at 100% 100%, color-mix(in srgb,var(--accent) 26%,transparent), transparent 55%),
  var(--bg-2)}
.proj img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s ease}
.proj:hover img{transform:scale(1.06)}
.proj .cap{position:absolute;inset:auto 0 0 0;height:62%;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;padding:20px;
  background:linear-gradient(0deg,var(--bg) 8%, color-mix(in srgb,var(--bg) 82%,transparent) 45%, transparent)}
.proj .cap h3{font-size:1.15rem;font-weight:700}
.proj .cap .tag{align-self:flex-start;font-size:.68rem;font-family:var(--font-mono);background:var(--brand);color:#fff;border-radius:8px;padding:2px 9px}
.proj .open{position:absolute;top:14px;right:14px;width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--bg) 60%,transparent);border:1px solid var(--border-strong);opacity:0;transform:translateY(-6px);transition:opacity .25s,transform .25s}
.proj:hover .open{opacity:1;transform:none}

/* project modal */
.modal{position:fixed;inset:0;z-index:150;display:none;align-items:center;justify-content:center;padding:24px}
.modal.open{display:flex}
.modal .scrim{position:absolute;inset:0;background:rgba(2,6,23,.78);backdrop-filter:blur(6px)}
.modal .panel{position:relative;width:min(760px,100%);max-height:88svh;overflow:auto;background:var(--bg-2);border:1px solid var(--border-strong);border-radius:20px;padding:30px;animation:pop .35s cubic-bezier(.22,1,.36,1)}
@keyframes pop{from{opacity:0;transform:translateY(20px) scale(.97)}to{opacity:1;transform:none}}
.modal .close{position:absolute;top:16px;right:16px;width:38px;height:38px;border-radius:10px;border:1px solid var(--border);background:var(--card);display:flex;align-items:center;justify-content:center;cursor:pointer}
.modal h3{font-family:var(--font-display);font-size:1.7rem;margin-bottom:6px}
.modal .m-cat{color:var(--brand);font-family:var(--font-mono);font-size:.8rem;margin-bottom:18px}
.modal .m-cover{width:100%;border-radius:14px;border:1px solid var(--border);margin-bottom:18px}
.modal p{color:var(--muted);margin-bottom:14px}
.modal .badges{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}
.badge{font-family:var(--font-mono);font-size:.72rem;padding:4px 11px;border-radius:999px;border:1px solid var(--border-strong);color:var(--muted)}
.modal .metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin:16px 0}
.modal .metrics .m{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px}
.modal .metrics .m b{font-family:var(--font-display);font-size:1.5rem;display:block;color:var(--fg)}
.modal .metrics .m span{font-size:.72rem;color:var(--muted)}
.modal .m-imgs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:16px 0}
.modal .m-imgs img{border-radius:12px;border:1px solid var(--border)}
.modal .dock{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px;padding-top:20px;border-top:1px solid var(--border)}

/* ── education / certifications ─────────────────────────────── */
#extras{padding:40px 0 90px}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:28px}
@media(max-width:760px){.two-col{grid-template-columns:1fr}}
.mini{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:24px}
.mini h3{font-family:var(--font-display);font-size:1.05rem;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.mini h3 i{color:var(--brand)}
.mini .row{padding:12px 0;border-top:1px solid var(--border)}
.mini .row:first-of-type{border-top:0}
.mini .row b{display:block;font-weight:600}
.mini .row span{color:var(--muted);font-size:.86rem}
.mini .row .yr{float:right;font-family:var(--font-mono);font-size:.72rem;color:var(--muted-2)}

/* ── contact ────────────────────────────────────────────────── */
#contact{padding:90px 0 140px}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
@media(max-width:820px){.contact-grid{grid-template-columns:1fr}}
.contact-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:30px}
.field{margin-bottom:18px}
.field label{display:block;font-size:.82rem;color:var(--muted);margin-bottom:8px;font-family:var(--font-mono)}
.field input,.field textarea{
  width:100%;background:var(--bg);border:1px solid var(--border-strong);border-radius:12px;
  padding:13px 15px;color:var(--fg);font-family:var(--font-sans);font-size:.95rem;transition:border-color .2s,box-shadow .2s;
}
.field input:focus,.field textarea:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-glow)}
.field textarea{min-height:130px;resize:vertical}
.contact-list{display:flex;flex-direction:column;gap:14px}
.contact-list a{display:flex;align-items:center;gap:14px;padding:16px;border:1px solid var(--border);border-radius:14px;background:var(--card);transition:border-color .2s,transform .2s,background .2s}
.contact-list a:hover{border-color:var(--brand);transform:translateX(4px);background:var(--card-hover)}
.contact-list a i{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--brand) 16%,transparent);color:var(--brand);font-size:1.05rem;flex:none}
.contact-list a b{display:block;font-size:.7rem;color:var(--muted);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:.08em}

/* ── footer ─────────────────────────────────────────────────── */
footer{border-top:1px solid var(--border);padding:40px 0;position:relative;z-index:1}
footer .wrap{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px}
footer .socials{display:flex;gap:10px}
footer .socials a{width:40px;height:40px;border-radius:11px;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--muted);transition:color .2s,border-color .2s,transform .2s}
footer .socials a:hover{color:var(--fg);border-color:var(--brand);transform:translateY(-2px)}
footer .meta{color:var(--muted-2);font-size:.8rem}
footer .credit{color:var(--muted-2);font-size:.72rem;font-family:var(--font-mono)}
footer .credit a{color:var(--muted);text-decoration:underline;text-underline-offset:2px}

/* RTL tweaks */
html[dir="rtl"] .tl-item{padding-left:0;padding-right:38px}
html[dir="rtl"] .timeline::before{left:auto;right:7px}
html[dir="rtl"] .tl-item::before{left:auto;right:0}
</style>
</head>
<body>

{{!-- ░░ PRELOADER ░░ --}}
<div id="preloader" aria-hidden="true">
  <div class="word"><span>{{#if isRTL}}جارٍ التحميل{{else}}Loading{{/if}}</span></div>
  <div class="bar"><i></i></div>
  <div class="pct">0%</div>
</div>

{{!-- ░░ ELASTIC CURSOR ░░ --}}
<div id="cursor"></div><div id="cursor-dot"></div>

{{!-- ░░ BACKGROUND LAYERS ░░ --}}
<canvas id="stars"></canvas>
<div id="progress"></div>

{{!-- ░░ NAV ░░ --}}
<nav aria-label="Section navigation">
  <a href="#hero" data-sec="hero" class="active"><i class="fa-solid fa-house"></i> <span>{{#if isRTL}}الرئيسية{{else}}Home{{/if}}</span></a>
  {{#unless (isHidden "skills")}}<a href="#skills" data-sec="skills"><i class="fa-solid fa-keyboard"></i> <span>{{#if isRTL}}المهارات{{else}}Stack{{/if}}</span></a>{{/unless}}
  {{#unless (isHidden "experience")}}<a href="#experience" data-sec="experience"><i class="fa-solid fa-briefcase"></i> <span>{{#if isRTL}}الخبرة{{else}}Work{{/if}}</span></a>{{/unless}}
  {{#unless (isHidden "projects")}}<a href="#projects" data-sec="projects"><i class="fa-solid fa-cube"></i> <span>{{#if isRTL}}المشاريع{{else}}Projects{{/if}}</span></a>{{/unless}}
  <a href="#contact" data-sec="contact"><i class="fa-solid fa-paper-plane"></i> <span>{{#if isRTL}}تواصل{{else}}Contact{{/if}}</span></a>
</nav>

{{!-- ░░ HERO ░░ --}}
<section id="hero">
  <div class="wrap">
    <div class="grid">
      <div class="hello blur-in">{{#if isRTL}}مرحبًا، أنا{{else}}Hi, I'm{{/if}}</div>
      <h1 class="blur-in" data-delay="80">{{titleCase basics.fullName}}</h1>
      <div class="role blur-in" data-delay="160">{{#if basics.title}}{{basics.title}}{{/if}}{{#if basics.subtitle}} · {{basics.subtitle}}{{/if}}</div>
      {{#if basics.valueProposition}}<p class="pitch blur-in" data-delay="220">{{basics.valueProposition}}</p>{{else if basics.bio}}<p class="pitch blur-in" data-delay="220">{{basics.bio}}</p>{{/if}}
      <div class="cta blur-in" data-delay="300">
        {{#if basics.resumeUrl}}<a class="btn primary" href="{{safeUrl basics.resumeUrl}}" target="_blank" rel="noopener"><i class="fa-regular fa-file"></i> {{#if isRTL}}السيرة الذاتية{{else}}Resume{{/if}}</a>{{/if}}
        <a class="btn" href="#contact"><i class="fa-solid fa-paper-plane"></i> {{#if isRTL}}تواصل معي{{else}}Get in touch{{/if}}</a>
        {{#if basics.github}}<a class="btn icon" href="{{safeUrl basics.github}}" target="_blank" rel="noopener" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>{{/if}}
        {{#if basics.linkedin}}<a class="btn icon" href="{{safeUrl basics.linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>{{/if}}
        {{#if basics.instagram}}<a class="btn icon" href="{{safeUrl basics.instagram}}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>{{/if}}
        {{#if basics.website}}<a class="btn icon" href="{{safeUrl basics.website}}" target="_blank" rel="noopener" aria-label="Website"><i class="fa-solid fa-globe"></i></a>{{/if}}
      </div>
      {{#if metrics}}
      <div class="cta blur-in" data-delay="360" style="gap:28px;margin-top:30px">
        {{#each metrics}}<div><b style="font-family:var(--font-display);font-size:1.7rem">{{this.value}}</b><div style="color:var(--muted);font-size:.78rem">{{this.label}}</div></div>{{/each}}
      </div>
      {{/if}}
      <div class="scroll-cue blur-in" data-delay="440"><span class="mouse"></span>{{#if isRTL}}مرّر{{else}}SCROLL{{/if}}</div>
    </div>
    <img class="hero-kbd" src="/assets/hero-keyboard.png" alt="3D split mechanical keyboard" loading="eager" width="1600" height="900">
  </div>
</section>

{{!-- ░░ SKILLS / TECH STACK ░░ --}}
{{#unless (isHidden "skills")}}
{{#if skills}}
<section id="skills">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">{{#if isRTL}}الأدوات{{else}}Tech Stack{{/if}}</div>
      <h2>{{#if isRTL}}المهارات التقنية{{else}}Tech Stack{{/if}}</h2>
      <div class="kbd-toolbar">
        <p class="kbd-hint">{{#if isRTL}}(اضغط أي مفتاح — كل مفتاح مهارة){{else}}(press a key — every key is a skill){{/if}}</p>
        <label class="kbd-sound-wrap" for="kbd-sound"><i class="fa-solid fa-volume-high"></i>
          <select class="kbd-sound" id="kbd-sound" aria-label="{{#if isRTL}}صوت المفاتيح{{else}}Key sound{{/if}}">
            <option value="thocky">{{#if isRTL}}ثوكي{{else}}Thocky{{/if}}</option>
            <option value="creamy">{{#if isRTL}}كريمي{{else}}Creamy{{/if}}</option>
            <option value="clacky">{{#if isRTL}}كلاكي{{else}}Clacky{{/if}}</option>
            <option value="poppy">{{#if isRTL}}بوبي{{else}}Poppy{{/if}}</option>
            <option value="clicky">{{#if isRTL}}كليكي{{else}}Clicky{{/if}}</option>
            <option value="lego">{{#if isRTL}}ليغو{{else}}Lego{{/if}}</option>
            <option value="none">{{#if isRTL}}بدون صوت{{else}}No sound{{/if}}</option>
          </select>
        </label>
      </div>
    </div>
    <div class="kbd-wrap">
      <div class="kbd-stage">
        <div class="kbd-deck {{kbdBody customization.keyboardBody}}" id="kbd-deck">
          {{#each (flattenSkills skills)}}
          <button type="button" class="key {{cycle this.catIndex "kc-0" "kc-1" "kc-2" "kc-3" "kc-4" "kc-5"}}" data-skill="{{this.name}}" data-cat="{{this.category}}" data-desc="{{this.description}}" aria-label="{{this.name}}{{#if this.category}} — {{this.category}}{{/if}}">
            {{#if (techIcon this.name)}}<i class="{{techIcon this.name}}"></i>{{else}}<span class="abbr">{{kbAbbr this.name}}</span>{{/if}}
            <span class="label">{{this.name}}</span>
          </button>
          {{/each}}
        </div>
      </div>
      <aside class="kbd-panel empty" id="kbd-panel" aria-live="polite">
        <div class="pk-cat">{{#if isRTL}}اختر مفتاحًا{{else}}Select a key{{/if}}</div>
        <div class="pk-name">{{#if isRTL}}المهارات التقنية{{else}}Tech Stack{{/if}}</div>
        <div class="pk-desc">{{#if isRTL}}اضغط أي مفتاح لرؤية الأداة ووصفها.{{else}}Press any key to see the tool and what it's used for.{{/if}}</div>
      </aside>
    </div>
    <div class="kbd-listwrap">
      <div class="kbd-listhead">{{#if isRTL}}كل المهارات{{else}}All skills{{/if}}</div>
      <div class="kbd-list" id="kbd-list">
        {{#each (flattenSkills skills)}}
        <button type="button" class="kbd-chip {{cycle this.catIndex "kc-0" "kc-1" "kc-2" "kc-3" "kc-4" "kc-5"}}" data-skill="{{this.name}}" data-cat="{{this.category}}" data-desc="{{this.description}}">
          {{#if (techIcon this.name)}}<i class="{{techIcon this.name}}"></i>{{else}}<span class="dot"></span>{{/if}}
          <span>{{this.name}}</span>
        </button>
        {{/each}}
      </div>
    </div>
  </div>
</section>
{{/if}}
{{/unless}}

{{!-- ░░ EXPERIENCE ░░ --}}
{{#unless (isHidden "experience")}}
{{#if experience}}
<section id="experience">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">{{#if isRTL}}المسيرة{{else}}Experience{{/if}}</div>
      <h2>{{#if isRTL}}مسيرتي المهنية{{else}}My professional journey{{/if}}</h2>
    </div>
    <div class="timeline">
      {{#each experience}}
      <div class="tl-item box-reveal">
        <div class="tl-card">
          <div class="tl-head">
            <div>
              <h3>{{this.title}}</h3>
              <div class="co">{{this.company}}</div>
            </div>
            <div class="tl-date">{{this.startDate}}{{#if this.endDate}} — {{this.endDate}}{{else}} — {{#if ../isRTL}}الآن{{else}}Present{{/if}}{{/if}}</div>
          </div>
          {{#if this.description}}<div class="desc">{{this.description}}</div>{{/if}}
          {{#if this.highlights}}
          <ul>
            {{#each this.highlights}}<li>{{this}}</li>{{/each}}
          </ul>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/if}}
{{/unless}}

{{!-- ░░ PROJECTS ░░ --}}
{{#unless (isHidden "projects")}}
{{#if projects}}
<section id="projects">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">{{#if isRTL}}أعمال مختارة{{else}}Projects{{/if}}</div>
      <h2>{{#if isRTL}}مشاريع منتقاة{{else}}Selected work{{/if}}</h2>
      <p>{{#if isRTL}}اضغط على أي مشروع لعرض التفاصيل.{{else}}Click any project to dive into the details.{{/if}}</p>
    </div>
    <div class="proj-grid">
      {{#each projects}}
      <div class="proj box-reveal" data-proj="{{@index}}" role="button" tabindex="0" aria-label="{{this.title}}">
        {{#if this.coverUrl}}<img src="{{safeUrl this.coverUrl}}" alt="{{this.title}}" loading="lazy">{{else}}<div class="ph">{{initials this.title}}</div>{{/if}}
        <div class="open"><i class="fa-solid fa-arrow-up-right-from-square"></i></div>
        <div class="cap">
          <h3>{{this.title}}</h3>
          {{#if this.tagline}}<span class="tag">{{this.tagline}}</span>{{else if this.meta.type}}<span class="tag">{{this.meta.type}}</span>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

{{!-- project modals --}}
{{#each projects}}
<div class="modal" id="modal-{{@index}}" role="dialog" aria-modal="true" aria-label="{{this.title}}">
  <div class="scrim" data-close></div>
  <div class="panel">
    <button class="close" data-close aria-label="Close"><i class="fa-solid fa-xmark"></i></button>
    <h3>{{this.title}}</h3>
    {{#if this.tagline}}<div class="m-cat">{{this.tagline}}</div>{{else if this.meta.type}}<div class="m-cat">{{this.meta.type}}{{#if this.meta.year}} · {{this.meta.year}}{{/if}}</div>{{/if}}
    {{#if this.coverUrl}}<img class="m-cover" src="{{safeUrl this.coverUrl}}" alt="{{this.title}}">{{/if}}
    {{#if this.description}}<p>{{this.description}}</p>{{/if}}
    {{#if this.metrics}}
    <div class="metrics">
      {{#each this.metrics}}<div class="m"><b>{{this.value}}</b><span>{{this.label}}</span></div>{{/each}}
    </div>
    {{/if}}
    {{#if this.technologies}}
    <div class="badges">
      {{#each this.technologies}}<span class="badge">{{this}}</span>{{/each}}
    </div>
    {{/if}}
    {{#if this.blocks}}
    <div class="m-imgs">
      {{#each this.blocks}}{{#if this.url}}<img src="{{safeUrl this.url}}" alt="{{this.caption}}" loading="lazy">{{/if}}{{#if this.images}}{{#each this.images}}<img src="{{safeUrl this.url}}" alt="{{this.caption}}" loading="lazy">{{/each}}{{/if}}{{/each}}
    </div>
    {{/if}}
    <div class="dock">
      {{#if this.link}}<a class="btn primary" href="{{safeUrl this.link}}" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{#if ../isRTL}}عرض مباشر{{else}}Live{{/if}}</a>{{/if}}
      {{#each this.links}}<a class="btn" href="{{safeUrl this.url}}" target="_blank" rel="noopener">{{this.label}}</a>{{/each}}
    </div>
  </div>
</div>
{{/each}}
{{/if}}
{{/unless}}

{{!-- ░░ EDUCATION + CERTIFICATIONS ░░ --}}
{{#if (or education certifications)}}
<section id="extras">
  <div class="wrap">
    <div class="two-col">
      {{#if education}}
      <div class="mini box-reveal">
        <h3><i class="fa-solid fa-graduation-cap"></i> {{#if isRTL}}التعليم{{else}}Education{{/if}}</h3>
        {{#each education}}
        <div class="row"><span class="yr">{{this.year}}</span><b>{{this.degree}}</b><span>{{this.institution}}</span></div>
        {{/each}}
      </div>
      {{/if}}
      {{#if certifications}}
      <div class="mini box-reveal">
        <h3><i class="fa-solid fa-certificate"></i> {{#if isRTL}}الشهادات{{else}}Certifications{{/if}}</h3>
        {{#each certifications}}
        <div class="row"><span class="yr">{{this.year}}</span><b>{{this.name}}</b><span>{{this.issuer}}</span></div>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </div>
</section>
{{/if}}

{{!-- ░░ CONTACT ░░ --}}
<section id="contact">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">{{#if isRTL}}لنعمل معًا{{else}}Contact{{/if}}</div>
      <h2>{{#if isRTL}}لنبنِ شيئًا رائعًا{{else}}Let's work together{{/if}}</h2>
    </div>
    <div class="contact-grid">
      <div class="contact-card box-reveal">
        <form id="contact-form" novalidate>
          <div class="field"><label for="cf-name">{{#if isRTL}}الاسم{{else}}Name{{/if}}</label><input id="cf-name" name="name" required placeholder="{{#if isRTL}}اسمك{{else}}Your name{{/if}}"></div>
          <div class="field"><label for="cf-email">{{#if isRTL}}البريد الإلكتروني{{else}}Email{{/if}}</label><input id="cf-email" name="email" type="email" required placeholder="you@example.com"></div>
          <div class="field"><label for="cf-msg">{{#if isRTL}}الرسالة{{else}}Message{{/if}}</label><textarea id="cf-msg" name="message" required placeholder="{{#if isRTL}}اكتب رسالتك...{{else}}Tell me about your project...{{/if}}"></textarea></div>
          <button class="btn primary" type="submit" style="width:100%;justify-content:center">{{#if isRTL}}إرسال الرسالة{{else}}Send message{{/if}} <i class="fa-solid fa-arrow-right"></i></button>
        </form>
      </div>
      <div class="contact-list">
        {{#if basics.email}}<a href="mailto:{{basics.email}}"><i class="fa-solid fa-envelope"></i><div><b>Email</b>{{basics.email}}</div></a>{{/if}}
        {{#if basics.linkedin}}<a href="{{safeUrl basics.linkedin}}" target="_blank" rel="noopener"><i class="fa-brands fa-linkedin-in"></i><div><b>LinkedIn</b>{{#if isRTL}}تواصل مهني{{else}}Let's connect{{/if}}</div></a>{{/if}}
        {{#if basics.github}}<a href="{{safeUrl basics.github}}" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i><div><b>GitHub</b>{{#if isRTL}}الأكواد{{else}}See the code{{/if}}</div></a>{{/if}}
        {{#if basics.phone}}<a href="tel:{{basics.phone}}"><i class="fa-solid fa-phone"></i><div><b>{{#if isRTL}}الهاتف{{else}}Phone{{/if}}</b>{{basics.phone}}</div></a>{{/if}}
        {{#if basics.location}}<a href="#" onclick="return false"><i class="fa-solid fa-location-dot"></i><div><b>{{#if isRTL}}الموقع{{else}}Location{{/if}}</b>{{basics.location}}</div></a>{{/if}}
      </div>
    </div>
  </div>
</section>

{{!-- ░░ FOOTER ░░ --}}
<footer>
  <div class="wrap">
    <div class="meta">© <span id="year"></span> {{titleCase basics.fullName}}{{#if basics.title}} — {{basics.title}}{{/if}}</div>
    <div class="socials">
      {{#if basics.github}}<a href="{{safeUrl basics.github}}" target="_blank" rel="noopener" aria-label="GitHub"><i class="fa-brands fa-github"></i></a>{{/if}}
      {{#if basics.linkedin}}<a href="{{safeUrl basics.linkedin}}" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>{{/if}}
      {{#if basics.instagram}}<a href="{{safeUrl basics.instagram}}" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>{{/if}}
      {{#if basics.email}}<a href="mailto:{{basics.email}}" aria-label="Email"><i class="fa-solid fa-envelope"></i></a>{{/if}}
    </div>
    <div class="credit">{{#if isRTL}}تصميم مستوحى من{{else}}Design inspired by{{/if}} <a href="https://github.com/Naresh-Khatri/3d-portfolio" target="_blank" rel="noopener">Naresh Khatri's 3D Portfolio</a></div>
  </div>
</footer>

{{!-- ░░ INTERACTIVE PAGE SCRIPT (self-contained, no external runtime) ░░ --}}
<script>
(function(){
  "use strict";
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion:reduce)").matches;

  /* ── year ── */
  var y = document.getElementById("year"); if(y){ y.textContent = new Date().getFullYear(); }

  /* ── preloader: simulated progress, completes on window load ── */
  var pre = document.getElementById("preloader");
  var bar = pre && pre.querySelector(".bar > i");
  var pct = pre && pre.querySelector(".pct");
  var prog = 0, loaded = false;
  function setProg(v){ prog = Math.min(100, v); if(bar){ bar.style.width = prog + "%"; } if(pct){ pct.textContent = Math.round(prog) + "%"; } }
  var fake = setInterval(function(){ if(prog < 90){ setProg(prog + Math.random()*12); } }, 160);
  function finishLoad(){
    if(loaded){ return; }
    loaded = true; clearInterval(fake); setProg(100);
    setTimeout(function(){ if(pre){ pre.classList.add("done"); setTimeout(function(){ pre.style.display = "none"; }, 950); } document.body.classList.add("loaded"); }, 380);
  }
  window.addEventListener("load", function(){ setTimeout(finishLoad, 500); });
  setTimeout(finishLoad, 6000); /* hard cap so a slow CDN never traps the page */

  /* ── scroll progress bar ── */
  var pbar = document.getElementById("progress");
  function onScroll(){
    var h = document.documentElement;
    var max = (h.scrollHeight - h.clientHeight) || 1;
    if(pbar){ pbar.style.width = ((h.scrollTop || document.body.scrollTop) / max * 100) + "%"; }
  }
  window.addEventListener("scroll", onScroll, {passive:true}); onScroll();

  /* ── reveal-on-scroll (no external deps) ── */
  if(("IntersectionObserver" in window) && !reduce){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          var d = parseInt(e.target.getAttribute("data-delay") || "0", 10);
          setTimeout(function(){ e.target.classList.add("in"); }, d);
          io.unobserve(e.target);
        }
      });
    }, {threshold:0.12, rootMargin:"0px 0px -8% 0px"});
    document.querySelectorAll(".blur-in,.box-reveal").forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll(".blur-in,.box-reveal").forEach(function(el){ el.classList.add("in"); });
  }

  /* ── scrollspy / active nav ── */
  var navLinks = Array.prototype.slice.call(document.querySelectorAll("nav a"));
  var secs = navLinks.map(function(a){ return document.getElementById(a.getAttribute("data-sec")); }).filter(Boolean);
  if("IntersectionObserver" in window){
    var spy = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){
          var id = e.target.id;
          document.body.setAttribute("data-active", id);
          navLinks.forEach(function(a){ a.classList.toggle("active", a.getAttribute("data-sec") === id); });
        }
      });
    }, {threshold:0.4});
    secs.forEach(function(s){ spy.observe(s); });
  }

  /* ── star-field ── */
  var canvas = document.getElementById("stars");
  if(canvas && !reduce){
    var ctx = canvas.getContext("2d"), stars = [], W, H, dpr = Math.min(window.devicePixelRatio || 1, 2);
    function resize(){
      W = canvas.width = innerWidth * dpr; H = canvas.height = innerHeight * dpr;
      canvas.style.width = innerWidth + "px"; canvas.style.height = innerHeight + "px";
      var count = Math.min(220, Math.floor(innerWidth * innerHeight / 9000));
      stars = [];
      for(var i = 0; i < count; i++){ stars.push({ x:Math.random()*W, y:Math.random()*H, z:Math.random()*0.9+0.1, r:(Math.random()*1.3+0.3)*dpr, t:Math.random()*Math.PI*2 }); }
    }
    var mx = 0, my = 0;
    window.addEventListener("mousemove", function(e){ mx = (e.clientX/innerWidth - 0.5); my = (e.clientY/innerHeight - 0.5); });
    function draw(){
      ctx.clearRect(0, 0, W, H);
      for(var i = 0; i < stars.length; i++){
        var s = stars[i]; s.t += 0.02;
        var tw = 0.5 + Math.sin(s.t)*0.5;
        var px = s.x + mx*40*s.z*dpr, py = s.y + my*40*s.z*dpr;
        ctx.globalAlpha = 0.25 + tw*0.7*s.z;
        ctx.fillStyle = (i % 9 === 0) ? "#a78bfa" : ((i % 7 === 0) ? "#38bdf8" : "#e2e8f0");
        ctx.beginPath(); ctx.arc(px, py, s.r, 0, Math.PI*2); ctx.fill();
      }
      requestAnimationFrame(draw);
    }
    resize(); window.addEventListener("resize", resize); requestAnimationFrame(draw);
  }

  /* ── elastic cursor ── */
  var cur = document.getElementById("cursor"), dot = document.getElementById("cursor-dot");
  if(cur && dot && window.matchMedia("(hover:hover)").matches && !reduce){
    var cx = innerWidth/2, cy = innerHeight/2, tx = cx, ty = cy, px = cx, py = cy;
    document.addEventListener("mousemove", function(e){ tx = e.clientX; ty = e.clientY; dot.style.transform = "translate(" + tx + "px," + ty + "px)"; });
    function ring(){
      cx += (tx-cx)*0.18; cy += (ty-cy)*0.18;
      var dx = tx-px, dy = ty-py; px = tx; py = ty;
      var speed = Math.min(Math.sqrt(dx*dx + dy*dy), 80);
      var ang = Math.atan2(cy-ty, cx-tx) * 180 / Math.PI;
      var stretch = 1 + speed/170;
      cur.style.transform = "translate(" + cx + "px," + cy + "px) rotate(" + ang + "deg) scale(" + stretch + "," + (1/stretch) + ")";
      requestAnimationFrame(ring);
    }
    requestAnimationFrame(ring);
    document.querySelectorAll("a,button,[role='button'],.keycap,.proj,input,textarea").forEach(function(el){
      el.addEventListener("mouseenter", function(){ cur.classList.add("hover"); });
      el.addEventListener("mouseleave", function(){ cur.classList.remove("hover"); });
    });
  }

  /* ── project modal ── */
  function openModal(i){ var m = document.getElementById("modal-" + i); if(m){ m.classList.add("open"); document.body.style.overflow = "hidden"; } }
  function closeModals(){ document.querySelectorAll(".modal.open").forEach(function(m){ m.classList.remove("open"); }); document.body.style.overflow = ""; }
  document.querySelectorAll("[data-proj]").forEach(function(p){
    p.addEventListener("click", function(){ openModal(p.getAttribute("data-proj")); });
    p.addEventListener("keydown", function(e){ if(e.key === "Enter" || e.key === " "){ e.preventDefault(); openModal(p.getAttribute("data-proj")); } });
  });
  document.querySelectorAll("[data-close]").forEach(function(c){ c.addEventListener("click", closeModals); });
  document.addEventListener("keydown", function(e){ if(e.key === "Escape"){ closeModals(); } });

  /* ── contact form → mailto compose (template has no backend) ── */
  var form = document.getElementById("contact-form");
  if(form){
    form.addEventListener("submit", function(e){
      e.preventDefault();
      var to = {{#if basics.email}}"{{basics.email}}"{{else}}""{{/if}};
      var nm = encodeURIComponent(form.name.value || "");
      var em = encodeURIComponent(form.email.value || "");
      var msg = encodeURIComponent(form.message.value || "");
      var subject = encodeURIComponent("Portfolio enquiry from " + (form.name.value || "a visitor"));
      var body = "Name: " + nm + "%0D%0AEmail: " + em + "%0D%0A%0D%0A" + msg;
      if(to){ window.location.href = "mailto:" + to + "?subject=" + subject + "&body=" + body; }
    });
  }

  /* ── Lenis smooth scroll (progressive enhancement) ── */
  if(!reduce){
    var ls = document.createElement("script");
    ls.src = "https://unpkg.com/lenis@1.1.14/dist/lenis.min.js";
    ls.onload = function(){
      try{
        if(!window.Lenis){ return; }
        var lenis = new Lenis({ lerp:0.09, smoothWheel:true });
        function raf(t){ lenis.raf(t); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
        document.querySelectorAll("a[href^='#']").forEach(function(a){
          a.addEventListener("click", function(e){
            var id = a.getAttribute("href");
            if(id && id.length > 1 && id.charAt(0) === "#"){ var t = document.querySelector(id); if(t){ e.preventDefault(); lenis.scrollTo(t, {offset:-10}); } }
          });
        });
      }catch(err){}
    };
    document.head.appendChild(ls);
  }

  /* ── Dygma-style split 3D keyboard: build, tint, sound, info panel ── */
  (function(){
    var deck = document.getElementById("kbd-deck");
    if(!deck){ return; }
    var panel = document.getElementById("kbd-panel");
    var pCat = panel && panel.querySelector(".pk-cat");
    var pName = panel && panel.querySelector(".pk-name");
    var pDesc = panel && panel.querySelector(".pk-desc");
    var soundSel = document.getElementById("kbd-sound");
    var chips = Array.prototype.slice.call(document.querySelectorAll("#kbd-list .kbd-chip"));
    var hoverable = !!(window.matchMedia && window.matchMedia("(hover:hover)").matches);

    /* ── per-tool brand colours; the keycap takes its tool's colour ── */
    var BRAND = {
      react:"#61dafb",reactjs:"#61dafb",reactnative:"#61dafb",javascript:"#f7df1e",js:"#f7df1e",
      typescript:"#3178c6",ts:"#3178c6",node:"#3c873a",nodejs:"#3c873a",express:"#3c873a",
      python:"#3776ab",django:"#3776ab",flask:"#3776ab",docker:"#2496ed",kubernetes:"#326ce5",k8s:"#326ce5",
      java:"#ea2d2e",spring:"#6db33f",springboot:"#6db33f",html:"#e34f26",html5:"#e34f26",css:"#1572b6",css3:"#1572b6",
      sass:"#cc6699",scss:"#cc6699",php:"#777bb4",laravel:"#ff2d20",vue:"#42b883",vuejs:"#42b883",angular:"#dd0031",
      aws:"#ff9900",azure:"#0078d4",gcp:"#4285f4",googlecloud:"#4285f4",graphql:"#e10098",
      postgresql:"#336791",postgres:"#336791",mysql:"#4479a1",mongodb:"#47a248",redis:"#dc382d",sqlite:"#003b57",
      git:"#f05032",github:"#e6edf3",gitlab:"#fc6d26",linux:"#fcc624",ubuntu:"#e95420",rust:"#dea584",
      go:"#00add8",golang:"#00add8",swift:"#fa7343",kotlin:"#7f52ff",figma:"#f24e1e",tailwind:"#38bdf8",tailwindcss:"#38bdf8",
      bootstrap:"#7952b3",nextjs:"#e6edf3",next:"#e6edf3",pandas:"#8a4baf",tensorflow:"#ff6f00",pytorch:"#ee4c2c",
      elasticstack:"#00bfb3",elastic:"#00bfb3",powershell:"#5391fe",windows:"#0078d4"
    };
    function brandOf(name){ var k = String(name||"").toLowerCase().replace(/[^a-z0-9]/g,""); return BRAND[k] || ""; }
    function tint(el){ var b = brandOf(el.getAttribute("data-skill")); if(b){ el.style.setProperty("--kc", b); } }

    /* ── build the two ergonomic hand clusters from the skill keys ── */
    var COLS = 4, ROWS = 3, HALF = COLS * ROWS, CAP = HALF * 2;     /* fixed 24-key board */
    var master = Array.prototype.slice.call(deck.querySelectorAll(".key"));
    master.forEach(tint);
    chips.forEach(tint);
    var board = master.slice(0, CAP);
    master.slice(CAP).forEach(function(k){ k.remove(); });          /* overflow lives in the list */
    var staL = [10, 2, -8, -2], staR = [-2, -8, 2, 10];             /* ergonomic column stagger */
    function makeBlank(){ var b = document.createElement("button"); b.type = "button"; b.className = "key blank"; b.tabIndex = -1; b.setAttribute("aria-hidden","true"); return b; }
    function buildHand(cls, hk, stag){
      var hand = document.createElement("div"); hand.className = "kbd-hand " + cls;
      var cols = document.createElement("div"); cols.className = "kbd-cols";
      var ki = 0;
      for(var c = 0; c < COLS; c++){
        var col = document.createElement("div"); col.className = "kbd-col";
        col.style.transform = "translateY(" + stag[c] + "px)";
        for(var r = 0; r < ROWS; r++){ col.appendChild(hk[ki++] || makeBlank()); }
        cols.appendChild(col);
      }
      hand.appendChild(cols);
      /* thumb cluster — the defining split-ergo silhouette (decorative caps) */
      var thumbWrap = document.createElement("div"); thumbWrap.className = "kbd-thumbwrap";
      var thumb = document.createElement("div"); thumb.className = "kbd-thumb";
      for(var ti = 0; ti < 3; ti++){ var tk = makeBlank(); tk.classList.add("thumbkey"); thumb.appendChild(tk); }
      /* right hand carries the trackball, nested by the thumb */
      if(cls === "right"){
        var tb = document.createElement("div"); tb.className = "kbd-trackball"; tb.setAttribute("aria-hidden","true");
        thumbWrap.appendChild(tb); thumbWrap.appendChild(thumb);
      } else {
        thumbWrap.appendChild(thumb);
      }
      hand.appendChild(thumbWrap);
      var palm = document.createElement("div"); palm.className = "kbd-palm"; hand.appendChild(palm);
      return hand;
    }
    deck.innerHTML = "";
    deck.appendChild(buildHand("left", board.slice(0, HALF), staL));
    deck.appendChild(buildHand("right", board.slice(HALF), staR));

    /* ── Web Audio: selectable synthesized key-sound profiles (no audio assets) ── */
    var AC = window.AudioContext || window.webkitAudioContext;
    var actx = null;
    var soundProfile = "thocky";
    try{ var sv = localStorage.getItem("kbdSound"); if(sv){ soundProfile = sv; } }catch(e){}
    function ensureCtx(){
      if(!actx && AC){ try{ actx = new AC(); }catch(e){ actx = null; } }
      if(actx && actx.state === "suspended"){ try{ actx.resume(); }catch(e){} }
    }
    if(soundSel){
      soundSel.value = soundProfile;
      soundSel.addEventListener("change", function(){
        soundProfile = soundSel.value;
        try{ localStorage.setItem("kbdSound", soundProfile); }catch(e){}
        ensureCtx();
        if(soundProfile !== "none"){ playClick(0); } /* preview the chosen sound */
      });
    }
    /* unlock audio on the first user gesture so the first key press is audible */
    function primeAudio(){
      ensureCtx();
      if(actx){ try{ var b = actx.createBuffer(1,1,actx.sampleRate); var s = actx.createBufferSource(); s.buffer=b; s.connect(actx.destination); s.start(0); }catch(e){} }
      document.removeEventListener("pointerdown", primeAudio);
      document.removeEventListener("keydown", primeAudio);
    }
    document.addEventListener("pointerdown", primeAudio);
    document.addEventListener("keydown", primeAudio);

    /* synth helpers */
    function noise(dur, ftype, freq, q, peak, t){
      var len = Math.max(1, Math.floor(actx.sampleRate * dur));
      var buf = actx.createBuffer(1, len, actx.sampleRate); var d = buf.getChannelData(0);
      for(var i = 0; i < len; i++){ d[i] = (Math.random()*2 - 1) * Math.pow(1 - i/len, 3); }
      var n = actx.createBufferSource(); n.buffer = buf;
      var f = actx.createBiquadFilter(); f.type = ftype; f.frequency.value = freq; if(q){ f.Q.value = q; }
      var g = actx.createGain();
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(peak, t+0.002); g.gain.exponentialRampToValueAtTime(0.0001, t+dur);
      n.connect(f); f.connect(g); g.connect(actx.destination); n.start(t);
    }
    function tone(wave, f0, f1, peak, dur, lp, t){
      var o = actx.createOscillator(), g = actx.createGain(), filt = actx.createBiquadFilter();
      filt.type = "lowpass"; filt.frequency.value = lp;
      o.type = wave; o.frequency.setValueAtTime(f0, t); o.frequency.exponentialRampToValueAtTime(f1, t + dur*0.7);
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(peak, t+0.005); g.gain.exponentialRampToValueAtTime(0.0001, t+dur);
      o.connect(g); g.connect(filt); filt.connect(actx.destination); o.start(t); o.stop(t + dur + 0.02);
    }
    /* each profile emulates the *character* of a popular switch-sound style */
    var PROFILES = {
      thocky: function(p,t){ tone("sine",152+p*14,80,0.26,0.13,720,t); noise(0.018,"lowpass",520,0,0.10,t); },
      creamy: function(p,t){ tone("sine",128+p*12,74,0.24,0.17,440,t); noise(0.022,"lowpass",360,0,0.07,t); },
      clacky: function(p,t){ noise(0.022,"highpass",2700,0,0.22,t); tone("triangle",320+p*22,150,0.13,0.05,2200,t); },
      poppy:  function(p,t){ tone("triangle",215+p*18,120,0.22,0.09,1500,t); noise(0.012,"bandpass",760,1.3,0.13,t); },
      clicky: function(p,t){ noise(0.009,"highpass",3300,0,0.20,t); tone("square",1350,920,0.09,0.018,3200,t); tone("sine",175,92,0.16,0.08,820,t); },
      lego:   function(p,t){ noise(0.016,"highpass",2200,0,0.26,t); tone("square",920,540,0.13,0.04,2600,t); }
    };
    function playClick(pitch){
      if(soundProfile === "none"){ return; }
      ensureCtx();
      if(!actx){ return; }
      var fn = PROFILES[soundProfile] || PROFILES.thocky;
      try{ fn(pitch || 0, actx.currentTime); }catch(e){}
    }

    /* ── info panel: show the tool name + its custom description ── */
    var activeEl = null;
    function showInfo(el, lock){
      if(!panel){ return; }
      var name = el.getAttribute("data-skill") || "";
      var cat = el.getAttribute("data-cat") || "";
      var desc = el.getAttribute("data-desc") || "";
      var col = (getComputedStyle(el).getPropertyValue("--kc") || "").trim() || "#7c5cff";
      panel.style.setProperty("--pk", col);
      panel.classList.remove("empty");
      if(pCat){ pCat.textContent = cat || "Tech"; }
      if(pName){ pName.textContent = name; }
      if(pDesc){ pDesc.textContent = desc || (cat ? (name + " — part of the " + cat + " stack.") : ""); }
      if(lock){
        if(activeEl && activeEl !== el){ activeEl.classList.remove("active"); }
        el.classList.add("active"); activeEl = el;
      }
    }

    function press(el, pitch){
      if(!el){ return; }
      var isKey = el.classList.contains("key");
      if(isKey){ el.classList.add("pressed"); }
      playClick(pitch || 0);
      showInfo(el, true);
      if(isKey){ setTimeout(function(){ el.classList.remove("pressed"); }, 120); }
    }
    function wire(el, p){
      el.addEventListener("pointerdown", function(){ ensureCtx(); press(el, p); });
      el.addEventListener("keydown", function(e){ if(e.key === "Enter" || e.key === " "){ e.preventDefault(); press(el, p); } });
      if(hoverable){ el.addEventListener("mouseenter", function(){ showInfo(el, false); }); }
    }
    /* keyboard keys + every chip in the "all skills" list are interactive */
    board.forEach(function(k, i){ wire(k, i % 6); });
    chips.forEach(function(c, i){ wire(c, i % 6); });

    /* physical keyboard → press the matching skill key (by first letter), else a random board key */
    document.addEventListener("keydown", function(e){
      if(e.metaKey || e.ctrlKey || e.altKey){ return; }
      var tag = e.target && e.target.tagName;
      if(tag === "INPUT" || tag === "TEXTAREA"){ return; }
      if(e.key && e.key.length === 1 && /[a-z0-9]/i.test(e.key) && board.length){
        var ch = e.key.toLowerCase();
        var m = board.filter(function(k){ return (k.getAttribute("data-skill") || "").toLowerCase().charAt(0) === ch; });
        var pick = m.length ? m[(Math.random() * m.length) | 0] : board[(Math.random() * board.length) | 0];
        press(pick, ch.charCodeAt(0) % 6);
      }
    });

    /* desktop pointer-parallax tilt (skip touch + reduced-motion) */
    if(!reduce && hoverable){
      var stage = deck.parentElement;
      stage.addEventListener("pointermove", function(e){
        var r = stage.getBoundingClientRect();
        var dx = (e.clientX - r.left) / r.width - 0.5;
        var dy = (e.clientY - r.top) / r.height - 0.5;
        deck.style.animation = "none";
        deck.style.transform = "rotateX(" + (22 - dy * 8) + "deg) rotateY(" + (dx * 10) + "deg)";
      });
      stage.addEventListener("pointerleave", function(){ deck.style.transform = ""; deck.style.animation = ""; });
    }
  })();
})();
</script>
</body>
</html>
