<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="#1a1a3e">
<meta property="og:title" content="{{basics.fullName}} | {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}{{/if}}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ================================================================
   EDUCATOR PORTFOLIO — Scholarly Library Design
   Warm indigo + amber reading-lamp aesthetic
   ================================================================ */

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --font-head: 'Cormorant Garamond', 'Georgia', serif;
  --font-body: 'DM Sans', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --bg: {{#if customization.bgColor}}{{customization.bgColor}}{{else}}#1a1a3e{{/if}};
  --bg-deep: #12122a;
  --bg-card: rgba(26, 26, 70, 0.55);
  --primary: {{#if customization.accentColor}}{{customization.accentColor}}{{else}}#f59e0b{{/if}};
  --primary-glow: rgba(245, 158, 11, 0.30);
  --primary-dim: rgba(245, 158, 11, 0.10);
  --secondary: #6b8f71;
  --secondary-dim: rgba(107, 143, 113, 0.10);
  --accent: #fef3c7;
  --text: {{#if customization.primaryColor}}{{customization.primaryColor}}{{else}}#f0ece4{{/if}};
  --text-secondary: #a89b82;
  --text-tertiary: #6b5f4a;
  --border: rgba(245, 158, 11, 0.07);
  --border-strong: rgba(245, 158, 11, 0.15);
  --r: 8px;
  --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: var(--font-body);
  background: var(--bg-deep);
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}
a { text-decoration: none; color: inherit; }

/* ================================================================
   NAV
   ================================================================ */
.nav {
  position: sticky; top: 0; z-index: 1000;
  background: rgba(18, 18, 42, 0.92);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  padding: 16px 40px;
  display: flex; justify-content: space-between; align-items: center;
}
.nav-brand {
  font-family: var(--font-head); font-size: 1.15rem; font-weight: 600;
  color: var(--text); letter-spacing: 0.01em;
}
.nav-links { display: flex; gap: 28px; align-items: center; }
.nav-links a {
  font-size: 0.82rem; font-weight: 500; color: var(--text-secondary);
  letter-spacing: 0.03em; transition: color 200ms;
}
.nav-links a:hover { color: var(--primary); }
.nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
.nav-toggle span {
  display: block; width: 22px; height: 1.5px; background: var(--text);
  margin: 5px 0; transition: all 200ms;
}

/* ================================================================
   LAYOUT
   ================================================================ */
.container { max-width: 960px; margin: 0 auto; padding: 0 32px; }
.section { padding: 72px 0; }
.section-rule {
  height: 1px; max-width: 960px; margin: 0 auto;
  background: linear-gradient(90deg, transparent, var(--border-strong) 30%, var(--border-strong) 70%, transparent);
}

/* ================================================================
   REVEAL ANIMATION (700ms max)
   ================================================================ */
.rv {
  opacity: 0; transform: translateY(14px);
  transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
}
.rv.v { opacity: 1; transform: translateY(0); }
.rv-d1 { transition-delay: 0.1s; }
.rv-d2 { transition-delay: 0.2s; }
.rv-d3 { transition-delay: 0.3s; }

/* ================================================================
   1. HERO
   ================================================================ */
.hero { background: var(--bg); padding: 80px 0 64px; }
.hero-inner { text-align: center; }
.hero-name {
  font-family: var(--font-head);
  font-size: clamp(2.6rem, 5.5vw, 4rem);
  font-weight: 700; line-height: 1.1;
  color: var(--text); letter-spacing: -0.01em;
  margin-bottom: 12px;
}
.hero-title {
  font-family: var(--font-head);
  font-size: 1.25rem; font-weight: 400; font-style: italic;
  color: var(--primary); margin-bottom: 6px;
}
.hero-subtitle {
  font-size: 0.92rem; color: var(--text-secondary);
  max-width: 560px; margin: 0 auto 28px;
}
.hero-bio {
  font-size: 0.95rem; color: var(--text-secondary); line-height: 1.85;
  max-width: 640px; margin: 0 auto 32px;
  font-style: italic;
}
.hero-contact {
  display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;
  margin-bottom: 32px;
}
.hero-contact a, .hero-contact span {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 0.8rem; color: var(--text-secondary); font-weight: 500;
  transition: color 200ms;
}
.hero-contact a:hover { color: var(--primary); }
.hero-contact svg { width: 15px; height: 15px; color: var(--primary); flex-shrink: 0; }

{{#if metrics}}
.hero-metrics {
  display: flex; justify-content: center; gap: 40px; flex-wrap: wrap;
  padding-top: 28px; border-top: 1px solid var(--border);
}
.h-metric { text-align: center; }
.h-metric-val {
  font-family: var(--font-head); font-size: 1.6rem; font-weight: 700;
  color: var(--primary); line-height: 1;
}
.h-metric-label {
  font-size: 0.68rem; color: var(--text-tertiary); margin-top: 4px;
  text-transform: uppercase; letter-spacing: 0.06em; font-weight: 500;
}
{{/if}}

/* ================================================================
   2. TEACHING PHILOSOPHY / VALUE PROPOSITION
   ================================================================ */
.philosophy-block {
  border-left: 3px solid var(--primary);
  padding: 24px 28px;
  background: var(--primary-dim);
  border-radius: 0 var(--r) var(--r) 0;
  max-width: 720px; margin: 0 auto;
}
.philosophy-block p {
  font-family: var(--font-head); font-size: 1.15rem;
  font-style: italic; color: var(--text); line-height: 1.8;
}

/* ================================================================
   3. SKILLS / RESEARCH AREAS
   ================================================================ */
.skills-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 28px;
}
.skill-group {
  padding: 24px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
}
.skill-group h3 {
  font-family: var(--font-head); font-size: 1.05rem; font-weight: 600;
  color: var(--primary); margin-bottom: 14px;
}
.skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.skill-tag {
  padding: 5px 14px; border-radius: 100px;
  background: var(--primary-dim);
  border: 1px solid var(--border-strong);
  font-size: 0.78rem; color: var(--text); font-weight: 500;
  transition: background 200ms, border-color 200ms;
}
.skill-tag:hover {
  background: var(--primary-glow);
  border-color: var(--primary);
}

/* ================================================================
   4. PROJECTS / PUBLICATIONS (APA-style)
   ================================================================ */
.pub-list { display: flex; flex-direction: column; gap: 20px; }
.pub-card {
  padding: 24px 28px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  transition: border-color 300ms;
}
.pub-card:hover { border-color: var(--border-strong); }
.pub-card h3 {
  font-family: var(--font-head); font-size: 1.1rem; font-weight: 600;
  color: var(--text); margin-bottom: 8px; line-height: 1.4;
}
.pub-card h3 a { color: var(--primary); transition: color 200ms; }
.pub-card h3 a:hover { color: var(--accent); }
.pub-desc {
  font-size: 0.88rem; color: var(--text-secondary); line-height: 1.7;
  margin-bottom: 12px;
}
.pub-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.pub-tech {
  padding: 3px 10px; border-radius: 100px;
  background: var(--secondary-dim); border: 1px solid rgba(107, 143, 113, 0.18);
  font-size: 0.7rem; color: var(--secondary); font-weight: 500;
}
.pub-doi {
  font-family: var(--font-mono); font-size: 0.72rem;
  color: var(--primary); opacity: 0.8;
}

/* ================================================================
   5. EXPERIENCE / ACADEMIC POSITIONS (timeline)
   ================================================================ */
.timeline {
  display: flex; flex-direction: column;
  border-left: 2px solid rgba(107, 143, 113, 0.25);
  margin-left: 10px;
}
.tl-item {
  position: relative;
  padding: 0 0 36px 36px;
}
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before {
  content: ''; position: absolute; left: -6px; top: 8px;
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--secondary); border: 2px solid var(--bg-deep);
  z-index: 1;
}
.tl-card {
  padding: 20px 24px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
}
.tl-top {
  display: flex; justify-content: space-between;
  align-items: flex-start; gap: 12px;
  margin-bottom: 4px;
}
.tl-role {
  font-family: var(--font-head); font-size: 1.1rem; font-weight: 600;
  color: var(--text);
}
.tl-period {
  font-size: 0.72rem; font-weight: 600; color: var(--secondary);
  padding: 3px 10px; border-radius: 100px;
  background: var(--secondary-dim);
  white-space: nowrap; flex-shrink: 0;
}
.tl-company {
  font-size: 0.88rem; color: var(--text-secondary); font-weight: 500;
  margin-bottom: 10px;
}
.tl-desc {
  font-size: 0.85rem; color: var(--text-secondary); line-height: 1.7;
}
.tl-highlights { display: flex; flex-direction: column; gap: 5px; }
.tl-highlight {
  font-size: 0.83rem; color: var(--text-secondary);
  padding-left: 16px; position: relative; line-height: 1.6;
}
.tl-highlight::before {
  content: ''; position: absolute; left: 0; top: 9px;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--secondary); opacity: 0.6;
}

/* ================================================================
   6. EDUCATION (prominent degree cards)
   ================================================================ */
.edu-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}
.edu-card {
  padding: 28px;
  background: var(--bg-card);
  border: 1px solid var(--border-strong);
  border-radius: var(--r);
  border-top: 3px solid var(--primary);
}
.edu-year {
  font-family: var(--font-head); font-size: 0.85rem;
  color: var(--primary); font-style: italic; font-weight: 500;
  margin-bottom: 8px;
}
.edu-card h3 {
  font-family: var(--font-head); font-size: 1.15rem; font-weight: 700;
  color: var(--text); margin-bottom: 4px; line-height: 1.3;
}
.edu-inst {
  font-size: 0.88rem; color: var(--text-secondary); font-weight: 500;
}
.edu-desc {
  font-size: 0.8rem; color: var(--text-tertiary); margin-top: 8px;
  line-height: 1.6;
}

/* ================================================================
   7. CERTIFICATIONS
   ================================================================ */
.cert-list {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 14px;
}
.cert-item {
  padding: 16px 20px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  display: flex; align-items: center; gap: 14px;
}
.cert-icon {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--primary-dim); display: flex;
  align-items: center; justify-content: center; flex-shrink: 0;
}
.cert-icon svg { width: 18px; height: 18px; color: var(--primary); }
.cert-name {
  font-family: var(--font-head); font-size: 0.92rem; font-weight: 600;
  color: var(--text); line-height: 1.3;
}
.cert-issuer {
  font-size: 0.72rem; color: var(--text-tertiary); margin-top: 2px;
}

/* ================================================================
   8. ENDORSEMENTS / STUDENT TESTIMONIALS
   ================================================================ */
.testimonial-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}
.testimonial-card {
  padding: 28px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
}
.testimonial-mark {
  font-family: var(--font-head); font-size: 3rem; line-height: 1;
  color: var(--primary); opacity: 0.4; margin-bottom: 4px;
}
.testimonial-text {
  font-size: 0.88rem; color: var(--text-secondary);
  line-height: 1.8; font-style: italic; margin-bottom: 18px;
}
.testimonial-author {
  border-top: 1px solid var(--border); padding-top: 12px;
}
.testimonial-name {
  font-family: var(--font-head); font-size: 0.88rem;
  font-weight: 600; color: var(--text);
}
.testimonial-role {
  font-size: 0.72rem; color: var(--text-tertiary);
}

/* ================================================================
   9. LANGUAGES
   ================================================================ */
.lang-list { display: flex; flex-wrap: wrap; gap: 10px; }
.lang-chip {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 18px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
}
.lang-chip-name {
  font-size: 0.88rem; font-weight: 600; color: var(--text);
}
.lang-chip-level {
  font-size: 0.65rem; color: var(--text-tertiary);
  background: var(--primary-dim); padding: 2px 8px;
  border-radius: 100px; font-weight: 600;
}

/* ================================================================
   10. CONTACT / FOOTER
   ================================================================ */
.footer {
  background: var(--bg-deep);
  border-top: 1px solid var(--border);
  padding: 56px 0 32px;
}
.footer-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
  margin-bottom: 32px;
}
.footer-heading {
  font-family: var(--font-head); font-size: 0.78rem; font-weight: 600;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--text-tertiary); margin-bottom: 12px;
}
.footer-text { font-size: 0.88rem; color: var(--text-secondary); line-height: 1.8; }
.footer-text a { color: var(--primary); transition: color 200ms; }
.footer-text a:hover { color: var(--accent); }
.footer-bottom {
  border-top: 1px solid var(--border); padding-top: 20px;
  font-size: 0.75rem; color: var(--text-tertiary); text-align: center;
}
.footer-bottom a { color: var(--primary); }

/* ================================================================
   SECTION HEADERS
   ================================================================ */
.section-label {
  font-size: 0.68rem; font-weight: 600;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--primary);
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 10px;
}
.section-label::before {
  content: ''; width: 20px; height: 1.5px; background: var(--primary);
}
.section-title {
  font-family: var(--font-head);
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 600; color: var(--text);
  line-height: 1.25; letter-spacing: -0.01em;
  margin-bottom: 36px;
}
.section-title em { font-style: italic; color: var(--primary); font-weight: 400; }

/* ================================================================
   PRINT
   ================================================================ */
@media print {
  @page { margin: 0.5in; size: A4; }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  html, body { background: #fff !important; color: #111 !important; font-size: 10pt; }
  .nav, .no-print { display: none !important; }
  .rv { opacity: 1 !important; transform: none !important; transition: none !important; }

  .hero { background: #fff !important; padding: 0 0 10px !important; }
  .hero-name { color: #111 !important; font-size: 22pt !important; }
  .hero-title { color: #b45309 !important; font-size: 11pt; }
  .hero-subtitle, .hero-bio { color: #444 !important; font-size: 9pt; }
  .hero-contact a, .hero-contact span { color: #444 !important; font-size: 8pt; }
  .hero-contact svg { color: #b45309 !important; }

  .section { padding: 14px 0 !important; }
  .section-label { font-size: 6.5pt; color: #b45309 !important; }
  .section-label::before { background: #b45309 !important; }
  .section-title { font-size: 13pt !important; color: #111 !important; margin-bottom: 10px !important; }
  .section-title em { color: #b45309 !important; }
  .section-rule { display: none; }

  .philosophy-block {
    border-left-color: #b45309 !important;
    background: #fef3c7 !important; padding: 10px 14px;
  }
  .philosophy-block p { color: #333 !important; font-size: 9pt; }

  .skill-group, .pub-card, .tl-card, .edu-card, .cert-item,
  .testimonial-card, .lang-chip {
    background: #fff !important; border-color: #ddd !important;
    page-break-inside: avoid !important; break-inside: avoid !important;
  }
  .edu-card { border-top-color: #b45309 !important; }

  .skill-group h3 { color: #b45309 !important; font-size: 9pt; }
  .skill-tag { background: #f5f5f5 !important; border-color: #ddd !important; color: #333 !important; font-size: 7pt; }
  .pub-card h3 { font-size: 9.5pt; color: #111 !important; }
  .pub-card h3 a { color: #b45309 !important; }
  .pub-desc { font-size: 8pt; color: #444 !important; }
  .pub-doi { font-size: 7pt; color: #b45309 !important; }
  .pub-tech { font-size: 6.5pt; }

  .tl-item { padding-bottom: 10px; padding-left: 24px; }
  .tl-item::before { width: 7px; height: 7px; left: -4px; }
  .tl-card { padding: 8px 12px; }
  .tl-role { font-size: 10pt; color: #111 !important; }
  .tl-company { font-size: 8pt; color: #444 !important; }
  .tl-period { font-size: 7pt; }
  .tl-desc, .tl-highlight { font-size: 8pt; color: #444 !important; }

  .edu-card h3 { font-size: 10pt; color: #111 !important; }
  .edu-year { font-size: 8pt; color: #b45309 !important; }
  .edu-inst { font-size: 8pt; color: #444 !important; }
  .edu-desc { font-size: 7.5pt; color: #666 !important; }

  .cert-item { padding: 6px 10px; }
  .cert-name { font-size: 8pt; color: #111 !important; }
  .cert-issuer { font-size: 7pt; }

  .testimonial-card { padding: 10px 12px; }
  .testimonial-mark { font-size: 1.5rem; }
  .testimonial-text { font-size: 8pt; color: #444 !important; }
  .testimonial-name { font-size: 8pt; color: #111 !important; }
  .testimonial-role { font-size: 7pt; }

  .lang-chip { padding: 4px 10px; }
  .lang-chip-name { font-size: 8pt; color: #111 !important; }
  .lang-chip-level { font-size: 6.5pt; }

  .footer { background: #fff !important; border-top-color: #ddd !important; padding: 10px 0 !important; }
  .footer-heading { color: #888 !important; font-size: 7pt; }
  .footer-text { font-size: 8pt; color: #444 !important; }
  .footer-text a { color: #b45309 !important; }
  .footer-bottom { font-size: 7pt; color: #888 !important; }
  .footer-grid { margin-bottom: 8px; gap: 16px; }

  .container { padding: 0 !important; }
  .h-metric-val { color: #b45309 !important; font-size: 13pt; }
  .h-metric-label { color: #666 !important; font-size: 6.5pt; }
  .hero-metrics { border-top-color: #ddd !important; }
}

/* ================================================================
   RESPONSIVE
   ================================================================ */
@media (max-width: 768px) {
  .nav { padding: 12px 20px; }
  .nav-links {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    flex-direction: column; background: rgba(18, 18, 42, 0.98);
    backdrop-filter: blur(12px); border-bottom: 1px solid var(--border);
    padding: 12px 20px; gap: 0; z-index: 1000;
  }
  .nav-links.open { display: flex; }
  .nav-links a {
    display: block; padding: 12px 0;
    border-bottom: 1px solid var(--border); font-size: 0.88rem;
  }
  .nav-links a:last-child { border-bottom: none; }
  .nav-toggle { display: flex; flex-direction: column; gap: 5px; }

  .container { padding: 0 20px; }
  .section { padding: 48px 0; }
  .hero { padding: 56px 0 40px; }
  .hero-name { font-size: 2.2rem; }
  .hero-contact { gap: 12px; }
  .hero-metrics { gap: 24px; }

  .skills-grid { grid-template-columns: 1fr; }
  .edu-grid { grid-template-columns: 1fr; }
  .cert-list { grid-template-columns: 1fr; }
  .testimonial-grid { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; gap: 24px; }

  .tl-item { padding-left: 24px; }
  .tl-top { flex-direction: column; gap: 6px; }
  .philosophy-block { padding: 18px 20px; }
}

/* ================================================================
   RTL
   ================================================================ */
[dir="rtl"] .section-label { direction: rtl; }
[dir="rtl"] .section-label::before { display: none; }
[dir="rtl"] .section-label::after { content: ''; width: 20px; height: 1.5px; background: var(--primary); }
[dir="rtl"] .timeline { border-left: none; border-right: 2px solid rgba(107, 143, 113, 0.25); margin-left: 0; margin-right: 10px; }
[dir="rtl"] .tl-item { padding-left: 0; padding-right: 36px; }
[dir="rtl"] .tl-item::before { left: auto; right: -6px; }
[dir="rtl"] .tl-highlight { padding-left: 0; padding-right: 16px; }
[dir="rtl"] .tl-highlight::before { left: auto; right: 0; }
[dir="rtl"] .philosophy-block { border-left: none; border-right: 3px solid var(--primary); border-radius: var(--r) 0 0 var(--r); }
[dir="rtl"] .hero-contact { direction: rtl; }
[dir="rtl"] .nav-links { direction: ltr; }
</style>
{{#if customization}}
<style>
{{#if customization.primaryColor}}
:root { --text: {{customization.primaryColor}}; }
{{/if}}
{{#if customization.accentColor}}
:root {
  --primary: {{customization.accentColor}};
  --primary-glow: {{customization.accentColor}}4d;
  --primary-dim: {{customization.accentColor}}1a;
  --border-strong: {{customization.accentColor}}26;
}
{{/if}}
{{#if customization.bgColor}}
:root { --bg: {{customization.bgColor}}; }
{{/if}}
</style>
{{/if}}
</head>
<body>

<!-- NAV -->
<nav class="nav">
  <a href="#" class="nav-brand">{{basics.fullName}}</a>
  <div class="nav-links">
    {{#if skills}}<a href="#skills">Research</a>{{/if}}
    {{#if projects}}<a href="#publications">Publications</a>{{/if}}
    {{#if experience}}<a href="#experience">Positions</a>{{/if}}
    {{#if education}}<a href="#education">Education</a>{{/if}}
    {{#if basics.email}}<a href="mailto:{{basics.email}}">Contact</a>{{/if}}
  </div>
  <button class="nav-toggle" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<!-- 1. HERO -->
<section class="hero">
  <div class="container">
    <div class="hero-inner">
      <h1 class="hero-name rv">{{basics.fullName}}</h1>
      <p class="hero-title rv rv-d1">{{basics.title}}</p>
      {{#if basics.subtitle}}
      <p class="hero-subtitle rv rv-d1">{{basics.subtitle}}</p>
      {{/if}}
      {{#if basics.bio}}
      <p class="hero-bio rv rv-d2">&ldquo;{{basics.bio}}&rdquo;</p>
      {{/if}}

      <div class="hero-contact rv rv-d2">
        {{#if basics.email}}
        <a href="mailto:{{basics.email}}">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
          {{basics.email}}
        </a>
        {{/if}}
        {{#if basics.phone}}
        <a href="tel:{{basics.phone}}">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
          {{basics.phone}}
        </a>
        {{/if}}
        {{#if basics.linkedin}}
        <a href="{{basics.linkedin}}" target="_blank" rel="noopener">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/></svg>
          LinkedIn
        </a>
        {{/if}}
        {{#if basics.github}}
        <a href="{{basics.github}}" target="_blank" rel="noopener">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5"/></svg>
          GitHub
        </a>
        {{/if}}
        {{#if basics.website}}
        <a href="{{basics.website}}" target="_blank" rel="noopener">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"/></svg>
          Website
        </a>
        {{/if}}
        {{#if basics.location}}
        <span>
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
          {{basics.location}}
        </span>
        {{/if}}
      </div>

      {{#if metrics}}
      <div class="hero-metrics rv rv-d3">
        {{#each metrics}}
        <div class="h-metric">
          <div class="h-metric-val">{{this.value}}</div>
          <div class="h-metric-label">{{this.label}}</div>
        </div>
        {{/each}}
      </div>
      {{/if}}
    </div>
  </div>
</section>

<!-- 2. TEACHING PHILOSOPHY / VALUE PROPOSITION -->
{{#if basics.valueProposition}}
{{#unless (isHidden "teaching-philosophy")}}
<div class="section-rule"></div>
<section class="section">
  <div class="container">
    <div class="section-label rv">Teaching Philosophy</div>
    <div class="philosophy-block rv rv-d1">
      <p>{{basics.valueProposition}}</p>
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 3. SKILLS / RESEARCH AREAS -->
{{#if skills}}
{{#unless (isHidden "skills")}}
<div class="section-rule"></div>
<section id="skills" class="section">
  <div class="container">
    <div class="section-label rv">Research Areas</div>
    <div class="section-title rv rv-d1">Fields of <em>expertise</em></div>
    <div class="skills-grid">
      {{#each skills}}
      <div class="skill-group rv">
        <h3>{{this.category}}</h3>
        <div class="skill-tags">
          {{#each this.items}}<span class="skill-tag">{{this}}</span>{{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 4. PROJECTS / PUBLICATIONS -->
{{#if projects}}
{{#unless (isHidden "publications")}}
<div class="section-rule"></div>
<section id="publications" class="section">
  <div class="container">
    <div class="section-label rv">Selected Works</div>
    <div class="section-title rv rv-d1">Publications & <em>research</em></div>
    <div class="pub-list">
      {{#each projects}}
      <article class="pub-card rv">
        <h3>
          {{#if this.url}}<a href="{{this.url}}" target="_blank" rel="noopener">{{this.title}}</a>{{else}}{{this.title}}{{/if}}
        </h3>
        {{#if this.description}}
        <p class="pub-desc">{{this.description}}</p>
        {{/if}}
        <div class="pub-meta">
          {{#if this.technologies}}
            {{#each this.technologies}}<span class="pub-tech">{{this}}</span>{{/each}}
          {{/if}}
          {{#if this.doi}}
          <span class="pub-doi">DOI: {{this.doi}}</span>
          {{/if}}
        </div>
      </article>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 5. EXPERIENCE / ACADEMIC POSITIONS -->
{{#if experience}}
{{#unless (isHidden "experience")}}
<div class="section-rule"></div>
<section id="experience" class="section">
  <div class="container">
    <div class="section-label rv">Academic Career</div>
    <div class="section-title rv rv-d1">Positions & <em>appointments</em></div>
    <div class="timeline">
      {{#each experience}}
      <div class="tl-item rv">
        <div class="tl-card">
          <div class="tl-top">
            <div class="tl-role">{{this.title}}</div>
            <span class="tl-period">{{this.startDate}} &mdash; {{#if this.endDate}}{{this.endDate}}{{else}}Present{{/if}}</span>
          </div>
          <div class="tl-company">{{this.company}}</div>
          {{#if this.highlights}}
          <div class="tl-highlights">
            {{#each this.highlights}}
            <div class="tl-highlight">{{this}}</div>
            {{/each}}
          </div>
          {{else if this.description}}
          <p class="tl-desc">{{this.description}}</p>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 6. EDUCATION -->
{{#if education}}
{{#unless (isHidden "education")}}
<div class="section-rule"></div>
<section id="education" class="section">
  <div class="container">
    <div class="section-label rv">Academic Foundation</div>
    <div class="section-title rv rv-d1">Degrees & <em>credentials</em></div>
    <div class="edu-grid">
      {{#each education}}
      <div class="edu-card rv">
        <div class="edu-year">{{this.year}}</div>
        <h3>{{this.degree}}</h3>
        <p class="edu-inst">{{this.institution}}</p>
        {{#if this.description}}
        <p class="edu-desc">{{this.description}}</p>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 7. CERTIFICATIONS -->
{{#if certifications}}
{{#unless (isHidden "certifications")}}
<div class="section-rule"></div>
<section class="section">
  <div class="container">
    <div class="section-label rv">Certifications</div>
    <div class="section-title rv rv-d1">Professional <em>accreditations</em></div>
    <div class="cert-list">
      {{#each certifications}}
      <div class="cert-item rv">
        <div class="cert-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/></svg>
        </div>
        <div>
          <div class="cert-name">{{this.name}}</div>
          {{#if this.issuer}}<div class="cert-issuer">{{this.issuer}}</div>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 8. ENDORSEMENTS / STUDENT TESTIMONIALS -->
{{#if endorsements}}
{{#unless (isHidden "endorsements")}}
<div class="section-rule"></div>
<section class="section">
  <div class="container">
    <div class="section-label rv">Testimonials</div>
    <div class="section-title rv rv-d1">What students & colleagues <em>say</em></div>
    <div class="testimonial-grid">
      {{#each endorsements}}
      <div class="testimonial-card rv">
        <div class="testimonial-mark">&ldquo;</div>
        <p class="testimonial-text">{{this.quote}}</p>
        <div class="testimonial-author">
          <div class="testimonial-name">{{this.name}}</div>
          <div class="testimonial-role">{{this.title}}{{#if this.company}}, {{this.company}}{{/if}}</div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 9. LANGUAGES -->
{{#if languages}}
{{#unless (isHidden "languages")}}
<div class="section-rule"></div>
<section class="section">
  <div class="container">
    <div class="section-label rv">Languages</div>
    <div class="lang-list">
      {{#each languages}}
      <div class="lang-chip rv">
        <span class="lang-chip-name">{{this.name}}</span>
        <span class="lang-chip-level">{{this.level}}</span>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

<!-- 10. CONTACT / FOOTER -->
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-heading">Contact</div>
        <div class="footer-text">
          {{#if basics.email}}<p><a href="mailto:{{basics.email}}">{{basics.email}}</a></p>{{/if}}
          {{#if basics.phone}}<p><a href="tel:{{basics.phone}}">{{basics.phone}}</a></p>{{/if}}
          {{#if basics.linkedin}}<p><a href="{{basics.linkedin}}" target="_blank" rel="noopener">LinkedIn Profile</a></p>{{/if}}
          {{#if basics.website}}<p><a href="{{basics.website}}" target="_blank" rel="noopener">Academic Website</a></p>{{/if}}
        </div>
      </div>
      <div>
        <div class="footer-heading">Location</div>
        <div class="footer-text">
          <p>{{#if basics.location}}{{basics.location}}{{else}}Available for academic appointments{{/if}}</p>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      &copy; {{basics.fullName}} &middot; {{basics.title}}
    </div>
  </div>
</footer>

<script>
/* Mobile nav toggle */
var navToggle = document.querySelector('.nav-toggle');
var navLinks = document.querySelector('.nav-links');
if (navToggle && navLinks) {
  navToggle.addEventListener('click', function() { navLinks.classList.toggle('open'); });
  navLinks.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() { navLinks.classList.remove('open'); });
  });
}

/* Gentle scroll reveal (700ms) */
var ro = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) {
    if (e.isIntersecting) { e.target.classList.add('v'); ro.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
document.querySelectorAll('.rv').forEach(function(el) { ro.observe(el); });

/* Smooth scroll for anchor links */
document.querySelectorAll('a[href^="#"]').forEach(function(a) {
  a.addEventListener('click', function(e) {
    e.preventDefault();
    var t = document.querySelector(a.getAttribute('href'));
    if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

/* Reduced motion */
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll('.rv').forEach(function(el) {
    el.classList.add('v'); el.style.transition = 'none';
  });
}
</script>
</body>
</html>