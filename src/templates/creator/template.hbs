<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="#0c0a09">
<meta property="og:title" content="{{basics.fullName}} | {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}{{/if}}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════════════════
   CREATOR PORTFOLIO — Warm Amber Dark Theme
   For content creators, artists, YouTubers & marketers
   ══════════════════════════════════════════════════════ */

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --font-head: 'Plus Jakarta Sans', sans-serif;
  --font-body: 'Inter', sans-serif;
  --bg: {{#if customization.bgColor}}{{customization.bgColor}}{{else}}#0c0a09{{/if}};
  --bg-card: rgba(28, 25, 23, 0.70);
  --bg-card-solid: #1c1917;
  --amber: {{#if customization.primaryColor}}{{customization.primaryColor}}{{else}}#f59e0b{{/if}};
  --red: {{#if customization.accentColor}}{{customization.accentColor}}{{else}}#ef4444{{/if}};
  --violet: #8b5cf6;
  --text: #f5f5f4;
  --text-secondary: #a8a29e;
  --text-muted: #57534e;
  --border: rgba(245, 158, 11, 0.08);
  --gradient-hero: linear-gradient(135deg, var(--amber) 0%, var(--red) 50%, var(--violet) 100%);
  --r: 12px;
  --r-sm: 8px;
  --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a { text-decoration: none; color: inherit; }
img { max-width: 100%; display: block; }

/* ═══ KEYFRAMES ═══ */
@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(32px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes orbDrift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(80px, -60px) scale(1.1); }
  50% { transform: translate(-40px, -120px) scale(0.9); }
  75% { transform: translate(-100px, 30px) scale(1.05); }
}
@keyframes pulseGlow {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.7; }
}

/* ═══ NOISE OVERLAY ═══ */
body::before {
  content: '';
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events: none; z-index: 0;
}

/* ═══ FLOATING ORBS ═══ */
.orb {
  position: fixed; border-radius: 50%; pointer-events: none;
  filter: blur(80px); z-index: 0;
}
.orb-amber {
  width: 400px; height: 400px;
  background: var(--amber); opacity: 0.12;
  top: -100px; left: -100px;
  animation: orbDrift 32s ease-in-out infinite;
}
.orb-red {
  width: 350px; height: 350px;
  background: var(--red); opacity: 0.10;
  bottom: -80px; right: -80px;
  animation: orbDrift 32s ease-in-out infinite reverse;
}
.orb-violet {
  width: 300px; height: 300px;
  background: var(--violet); opacity: 0.07;
  top: 50%; left: 50%;
  animation: orbDrift 32s ease-in-out infinite 8s;
}

/* ═══ LAYOUT ═══ */
.container { max-width: 1200px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 1; }
.section { padding: 100px 0; position: relative; z-index: 1; }
.section-label {
  font-family: var(--font-head); font-size: 0.72rem; font-weight: 600;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--amber); margin-bottom: 12px;
}
.section-title {
  font-family: var(--font-head);
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  font-weight: 800; color: var(--text);
  line-height: 1.15; letter-spacing: -0.02em;
  margin-bottom: 48px;
}
.section-title em {
  font-style: normal;
  background: var(--gradient-hero); background-size: 200% 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 4s ease infinite;
}
.divider {
  height: 1px; max-width: 1200px; margin: 0 auto;
  background: linear-gradient(90deg, transparent, var(--border) 20%, rgba(239,68,68,0.08) 80%, transparent);
}

/* ═══ NAV ═══ */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
  padding: 20px 40px;
  display: flex; justify-content: space-between; align-items: center;
  background: rgba(12,10,9,0.85);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid transparent;
  transition: all 250ms var(--ease);
}
.nav-brand {
  font-family: var(--font-head); font-weight: 800; font-size: 1.1rem;
  background: var(--gradient-hero); background-size: 200% 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 4s ease infinite;
}
.nav-links { display: flex; gap: 28px; align-items: center; }
.nav-links a {
  font-family: var(--font-body); font-size: 0.82rem; font-weight: 500;
  color: var(--text-secondary); letter-spacing: 0.02em;
  transition: color 200ms;
}
.nav-links a:hover { color: var(--text); }
.nav-cta {
  color: var(--amber) !important;
  border: 1.5px solid rgba(245,158,11,0.3);
  padding: 7px 20px; border-radius: 100px;
  transition: all 200ms !important;
}
.nav-cta:hover { background: rgba(245,158,11,0.1) !important; border-color: var(--amber) !important; }
.nav-toggle { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
.nav-toggle svg { width: 24px; height: 24px; color: var(--text); }

/* ══════════════════════════════════════════════════════
   1. HERO
   ══════════════════════════════════════════════════════ */
.hero {
  min-height: 100vh; display: flex; align-items: center; justify-content: center;
  text-align: center; padding: 120px 32px 80px;
  position: relative; overflow: hidden;
}
.hero-content {
  position: relative; z-index: 2;
  animation: fadeInUp 1s var(--ease) 0.3s both;
}
.hero-subtitle {
  font-family: var(--font-body); font-size: 0.82rem; font-weight: 500;
  color: var(--text-secondary); letter-spacing: 0.12em; text-transform: uppercase;
  margin-bottom: 20px;
  animation: fadeInUp 0.8s var(--ease) 0.5s both;
}
.hero-name {
  font-family: var(--font-head);
  font-size: clamp(3rem, 8vw, 7rem);
  font-weight: 800; line-height: 1;
  letter-spacing: -0.03em;
  background: var(--gradient-hero);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 4s ease infinite;
  margin-bottom: 16px;
}
.hero-title {
  font-family: var(--font-body); font-size: clamp(1rem, 2vw, 1.3rem);
  color: var(--text-secondary); font-weight: 400;
  max-width: 600px; margin: 0 auto 12px;
  animation: fadeInUp 0.8s var(--ease) 0.7s both;
}
.hero-location {
  font-size: 0.82rem; color: var(--text-muted);
  display: flex; align-items: center; justify-content: center; gap: 6px;
  margin-bottom: 32px;
  animation: fadeInUp 0.8s var(--ease) 0.8s both;
}
.hero-location svg { width: 14px; height: 14px; }
.hero-actions {
  display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;
  animation: fadeInUp 0.8s var(--ease) 0.9s both;
}
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 14px 32px; border-radius: 100px;
  font-family: var(--font-body); font-size: 0.85rem; font-weight: 600;
  letter-spacing: 0.02em; cursor: pointer;
  transition: all 300ms var(--ease); border: none;
}
.btn-primary {
  background: var(--gradient-hero); background-size: 200% 200%;
  color: #0c0a09; animation: gradientShift 4s ease infinite;
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(245,158,11,0.3); }
.btn-ghost {
  background: transparent; color: var(--text);
  border: 1.5px solid rgba(245,245,244,0.15);
}
.btn-ghost:hover { border-color: var(--amber); color: var(--amber); transform: translateY(-2px); }

/* ══════════════════════════════════════════════════════
   2. SOCIAL STATS / METRICS
   ══════════════════════════════════════════════════════ */
.metrics-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
}
.metric-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 28px 24px; text-align: center;
  backdrop-filter: blur(12px);
  transition: transform 400ms var(--ease), box-shadow 400ms var(--ease);
  position: relative; overflow: hidden;
}
.metric-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0;
  height: 2px; border-radius: var(--r) var(--r) 0 0;
}
.metric-card:nth-child(3n+1)::before { background: var(--amber); }
.metric-card:nth-child(3n+2)::before { background: var(--red); }
.metric-card:nth-child(3n+0)::before { background: var(--violet); }
.metric-card:hover { transform: translateY(-6px); box-shadow: 0 12px 40px rgba(245,158,11,0.12); }
.metric-val {
  font-family: var(--font-head);
  font-size: 2.4rem; font-weight: 800;
  line-height: 1; margin-bottom: 6px;
}
.metric-card:nth-child(3n+1) .metric-val { color: var(--amber); }
.metric-card:nth-child(3n+2) .metric-val { color: var(--red); }
.metric-card:nth-child(3n+0) .metric-val { color: var(--violet); }
.metric-label {
  font-size: 0.72rem; color: var(--text-secondary);
  letter-spacing: 0.06em; text-transform: uppercase;
  font-weight: 500;
}

/* ══════════════════════════════════════════════════════
   3. CONTENT SHOWCASE / PROJECTS
   ══════════════════════════════════════════════════════ */
.projects-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.project-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 28px;
  backdrop-filter: blur(12px);
  transition: transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 400ms var(--ease), border-color 300ms;
  position: relative; overflow: hidden;
}
.project-card::after {
  content: ''; position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: var(--gradient-hero); opacity: 0;
  transition: opacity 400ms; border-radius: var(--r);
  pointer-events: none;
}
.project-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 20px 50px rgba(245,158,11,0.15);
  border-color: rgba(245,158,11,0.2);
}
.project-card:hover::after { opacity: 0.03; }
.project-card h3 {
  font-family: var(--font-head); font-size: 1.15rem; font-weight: 700;
  color: var(--text); margin-bottom: 10px;
  position: relative; z-index: 1;
}
.project-card p {
  font-size: 0.88rem; color: var(--text-secondary);
  line-height: 1.7; margin-bottom: 16px;
  position: relative; z-index: 1;
}
.project-tags {
  display: flex; flex-wrap: wrap; gap: 6px;
  position: relative; z-index: 1;
}
.project-tag {
  padding: 4px 12px; border-radius: 100px;
  background: rgba(245,158,11,0.08);
  border: 1px solid rgba(245,158,11,0.12);
  font-size: 0.7rem; color: var(--amber); font-weight: 500;
  letter-spacing: 0.02em;
}
.project-tag:nth-child(3n+2) {
  background: rgba(239,68,68,0.08);
  border-color: rgba(239,68,68,0.12);
  color: var(--red);
}
.project-tag:nth-child(3n+0) {
  background: rgba(139,92,246,0.08);
  border-color: rgba(139,92,246,0.12);
  color: var(--violet);
}

/* ══════════════════════════════════════════════════════
   4. SKILLS
   ══════════════════════════════════════════════════════ */
.skills-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 28px;
}
.skill-group {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 28px;
  backdrop-filter: blur(12px);
}
.skill-group h4 {
  font-family: var(--font-head); font-size: 0.78rem; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--red); margin-bottom: 16px;
}
.skill-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.skill-pill {
  padding: 6px 16px; border-radius: 100px;
  background: rgba(245,245,244,0.04);
  border: 1px solid rgba(245,245,244,0.08);
  font-size: 0.8rem; color: var(--text-secondary); font-weight: 500;
  transition: all 300ms var(--ease);
}
.skill-pill:hover {
  background: rgba(245,158,11,0.1);
  border-color: var(--amber);
  color: var(--amber);
  transform: translateY(-2px);
}

/* ══════════════════════════════════════════════════════
   5. EXPERIENCE
   ══════════════════════════════════════════════════════ */
.timeline {
  position: relative;
  padding-left: 40px;
}
.timeline::before {
  content: ''; position: absolute; top: 0; bottom: 0; left: 15px;
  width: 2px;
  background: linear-gradient(180deg, var(--amber), var(--red), var(--violet));
}
.tl-item {
  position: relative;
  padding-bottom: 40px;
}
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before {
  content: ''; position: absolute; left: -33px; top: 8px;
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--bg); border: 3px solid var(--amber);
  z-index: 1;
  box-shadow: 0 0 12px rgba(245,158,11,0.4);
}
.tl-item:nth-child(2n)::before { border-color: var(--red); box-shadow: 0 0 12px rgba(239,68,68,0.4); }
.tl-item:nth-child(3n)::before { border-color: var(--violet); box-shadow: 0 0 12px rgba(139,92,246,0.4); }
.tl-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 24px 28px;
  backdrop-filter: blur(12px);
  transition: transform 300ms var(--ease), box-shadow 300ms var(--ease);
}
.tl-card:hover { transform: translateX(6px); box-shadow: 0 8px 30px rgba(245,158,11,0.1); }
.tl-card h3 {
  font-family: var(--font-head); font-size: 1.05rem; font-weight: 700;
  color: var(--text); margin-bottom: 4px;
}
.tl-company {
  font-size: 0.9rem; color: var(--amber); font-weight: 600; margin-bottom: 4px;
}
.tl-date {
  font-size: 0.75rem; color: var(--text-muted); font-weight: 500;
  letter-spacing: 0.04em; margin-bottom: 10px;
}
.tl-card > p {
  font-size: 0.85rem; color: var(--text-secondary); line-height: 1.7;
}
.tl-highlights { display: flex; flex-direction: column; gap: 6px; }
.tl-highlight {
  font-size: 0.84rem; color: var(--text-secondary); line-height: 1.6;
  padding-left: 16px; position: relative;
}
.tl-highlight::before {
  content: ''; position: absolute; left: 0; top: 9px;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--amber); opacity: 0.7;
}

/* ══════════════════════════════════════════════════════
   6. EDUCATION
   ══════════════════════════════════════════════════════ */
.edu-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}
.edu-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 24px 28px;
  backdrop-filter: blur(12px);
  transition: transform 300ms var(--ease);
}
.edu-card:hover { transform: translateY(-4px); }
.edu-year {
  font-family: var(--font-head); font-size: 0.78rem;
  color: var(--violet); font-weight: 700;
  letter-spacing: 0.04em; margin-bottom: 8px;
}
.edu-card h3 {
  font-family: var(--font-head); font-size: 1rem; font-weight: 700;
  color: var(--text); margin-bottom: 4px;
}
.edu-institution {
  font-size: 0.85rem; color: var(--text-secondary); font-weight: 500;
}
.edu-desc {
  font-size: 0.8rem; color: var(--text-muted); margin-top: 8px; line-height: 1.6;
}

/* ══════════════════════════════════════════════════════
   7. ENDORSEMENTS
   ══════════════════════════════════════════════════════ */
.endorsement-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 24px;
}
.endorsement-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 28px;
  backdrop-filter: blur(12px);
  position: relative;
  transition: transform 300ms var(--ease);
}
.endorsement-card:hover { transform: translateY(-4px); }
.endorsement-mark {
  font-family: var(--font-head); font-size: 3.5rem;
  line-height: 1; margin-bottom: 8px;
  background: var(--gradient-hero); background-size: 200% 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 4s ease infinite;
}
.endorsement-text {
  font-size: 0.9rem; color: var(--text-secondary);
  line-height: 1.8; font-style: italic; margin-bottom: 20px;
}
.endorsement-author {
  border-top: 1px solid rgba(245,245,244,0.06); padding-top: 14px;
}
.endorsement-name {
  font-family: var(--font-head); font-size: 0.85rem;
  font-weight: 700; color: var(--text);
}
.endorsement-role {
  font-size: 0.75rem; color: var(--text-muted);
}

/* ══════════════════════════════════════════════════════
   8. CERTIFICATIONS
   ══════════════════════════════════════════════════════ */
.certs-strip {
  display: flex; justify-content: center; flex-wrap: wrap; gap: 32px;
}
.cert-badge { text-align: center; min-width: 100px; }
.cert-name {
  font-family: var(--font-head); font-size: 1.1rem;
  font-weight: 800; color: var(--red); line-height: 1.2;
}
.cert-issuer {
  font-size: 0.68rem; color: var(--text-muted);
  letter-spacing: 0.04em; margin-top: 4px; font-weight: 500;
}

/* ══════════════════════════════════════════════════════
   9. LANGUAGES
   ══════════════════════════════════════════════════════ */
.lang-list {
  display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;
}
.lang-chip {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 20px;
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 100px;
  backdrop-filter: blur(12px);
}
.lang-chip-name {
  font-size: 0.88rem; font-weight: 600; color: var(--text);
}
.lang-chip-level {
  font-size: 0.68rem; color: var(--text-muted);
  background: rgba(245,245,244,0.04);
  padding: 2px 10px; border-radius: 100px;
  font-weight: 600;
}

/* ══════════════════════════════════════════════════════
   10. CONTACT FOOTER
   ══════════════════════════════════════════════════════ */
.contact-section {
  background: linear-gradient(180deg, var(--bg) 0%, #050403 100%);
  border-top: 1px solid var(--border);
}
.contact-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1px; background: var(--border);
  border-radius: var(--r); overflow: hidden;
}
.contact-cell {
  background: rgba(12,10,9,0.9);
  padding: 32px 20px; text-align: center;
  transition: background 300ms;
}
.contact-cell:hover { background: rgba(245,158,11,0.06); }
.contact-cell svg {
  width: 22px; height: 22px; margin: 0 auto 12px; display: block;
}
.contact-cell:nth-child(3n+1) svg { color: var(--amber); }
.contact-cell:nth-child(3n+2) svg { color: var(--red); }
.contact-cell:nth-child(3n+0) svg { color: var(--violet); }
.contact-cell h4 {
  font-family: var(--font-head); font-size: 0.82rem;
  font-weight: 700; color: var(--text); margin-bottom: 4px;
}
.contact-cell p {
  font-size: 0.78rem; color: var(--text-secondary); word-break: break-all;
}

/* ═══ FOOTER ═══ */
.site-footer {
  padding: 32px 0; text-align: center;
  background: #050403; border-top: 1px solid var(--border);
}
.site-footer p { font-size: 0.72rem; color: var(--text-muted); }
.site-footer a {
  background: var(--gradient-hero); background-size: 200% 200%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientShift 4s ease infinite;
}

/* ══════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════ */
@media (max-width: 1024px) {
  .projects-grid { grid-template-columns: repeat(2, 1fr); }
  .endorsement-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 768px) {
  .nav { padding: 14px 20px; }
  .nav-links {
    display: none; position: absolute; top: 100%; left: 0; right: 0;
    flex-direction: column; background: rgba(12,10,9,0.98);
    backdrop-filter: blur(16px); border-bottom: 1px solid var(--border);
    padding: 12px 20px; gap: 0; z-index: 1000;
  }
  .nav-links.open { display: flex; }
  .nav-links a {
    display: block; padding: 14px 0;
    border-bottom: 1px solid rgba(245,245,244,0.04); font-size: 0.9rem;
  }
  .nav-links a:last-child { border-bottom: none; }
  .nav-toggle { display: block; }

  .hero { min-height: auto; padding: 100px 20px 60px; }
  .hero-name { font-size: clamp(2.4rem, 10vw, 4rem); }
  .section { padding: 60px 0; }
  .container { padding: 0 20px; }
  .projects-grid { grid-template-columns: 1fr; }
  .skills-grid { grid-template-columns: 1fr; }
  .metrics-grid { grid-template-columns: repeat(2, 1fr); }
  .endorsement-grid { grid-template-columns: 1fr; }
  .edu-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }

  .timeline { padding-left: 32px; }
  .timeline::before { left: 11px; }
  .tl-item::before { left: -29px; width: 12px; height: 12px; }
  .tl-card { padding: 18px 20px; }

  .orb-amber { width: 200px; height: 200px; }
  .orb-red { width: 180px; height: 180px; }
  .orb-violet { width: 150px; height: 150px; }
}

@media (max-width: 480px) {
  .hero-name { font-size: 2.2rem; }
  .metrics-grid { grid-template-columns: 1fr; }
  .hero-actions { flex-direction: column; align-items: center; }
  .btn { width: 100%; justify-content: center; }
  .certs-strip { gap: 20px; }
}

/* ══════════════════════════════════════════════════════
   PRINT
   ══════════════════════════════════════════════════════ */
@media print {
  @page { margin: 0.5in; size: A4; }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  html, body { background: #fff !important; color: #111 !important; font-size: 10pt; }

  .nav, .orb, .no-print, body::before { display: none !important; }
  .hero { min-height: auto !important; padding: 20px 0 !important; }
  .hero-name {
    font-size: 22pt !important;
    -webkit-text-fill-color: #111 !important;
    color: #111 !important;
  }
  .hero-subtitle, .hero-title { color: #333 !important; }
  .hero-location { color: #666 !important; }
  .section { padding: 14px 0 !important; }
  .section-title {
    font-size: 13pt !important; margin-bottom: 10px !important;
    -webkit-text-fill-color: #111 !important;
  }
  .section-title em { -webkit-text-fill-color: #333 !important; animation: none !important; }
  .section-label { color: #333 !important; }
  .container { padding: 0 !important; }

  .metric-card, .project-card, .skill-group, .tl-card, .edu-card, .endorsement-card, .lang-chip {
    background: #fff !important; border-color: #ddd !important;
    backdrop-filter: none !important; box-shadow: none !important;
  }
  .metric-val { color: #111 !important; }
  .metric-label, .project-tag, .skill-pill { color: #333 !important; }
  .project-card h3, .tl-card h3, .edu-card h3 { color: #111 !important; }
  .project-card p, .tl-card p, .endorsement-text { color: #333 !important; }
  .tl-company { color: #333 !important; }
  .tl-date, .edu-year, .endorsement-role { color: #666 !important; }

  .projects-grid { grid-template-columns: 1fr 1fr !important; gap: 10px !important; }
  .project-card, .tl-item, .endorsement-card, .edu-card, .metric-card {
    page-break-inside: avoid !important; break-inside: avoid !important;
  }
  .project-card { padding: 10px 14px !important; }
  .tl-card { padding: 8px 12px !important; }
  .edu-card { padding: 8px 12px !important; }
  .endorsement-card { padding: 10px 14px !important; }

  .timeline::before { background: #ccc !important; }
  .tl-item::before { border-color: #999 !important; box-shadow: none !important; }

  .contact-section { background: #f5f5f5 !important; }
  .contact-cell { background: #fff !important; }
  .contact-cell svg { color: #333 !important; }
  .contact-cell h4 { color: #111 !important; }
  .contact-cell p { color: #333 !important; }

  .site-footer a { -webkit-text-fill-color: #333 !important; animation: none !important; }
  .btn { display: none !important; }
  .divider { background: #ddd !important; }
}

/* ═══ RTL ═══ */
[dir="rtl"] .section-label { direction: rtl; }
[dir="rtl"] .timeline { padding-left: 0; padding-right: 40px; }
[dir="rtl"] .timeline::before { left: auto; right: 15px; }
[dir="rtl"] .tl-item::before { left: auto; right: -33px; }
[dir="rtl"] .tl-card:hover { transform: translateX(-6px); }
[dir="rtl"] .tl-highlight { padding-left: 0; padding-right: 16px; }
[dir="rtl"] .tl-highlight::before { left: auto; right: 0; }
[dir="rtl"] .hero-location { direction: rtl; }
[dir="rtl"] .nav-links { direction: ltr; }
@media (max-width: 768px) {
  [dir="rtl"] .timeline { padding-right: 32px; }
  [dir="rtl"] .timeline::before { right: 11px; }
  [dir="rtl"] .tl-item::before { right: -29px; }
}
</style>
{{#if customization}}
<style>
{{#if customization.primaryColor}}
:root { --amber: {{customization.primaryColor}}; }
{{/if}}
{{#if customization.accentColor}}
:root { --red: {{customization.accentColor}}; }
{{/if}}
{{#if customization.bgColor}}
:root { --bg: {{customization.bgColor}}; }
{{/if}}
{{#if customization.fontFamily}}
:root { --font-head: '{{customization.fontFamily}}', sans-serif; }
{{/if}}
{{#if customization.bodyFont}}
:root { --font-body: '{{customization.bodyFont}}', sans-serif; }
{{/if}}
</style>
{{/if}}
</head>
<body>

<!-- Floating orbs -->
<div class="orb orb-amber"></div>
<div class="orb orb-red"></div>
<div class="orb orb-violet"></div>

<!-- ═══ NAV ═══ -->
<nav class="nav" id="nav">
  <a href="#" class="nav-brand">{{basics.fullName}}</a>
  <div class="nav-links" id="navLinks">
    {{#if projects}}<a href="#content">Content</a>{{/if}}
    {{#if experience}}<a href="#experience">Experience</a>{{/if}}
    {{#if skills}}<a href="#skills">Skills</a>{{/if}}
    <a href="#contact" class="nav-cta">Contact</a>
  </div>
  <button class="nav-toggle" id="navToggle" aria-label="Menu">
    <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
  </button>
</nav>

<!-- ══════════════════════════════════════════════════════
     1. HERO
     ══════════════════════════════════════════════════════ -->
<section class="hero" id="hero">
  <div class="hero-content">
    {{#if basics.subtitle}}
    <p class="hero-subtitle">{{basics.subtitle}}</p>
    {{else}}
    <p class="hero-subtitle">{{basics.title}}</p>
    {{/if}}

    <h1 class="hero-name">{{basics.fullName}}</h1>

    {{#if basics.subtitle}}
    <p class="hero-title">{{basics.title}}</p>
    {{/if}}

    {{#if basics.valueProposition}}
    <p class="hero-title">{{basics.valueProposition}}</p>
    {{/if}}

    {{#if basics.location}}
    <div class="hero-location">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
      {{basics.location}}{{#if basics.nationality}} &middot; {{basics.nationality}}{{/if}}
    </div>
    {{/if}}

    <div class="hero-actions">
      {{#if basics.email}}
      <a href="mailto:{{basics.email}}" class="btn btn-primary">Get in Touch</a>
      {{/if}}
      {{#if projects}}
      <a href="#content" class="btn btn-ghost">View Content</a>
      {{/if}}
      {{#if basics.website}}
      <a href="{{basics.website}}" target="_blank" rel="noopener" class="btn btn-ghost">Website</a>
      {{/if}}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════════════
     2. SOCIAL STATS / METRICS
     ══════════════════════════════════════════════════════ -->
{{#if metrics}}
{{#unless (isHidden "social-stats")}}
<section class="section" id="social-stats">
  <div class="container">
    <div class="section-label">Audience</div>
    <div class="section-title">The <em>reach</em></div>
    <div class="metrics-grid">
      {{#each metrics}}
      <div class="metric-card">
        <div class="metric-val">{{this.value}}</div>
        <div class="metric-label">{{this.label}}</div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     3. CONTENT SHOWCASE / PROJECTS
     ══════════════════════════════════════════════════════ -->
{{#if projects}}
{{#unless (isHidden "content-showcase")}}
<section class="section" id="content">
  <div class="container">
    <div class="section-label">Featured Work</div>
    <div class="section-title">Content <em>showcase</em></div>
    <div class="projects-grid">
      {{#each projects}}
      <div class="project-card">
        <h3>{{this.title}}</h3>
        {{#if this.description}}<p>{{this.description}}</p>{{/if}}
        {{#if this.technologies}}
        <div class="project-tags">
          {{#each this.technologies}}<span class="project-tag">{{this}}</span>{{/each}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     4. SKILLS
     ══════════════════════════════════════════════════════ -->
{{#if skills}}
{{#unless (isHidden "skills")}}
<section class="section" id="skills">
  <div class="container">
    <div class="section-label">Expertise</div>
    <div class="section-title">Skills & <em>platforms</em></div>
    <div class="skills-grid">
      {{#each skills}}
      <div class="skill-group">
        <h4>{{this.category}}</h4>
        <div class="skill-pills">
          {{#each this.items}}<span class="skill-pill">{{this}}</span>{{/each}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     5. EXPERIENCE
     ══════════════════════════════════════════════════════ -->
{{#if experience}}
{{#unless (isHidden "experience")}}
<section class="section" id="experience">
  <div class="container">
    <div class="section-label">Journey</div>
    <div class="section-title">Where I've <em>built</em></div>
    <div class="timeline">
      {{#each experience}}
      <div class="tl-item">
        <div class="tl-card">
          <h3>{{this.title}}</h3>
          <div class="tl-company">{{this.company}}</div>
          <div class="tl-date">{{this.startDate}} &mdash; {{#if this.endDate}}{{this.endDate}}{{else}}Present{{/if}}</div>
          {{#if this.highlights}}
          <div class="tl-highlights">
            {{#each this.highlights}}
            <div class="tl-highlight">{{this}}</div>
            {{/each}}
          </div>
          {{else if this.description}}
          <p>{{this.description}}</p>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     6. EDUCATION
     ══════════════════════════════════════════════════════ -->
{{#if education}}
{{#unless (isHidden "education")}}
<section class="section" id="education">
  <div class="container">
    <div class="section-label">Background</div>
    <div class="section-title">Education & <em>learning</em></div>
    <div class="edu-grid">
      {{#each education}}
      <div class="edu-card">
        {{#if this.year}}<div class="edu-year">{{this.year}}</div>{{/if}}
        <h3>{{this.degree}}</h3>
        <p class="edu-institution">{{this.institution}}</p>
        {{#if this.description}}<p class="edu-desc">{{this.description}}</p>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     7. CERTIFICATIONS
     ══════════════════════════════════════════════════════ -->
{{#if certifications}}
{{#unless (isHidden "certifications")}}
<section class="section" id="certifications">
  <div class="container">
    <div class="section-label">Credentials</div>
    <div class="section-title">Certifications & <em>badges</em></div>
    <div class="certs-strip">
      {{#each certifications}}
      <div class="cert-badge">
        <div class="cert-name">{{this.name}}</div>
        {{#if this.issuer}}<div class="cert-issuer">{{this.issuer}}</div>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     8. ENDORSEMENTS
     ══════════════════════════════════════════════════════ -->
{{#if endorsements}}
{{#unless (isHidden "endorsements")}}
<section class="section" id="endorsements">
  <div class="container">
    <div class="section-label">Testimonials</div>
    <div class="section-title">What people <em>say</em></div>
    <div class="endorsement-grid">
      {{#each endorsements}}
      <div class="endorsement-card">
        <div class="endorsement-mark">&ldquo;</div>
        <p class="endorsement-text">{{this.quote}}</p>
        <div class="endorsement-author">
          <div class="endorsement-name">{{this.name}}</div>
          <div class="endorsement-role">{{this.title}}{{#if this.company}}, {{this.company}}{{/if}}</div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     9. LANGUAGES
     ══════════════════════════════════════════════════════ -->
{{#if languages}}
{{#unless (isHidden "languages")}}
<section class="section" id="languages">
  <div class="container">
    <div class="section-label" style="text-align:center;">Languages</div>
    <div class="section-title" style="text-align:center;">I <em>speak</em></div>
    <div class="lang-list">
      {{#each languages}}
      <div class="lang-chip">
        <span class="lang-chip-name">{{this.name}}</span>
        <span class="lang-chip-level">{{this.level}}</span>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="divider"></div>
{{/unless}}
{{/if}}

<!-- ══════════════════════════════════════════════════════
     10. CONTACT
     ══════════════════════════════════════════════════════ -->
{{#unless (isHidden "contact")}}
<section class="section contact-section" id="contact">
  <div class="container">
    <div class="section-label">Let's Connect</div>
    <div class="section-title">Ready to <em>collaborate</em>?</div>
    <div class="contact-grid">
      {{#if basics.email}}
      <a href="mailto:{{basics.email}}" class="contact-cell">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
        <h4>Email</h4>
        <p>{{basics.email}}</p>
      </a>
      {{/if}}
      {{#if basics.phone}}
      <a href="tel:{{basics.phone}}" class="contact-cell">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
        <h4>Phone</h4>
        <p>{{basics.phone}}</p>
      </a>
      {{/if}}
      {{#if basics.linkedin}}
      <a href="{{basics.linkedin}}" class="contact-cell" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        <h4>LinkedIn</h4>
        <p>Profile</p>
      </a>
      {{/if}}
      {{#if basics.github}}
      <a href="{{basics.github}}" class="contact-cell" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        <h4>GitHub</h4>
        <p>Profile</p>
      </a>
      {{/if}}
      {{#if basics.website}}
      <a href="{{basics.website}}" class="contact-cell" target="_blank" rel="noopener">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"/></svg>
        <h4>Website</h4>
        <p>Visit</p>
      </a>
      {{/if}}
      {{#if basics.location}}
      <div class="contact-cell">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
        <h4>Location</h4>
        <p>{{basics.location}}</p>
      </div>
      {{/if}}
    </div>
  </div>
</section>
{{/unless}}

<!-- ═══ FOOTER ═══ -->
<footer class="site-footer">
  <div class="container">
    <p>&copy; {{basics.fullName}} &middot; <a href="https://portfolio-trimind.com" target="_blank" rel="noopener">Built with TriMind</a></p>
  </div>
</footer>

<script>
/* Mobile nav toggle */
var navToggle = document.getElementById('navToggle');
var navLinks = document.getElementById('navLinks');
if (navToggle && navLinks) {
  navToggle.addEventListener('click', function() { navLinks.classList.toggle('open'); });
  navLinks.querySelectorAll('a').forEach(function(a) {
    a.addEventListener('click', function() { navLinks.classList.remove('open'); });
  });
}

/* Smooth scroll */
document.querySelectorAll('a[href^="#"]').forEach(function(a) {
  a.addEventListener('click', function(e) {
    e.preventDefault();
    var t = document.querySelector(a.getAttribute('href'));
    if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

/* Reduced motion */
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll('.orb').forEach(function(el) { el.style.animation = 'none'; });
  document.querySelectorAll('.hero-name, .nav-brand, .section-title em, .endorsement-mark, .site-footer a').forEach(function(el) {
    el.style.animation = 'none';
  });
}
</script>
</body>
</html>
