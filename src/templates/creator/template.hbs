<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="#F1EDDC">
<meta property="og:title" content="{{basics.fullName}} — {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{/if}}">
<meta property="og:type" content="profile">
{{#if basics.photoUrl}}<meta property="og:image" content="{{safeUrl basics.photoUrl}}">{{/if}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ════════════════════════════════════════════════════════════
   CREATOR template · "Social Pulse" light-eggshell identity
   Data-driven portfolio. Palette built for creators / social
   brands: Eggshell base · Dartmouth emerald · Sunshade · Valentine
   · Bright Ube. Mirrors the approved /demo/creator portfolio view.
   ════════════════════════════════════════════════════════════ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  /* customizable: bg / primary(emerald) / accent(coral) / fonts */
  --bg:{{safeColor customization.bgColor "#F1EDDC"}};
  --emerald:{{safeColor customization.primaryColor "#097251"}};
  --valentine:{{safeColor customization.accentColor "#EF453F"}};
  --font-head:{{#if customization.fontFamily}}'{{customization.fontFamily}}',{{/if}}'Plus Jakarta Sans',system-ui,sans-serif;
  --font-body:{{#if customization.bodyFont}}'{{customization.bodyFont}}',{{/if}}'Inter',system-ui,sans-serif;
  /* fixed Social Pulse supporting hues */
  --eggshell:#F1EDDC; --sunshade:#F69C40; --ube:#DD8CF1; --ink-d:oklch(24% 0.035 60);
  --valentine-deep:oklch(57% 0.21 26);
  --bg-2:oklch(91.5% 0.028 90); --surface:oklch(97.5% 0.014 95); --surface-2:oklch(99% 0.008 96);
  --line:oklch(45% 0.04 80 / .22); --line-soft:oklch(45% 0.035 80 / .12);
  --text:oklch(29% 0.028 72); --text-2:oklch(44% 0.026 70); --text-3:oklch(56% 0.022 68);
  --accent:var(--emerald); --ember:var(--valentine); --grape:var(--ube); --gold:oklch(76% 0.14 72);
  --r:18px; --r-sm:13px; --ease:cubic-bezier(.22,1,.36,1);
  --shadow:0 22px 50px -30px oklch(45% 0.06 60 / .28);
}
html{scroll-behavior:smooth}
body{font-family:var(--font-body);background:var(--bg);color:var(--text);line-height:1.6;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;min-height:100dvh;position:relative}
body::before{content:"";position:fixed;inset:0;z-index:0;pointer-events:none;
  background:
    radial-gradient(58vw 58vw at 14% 6%,oklch(72% 0.15 62 / .16),transparent 60%),
    radial-gradient(52vw 52vw at 90% 92%,oklch(72% 0.16 320 / .13),transparent 62%)}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
.ic{width:1em;height:1em;stroke:currentColor;fill:none;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none}
.wrap{position:relative;z-index:2;max-width:1080px;margin:0 auto;padding:0 22px}
.eyebrow{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;letter-spacing:.16em;
  text-transform:uppercase;color:var(--accent);font-weight:700}
.sect{padding:clamp(48px,8vw,84px) 0}
.sect-head{margin-bottom:26px}
.sect-head h2{font-family:var(--font-head);font-weight:800;font-size:clamp(24px,4.6vw,34px);letter-spacing:-.025em}
.sect-head p{color:var(--text-3);font-size:14.5px;margin-top:6px}

/* ── buttons ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:12px 21px;border-radius:13px;
  font-weight:600;font-size:14.5px;letter-spacing:-.01em;transition:transform .2s var(--ease),background .2s,box-shadow .25s,border-color .2s,filter .2s}
.btn .ic{font-size:17px}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--accent);color:var(--eggshell);font-weight:700;box-shadow:0 14px 32px -18px oklch(49% 0.11 163 / .65)}
.btn-ghost{background:transparent;color:var(--text);border:1px solid var(--line)}
.btn-lg{padding:15px 26px;font-size:16px;border-radius:15px}
@media(hover:hover){
  .btn-primary:hover{filter:brightness(1.08);transform:translateY(-1px)}
  .btn-ghost:hover{background:oklch(30% 0.02 70 / .06);border-color:oklch(45% 0.04 80 / .42)}
}

/* ── nav ── */
.nav{position:sticky;top:0;z-index:40;backdrop-filter:saturate(140%) blur(10px);
  background:linear-gradient(180deg,var(--bg),oklch(94% 0.022 92 / .82));border-bottom:1px solid var(--line-soft)}
.nav-in{display:flex;align-items:center;gap:14px;padding:13px 22px;max-width:1080px;margin:0 auto;position:relative}
.brand{display:flex;align-items:center;gap:11px;font-family:var(--font-head);font-weight:700;min-width:0;flex:0 1 auto}
.mono{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;background:var(--valentine-deep);
  color:var(--eggshell);font-weight:800;font-size:13px;letter-spacing:-.04em;flex:none}
.brand .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.nav-links{display:flex;align-items:center;gap:6px;margin-inline-start:auto}
.nav-links a{font-size:14px;font-weight:600;color:var(--text-2);padding:8px 12px;border-radius:9px;transition:color .2s,background .2s}
@media(hover:hover){.nav-links a:hover{color:var(--text);background:oklch(30% 0.02 70 / .05)}}
.nav-cta{flex:none}
.nav-toggle{display:none;width:42px;height:42px;border-radius:11px;border:1px solid var(--line);background:transparent;
  color:var(--text);place-items:center;margin-inline-start:auto;flex:none}
.nav-toggle .ic{font-size:21px}

/* ── hero ── */
.hero{padding:clamp(56px,11vw,104px) 0 clamp(36px,6vw,60px);max-width:780px}
.hero h1{font-family:var(--font-head);font-weight:800;line-height:.97;letter-spacing:-.035em;
  font-size:clamp(46px,11vw,104px);color:var(--text);margin-top:20px}
.hero .role{font-family:var(--font-head);font-weight:600;font-size:clamp(17px,3.4vw,24px);color:var(--text-2);margin-top:15px;letter-spacing:-.01em}
.hero .tag{max-width:56ch;color:var(--text-2);margin:18px 0 0;font-size:clamp(15px,2.4vw,17.5px)}
.hero .meta{display:flex;flex-wrap:wrap;gap:16px;margin-top:18px;color:var(--text-3);font-size:13.5px}
.hero .meta span{display:inline-flex;align-items:center;gap:7px}
.hero .meta .ic{font-size:15px;color:var(--accent)}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.hero-photo{width:96px;height:96px;border-radius:20px;object-fit:cover;border:1px solid var(--line);box-shadow:var(--shadow);margin-bottom:4px}

/* ── stats ── */
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line-soft);
  border:1px solid var(--line-soft);border-radius:var(--r);overflow:hidden}
@media(min-width:640px){.stats{grid-template-columns:repeat(4,1fr)}}
.stat{background:var(--surface);padding:24px 18px}
.stat b{display:block;font-family:var(--font-head);font-weight:800;font-size:clamp(26px,5vw,38px);
  font-variant-numeric:tabular-nums;letter-spacing:-.02em;color:var(--text)}
.stat span{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-3);margin-top:5px;display:block}

/* ── work gallery ── */
.gal{display:grid;grid-template-columns:1fr;gap:16px}
@media(min-width:600px){.gal{grid-template-columns:repeat(2,1fr)}}
@media(min-width:900px){.gal.three{grid-template-columns:repeat(3,1fr)}}
.gal-card{position:relative;border-radius:var(--r);overflow:hidden;border:1px solid var(--line-soft);
  min-height:260px;transition:transform .3s var(--ease);display:block}
@media(hover:hover){.gal-card:hover{transform:translateY(-4px)}}
.cover{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(10px,1.6vw,14px)}
.cover-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:2}
.cover .ph{position:absolute;inset:0;z-index:1;display:grid;place-items:center;
  font-family:var(--font-head);font-weight:800;font-size:54px;color:oklch(100% 0 0 / .85)}
.cover::after{content:"";position:absolute;inset:0;z-index:3;
  background:linear-gradient(to top,oklch(17% 0.04 40 / .9) 4%,oklch(17% 0.04 40 / .4) 44%,oklch(17% 0.04 40 / .06) 74%,transparent)}
.t0{background:linear-gradient(150deg,oklch(60% 0.2 26),oklch(40% 0.12 22))}
.t1{background:linear-gradient(150deg,oklch(66% 0.16 60),oklch(46% 0.11 50))}
.t2{background:linear-gradient(150deg,oklch(64% 0.17 320),oklch(44% 0.13 312))}
.t3{background:linear-gradient(150deg,oklch(56% 0.12 165),oklch(38% 0.08 165))}
.cover-cat{position:relative;z-index:4;align-self:flex-start;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  font-weight:700;color:var(--eggshell);background:var(--accent);padding:4px 9px;border-radius:99px;margin-bottom:auto}
.cover-title{position:relative;z-index:4;font-family:var(--font-head);font-weight:700;line-height:1.14;
  font-size:clamp(15px,2.6vw,19px);letter-spacing:-.01em;color:var(--eggshell)}
.cover-metric{position:relative;z-index:4;font-size:clamp(11px,2vw,13px);color:oklch(94% 0.02 92);margin-top:3px;font-weight:500}

/* ── badges (awards / milestones) ── */
.badges{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:560px){.badges{grid-template-columns:repeat(2,1fr)}}
.badge{position:relative;border-radius:var(--r);border:1px solid var(--line-soft);padding:20px;min-height:120px;
  display:flex;flex-direction:column;justify-content:flex-end;gap:6px}
.badge.b0{background:oklch(91% 0.06 75)} .badge.b1{background:oklch(91% 0.05 165)}
.badge.b2{background:oklch(90% 0.065 28)} .badge.b3{background:oklch(91% 0.06 320)}
.badge-ic{position:absolute;top:18px;inset-inline-start:18px;width:40px;height:40px;border-radius:12px;
  display:grid;place-items:center;color:var(--eggshell)}
.badge.b0 .badge-ic{background:var(--sunshade);color:var(--ink-d)} .badge.b1 .badge-ic{background:var(--emerald)}
.badge.b2 .badge-ic{background:var(--valentine)} .badge.b3 .badge-ic{background:var(--ube);color:var(--ink-d)}
.badge-ic .ic{font-size:21px}
.badge b{font-family:var(--font-head);font-weight:700;font-size:16px;color:var(--ink-d);letter-spacing:-.01em}
.badge span{font-size:13px;color:oklch(30% 0.03 60 / .8)}

/* ── marquee (brands / clients) ── */
.marquee{overflow:hidden;border-block:1px solid var(--line-soft);padding:20px 0;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}
.marquee-track{display:flex;gap:48px;width:max-content;animation:slide 26s linear infinite;align-items:center}
@media(hover:hover){.marquee:hover .marquee-track{animation-play-state:paused}}
@keyframes slide{to{transform:translateX(-50%)}}
.brand-word{font-family:var(--font-head);font-weight:700;font-size:clamp(16px,3vw,21px);color:var(--text-3);white-space:nowrap}

/* ── skills ── */
.skill-group{margin-bottom:18px}
.skill-group h3{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:700;margin-bottom:11px}
.pills{display:flex;flex-wrap:wrap;gap:10px}
.pill{border:1px solid var(--line-soft);background:var(--surface);border-radius:99px;padding:9px 16px;font-size:13.5px;font-weight:500}

/* ── experience timeline ── */
.tl{border-inline-start:2px solid var(--line);margin-inline-start:6px;padding-inline-start:24px;display:flex;flex-direction:column;gap:26px}
.tl-item{position:relative}
.tl-item::before{content:"";position:absolute;inset-inline-start:-31px;top:5px;width:11px;height:11px;border-radius:99px;background:var(--accent);box-shadow:0 0 0 4px var(--bg)}
.tl-item h3{font-family:var(--font-head);font-weight:700;font-size:17px}
.tl-item .org{color:var(--accent);font-weight:600;font-size:14.5px;margin-top:2px}
.tl-item .when{color:var(--text-3);font-size:12.5px;letter-spacing:.02em;margin-top:2px}
.tl-item p{color:var(--text-2);font-size:14.5px;margin-top:8px;max-width:62ch}
.tl-item ul{margin:8px 0 0;padding-inline-start:18px;color:var(--text-2);font-size:14px}
.tl-item li{margin-top:4px}

/* ── education / certs / testimonials ── */
.cards2{display:grid;grid-template-columns:1fr;gap:14px}
@media(min-width:640px){.cards2{grid-template-columns:repeat(2,1fr)}}
.card{background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--r);padding:20px 22px}
.card h3{font-family:var(--font-head);font-weight:700;font-size:16px}
.card .org{color:var(--accent);font-weight:600;font-size:14px;margin-top:2px}
.card .when{color:var(--text-3);font-size:12.5px;margin-top:2px}
.card p{color:var(--text-2);font-size:14px;margin-top:8px}
.quote{background:var(--surface);border:1px solid var(--line-soft);border-radius:var(--r);padding:22px}
.quote p{font-size:15.5px;color:var(--text);line-height:1.6}
.quote .who{margin-top:13px;font-size:13px;color:var(--text-3)}
.quote .who b{color:var(--text);font-weight:700;font-family:var(--font-head)}
.langs{display:flex;flex-wrap:wrap;gap:12px}
.lang{display:inline-flex;align-items:baseline;gap:8px;border:1px solid var(--line-soft);background:var(--surface);border-radius:12px;padding:10px 15px}
.lang b{font-family:var(--font-head);font-weight:700;font-size:14.5px}
.lang span{font-size:12.5px;color:var(--text-3)}

/* ── contact ── */
.connect{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}
@media(min-width:560px){.connect{grid-template-columns:repeat(4,1fr)}}
.node{aspect-ratio:1;border-radius:var(--r);border:1px solid var(--line-soft);background:var(--surface);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:9px;color:var(--text-2);
  transition:transform .2s var(--ease),border-color .3s,color .3s}
.node .ic{font-size:27px}
.node .nlbl{font-size:12px;font-weight:600}
@media(hover:hover){.node:hover{transform:translateY(-3px);color:var(--accent);border-color:var(--line)}}

/* ── footer ── */
.site-footer{text-align:center;padding:30px 22px;border-top:1px solid var(--line-soft);color:var(--text-3);font-size:12.5px}
.site-footer a{color:var(--accent);font-weight:700}

@media(max-width:760px){
  .nav-links{display:none;position:absolute;top:100%;inset-inline:0;flex-direction:column;align-items:stretch;gap:0;
    background:var(--bg);border-bottom:1px solid var(--line);padding:8px 14px 14px}
  .nav-links.open{display:flex}
  .nav-links a{padding:13px 10px;border-radius:10px}
  .nav-cta{display:none}
  .nav-toggle{display:grid}
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:.001ms!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
}

@media print{
  @page{margin:.5in;size:A4}
  body{background:#fff;color:#1a1a1a}
  body::before,.nav,.nav-toggle,.hero-cta,.marquee,.connect,.no-print{display:none!important}
  .cover::after{background:linear-gradient(to top,rgba(0,0,0,.7),transparent)}
  .gal-card,.badge,.card,.tl-item{break-inside:avoid;page-break-inside:avoid}
  .sect{padding:18px 0}
  a{color:inherit}
}
</style>
{{#if customization}}
<style>
{{#if customization.primaryColor}}:root{ --emerald:{{customization.primaryColor}}; --accent:{{customization.primaryColor}}; }{{/if}}
{{#if customization.accentColor}}:root{ --valentine:{{customization.accentColor}}; --ember:{{customization.accentColor}}; }{{/if}}
{{#if customization.bgColor}}:root{ --bg:{{customization.bgColor}}; }{{/if}}
{{#if customization.fontFamily}}:root{ --font-head:'{{customization.fontFamily}}',sans-serif; }{{/if}}
{{#if customization.bodyFont}}:root{ --font-body:'{{customization.bodyFont}}',sans-serif; }{{/if}}
</style>
{{/if}}
</head>
<body>

<!-- nav -->
<header class="nav">
  <div class="nav-in">
    <a class="brand" href="#top"><span class="mono">{{initials basics.fullName}}</span><span class="nm">{{basics.fullName}}</span></a>
    <nav class="nav-links" id="navLinks">
      {{#if projects}}<a href="#work">Work</a>{{/if}}
      {{#if certifications}}<a href="#awards">Awards</a>{{/if}}
      {{#if skills}}<a href="#skills">Skills</a>{{/if}}
      <a href="#contact">Contact</a>
    </nav>
    <a class="btn btn-primary nav-cta" href="mailto:{{basics.email}}">Get in touch</a>
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</header>

<main id="top">
<div class="wrap">

  <!-- hero -->
  <section class="hero">
    {{#if basics.photoUrl}}<img class="hero-photo" src="{{safeUrl basics.photoUrl}}" alt="{{basics.fullName}}">{{/if}}
    <span class="eyebrow">{{basics.title}}</span>
    <h1>{{basics.fullName}}</h1>
    {{#if basics.subtitle}}<p class="role">{{basics.subtitle}}</p>{{/if}}
    {{#if basics.valueProposition}}<p class="tag">{{basics.valueProposition}}</p>{{else if basics.bio}}<p class="tag">{{basics.bio}}</p>{{/if}}
    <div class="meta">
      {{#if basics.location}}<span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>{{basics.location}}</span>{{/if}}
      {{#if basics.email}}<span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg>{{basics.email}}</span>{{/if}}
    </div>
    <div class="hero-cta">
      {{#if basics.email}}<a class="btn btn-primary btn-lg" href="mailto:{{basics.email}}">Let's collaborate</a>{{/if}}
      {{#if basics.instagram}}<a class="btn btn-ghost btn-lg" href="{{safeUrl basics.instagram}}" target="_blank" rel="noopener">Instagram</a>{{else if basics.website}}<a class="btn btn-ghost btn-lg" href="{{safeUrl basics.website}}" target="_blank" rel="noopener">Website</a>{{/if}}
    </div>
  </section>

  <!-- stats -->
  {{#if metrics}}{{#unless (isHidden "social-stats")}}
  <section class="sect" id="stats" style="padding-top:0">
    <div class="stats">
      {{#each metrics}}<div class="stat"><b>{{this.value}}</b><span>{{this.label}}</span></div>{{/each}}
    </div>
  </section>
  {{/unless}}{{/if}}

  <!-- selected work -->
  {{#if projects}}{{#unless (isHidden "content-showcase")}}
  <section class="sect" id="work">
    <div class="sect-head"><h2>Selected work</h2><p>Films, series, campaigns and content.</p></div>
    <div class="gal{{#if projects.[2]}} three{{/if}}">
      {{#each projects}}
      <a class="gal-card{{#unless this.coverUrl}} {{cycle @index "t0" "t1" "t2" "t3"}}{{/unless}}"{{#if this.link}} href="{{safeUrl this.link}}" target="_blank" rel="noopener"{{/if}}>
        <div class="cover">
          {{#if this.coverUrl}}<img class="cover-img" src="{{safeUrl this.coverUrl}}" alt="{{this.title}}" loading="lazy" decoding="async">{{else}}<span class="ph">{{initials this.title}}</span>{{/if}}
          {{#if this.meta.type}}<span class="cover-cat">{{this.meta.type}}</span>{{else if this.technologies}}<span class="cover-cat">{{this.technologies.[0]}}</span>{{/if}}
          <span class="cover-title">{{this.title}}</span>
          {{#if this.metrics}}<span class="cover-metric">{{#with this.metrics.[0]}}{{this.value}} {{this.label}}{{/with}}</span>{{else if this.meta.year}}<span class="cover-metric">{{this.meta.year}}</span>{{/if}}
        </div>
      </a>
      {{/each}}
    </div>
  </section>
  {{/unless}}{{/if}}

  <!-- awards / milestones -->
  {{#if certifications}}{{#unless (isHidden "certifications")}}
  <section class="sect" id="awards">
    <div class="sect-head"><h2>Milestones &amp; awards</h2><p>What the work has earned.</p></div>
    <div class="badges">
      {{#each certifications}}
      <div class="badge {{cycle @index "b0" "b1" "b2" "b3"}}">
        <span class="badge-ic"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4h10v3a5 5 0 0 1-10 0Z"/><path d="M17 5h3v1a3 3 0 0 1-3 3M7 5H4v1a3 3 0 0 0 3 3"/><path d="M12 12v4m-3 4h6m-5 0 .5-4h3l.5 4"/></svg></span>
        <b>{{this.name}}</b>
        <span>{{this.issuer}}{{#if this.year}} · {{this.year}}{{/if}}</span>
      </div>
      {{/each}}
    </div>
  </section>
  {{/unless}}{{/if}}

</div>{{!-- /wrap --}}

  <!-- brands marquee (from testimonial companies, if any) -->
  {{#if endorsements}}
  <section class="sect" style="padding:0" aria-label="Worked with">
    <div class="marquee"><div class="marquee-track">
      {{#each endorsements}}{{#if this.company}}<span class="brand-word">{{this.company}}</span>{{/if}}{{/each}}
      {{#each endorsements}}{{#if this.company}}<span class="brand-word">{{this.company}}</span>{{/if}}{{/each}}
    </div></div>
  </section>
  {{/if}}

<div class="wrap">

  <!-- skills -->
  {{#if skills}}{{#unless (isHidden "skills")}}
  <section class="sect" id="skills">
    <div class="sect-head"><h2>Skills &amp; tools</h2></div>
    {{#each skills}}
    <div class="skill-group">
      <h3>{{this.category}}</h3>
      <div class="pills">{{#each this.items}}<span class="pill">{{this}}</span>{{/each}}</div>
    </div>
    {{/each}}
  </section>
  {{/unless}}{{/if}}

  <!-- experience -->
  {{#if experience}}{{#unless (isHidden "experience")}}
  <section class="sect" id="experience">
    <div class="sect-head"><h2>Experience</h2></div>
    <div class="tl">
      {{#each experience}}
      <div class="tl-item">
        <h3>{{this.title}}</h3>
        <div class="org">{{this.company}}</div>
        <div class="when">{{this.startDate}}{{#if this.endDate}} — {{this.endDate}}{{else}} — {{#if ../isRTL}}الآن{{else}}Present{{/if}}{{/if}}</div>
        {{#if this.description}}<p>{{this.description}}</p>{{/if}}
        {{#if this.highlights}}<ul>{{#each this.highlights}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/unless}}{{/if}}

  <!-- education -->
  {{#if education}}{{#unless (isHidden "education")}}
  <section class="sect" id="education">
    <div class="sect-head"><h2>Education</h2></div>
    <div class="cards2">
      {{#each education}}
      <div class="card">
        <h3>{{this.degree}}</h3>
        <div class="org">{{this.institution}}</div>
        {{#if this.year}}<div class="when">{{this.year}}</div>{{/if}}
        {{#if this.description}}<p>{{this.description}}</p>{{/if}}
      </div>
      {{/each}}
    </div>
  </section>
  {{/unless}}{{/if}}

  <!-- testimonials -->
  {{#if endorsements}}{{#unless (isHidden "endorsements")}}
  <section class="sect" id="endorsements">
    <div class="sect-head"><h2>What people say</h2></div>
    <div class="cards2">
      {{#each endorsements}}
      <div class="quote">
        <p>“{{this.quote}}”</p>
        <div class="who"><b>{{this.name}}</b>{{#if this.title}} · {{this.title}}{{/if}}{{#if this.company}}, {{this.company}}{{/if}}</div>
      </div>
      {{/each}}
    </div>
  </section>
  {{/unless}}{{/if}}

  <!-- languages -->
  {{#if languages}}{{#unless (isHidden "languages")}}
  <section class="sect" id="languages">
    <div class="sect-head"><h2>Languages</h2></div>
    <div class="langs">{{#each languages}}<span class="lang"><b>{{this.name}}</b>{{#if this.level}}<span>{{this.level}}</span>{{/if}}</span>{{/each}}</div>
  </section>
  {{/unless}}{{/if}}

  <!-- contact -->
  {{#unless (isHidden "contact")}}
  <section class="sect" id="contact">
    <div class="sect-head"><h2>Let's work together</h2><p>Open for brand collaborations, creative direction and content partnerships.</p></div>
    <div class="connect">
      {{#if basics.email}}<a class="node" href="mailto:{{basics.email}}"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/></svg><span class="nlbl">Email</span></a>{{/if}}
      {{#if basics.instagram}}<a class="node" href="{{safeUrl basics.instagram}}" target="_blank" rel="noopener"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"/></svg><span class="nlbl">Instagram</span></a>{{/if}}
      {{#if basics.website}}<a class="node" href="{{safeUrl basics.website}}" target="_blank" rel="noopener"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.7 3 2.7 15 0 18M12 3c-2.7 3-2.7 15 0 18"/></svg><span class="nlbl">Website</span></a>{{/if}}
      {{#if basics.linkedin}}<a class="node" href="{{safeUrl basics.linkedin}}" target="_blank" rel="noopener"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4"/></svg><span class="nlbl">LinkedIn</span></a>{{/if}}
      {{#if basics.github}}<a class="node" href="{{safeUrl basics.github}}" target="_blank" rel="noopener"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1.4-4-2-6-2m12 4v-3.5a3 3 0 0 0-.9-2.4c2.9-.3 6-1.4 6-6.4a4.7 4.7 0 0 0-1.3-3.3 4.4 4.4 0 0 0-.1-3.3s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C5.9 1.6 4.9 1.9 4.9 1.9a4.4 4.4 0 0 0-.1 3.3A4.7 4.7 0 0 0 3.5 8.5c0 5 3.1 6.1 6 6.4a3 3 0 0 0-.9 2.3V21"/></svg><span class="nlbl">GitHub</span></a>{{/if}}
      {{#if basics.phone}}<a class="node" href="tel:{{basics.phone}}"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z"/></svg><span class="nlbl">Phone</span></a>{{/if}}
    </div>
  </section>
  {{/unless}}

</div>{{!-- /wrap --}}
</main>

<footer class="site-footer">
  &copy; {{basics.fullName}} &middot; <a href="https://portfolio-trimind.com" target="_blank" rel="noopener">Built with TriMind</a>
</footer>

<script>
(function(){
  var t=document.getElementById('navToggle'),l=document.getElementById('navLinks');
  if(t&&l)t.addEventListener('click',function(){var o=l.classList.toggle('open');t.setAttribute('aria-expanded',o?'true':'false');});
  document.querySelectorAll('.nav-links a').forEach(function(a){a.addEventListener('click',function(){l&&l.classList.remove('open');});});
})();
</script>
</body>
</html>
