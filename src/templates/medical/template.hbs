<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="#0f2942">
<meta property="og:title" content="{{basics.fullName}} | {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}{{/if}}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ======================================================
   MEDICAL PORTFOLIO — Clinically Precise, Trust-First
   No hover transforms. No animations. Institutional.
   ====================================================== */

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --font-head: 'DM Sans', system-ui, sans-serif;
  --font-body: 'Inter', system-ui, sans-serif;
  --bg: #0f2942;
  --bg-deep: #091d31;
  --bg-card: rgba(15, 41, 66, 0.75);
  --primary: #0891b2;
  --primary-glow: rgba(8, 145, 178, 0.3);
  --primary-dim: rgba(8, 145, 178, 0.1);
  --secondary: #0e7490;
  --accent-red: #ef4444;
  --text: #e2e8f0;
  --text-secondary: #94a3b8;
  --text-tertiary: #4a6080;
  --border: rgba(8, 145, 178, 0.1);
  --r: 8px;
  --r-sm: 4px;
}

html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}
a { text-decoration: none; color: inherit; }
img { max-width: 100%; display: block; }

/* ====== LAYOUT ====== */
.container { max-width: 1060px; margin: 0 auto; padding: 0 32px; }
.section { padding: 72px 0; }
.section-divider {
  height: 1px;
  background: var(--border);
  max-width: 1060px;
  margin: 0 auto;
}

.section-label {
  font-family: var(--font-head);
  font-size: 0.68rem; font-weight: 600;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--primary);
  margin-bottom: 10px;
}
.section-title {
  font-family: var(--font-head);
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: 700; color: var(--text);
  line-height: 1.25; letter-spacing: -0.02em;
  margin-bottom: 36px;
}

/* ====== REVEAL (subtle fade only) ====== */
.rv {
  opacity: 0; transform: translateY(12px);
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.rv.v { opacity: 1; transform: translateY(0); }

/* ======================================================
   1. HERO
   ====================================================== */
.hero {
  background: var(--bg-deep);
  border-bottom: 1px solid var(--border);
  padding: 80px 0 64px;
}
.hero-grid {
  display: grid; grid-template-columns: auto 1fr;
  gap: 48px; align-items: center;
}
.hero-photo {
  width: 160px; height: 160px; border-radius: 50%;
  border: 3px solid var(--primary);
  background: var(--bg-card);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; flex-shrink: 0;
}
.hero-photo img { width: 100%; height: 100%; object-fit: cover; }
.hero-photo-placeholder {
  color: var(--text-tertiary); font-size: 0.7rem;
  text-transform: uppercase; letter-spacing: 0.08em;
}
.hero-info h1 {
  font-family: var(--font-head);
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 800; color: var(--text);
  line-height: 1.1; letter-spacing: -0.02em;
}
.hero-title {
  font-family: var(--font-head);
  font-size: 1.1rem; font-weight: 500;
  color: var(--primary); margin-top: 6px;
}
.hero-subtitle {
  font-size: 0.92rem; color: var(--text-secondary);
  margin-top: 8px; line-height: 1.6; max-width: 560px;
}
.hero-contact-row {
  display: flex; gap: 20px; flex-wrap: wrap;
  margin-top: 20px;
}
.hero-contact-row a, .hero-contact-row span {
  font-size: 0.82rem; color: var(--text-secondary);
  font-weight: 500; display: inline-flex;
  align-items: center; gap: 5px;
}
.hero-contact-row a:hover { color: var(--primary); }
.hero-contact-row svg { width: 14px; height: 14px; color: var(--primary); flex-shrink: 0; }

/* Metrics */
.hero-metrics {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 1px; background: var(--border);
  border-radius: var(--r); overflow: hidden;
  margin-top: 32px;
}
.metric-card {
  background: var(--bg-card); padding: 18px 20px; text-align: center;
}
.metric-val {
  font-family: var(--font-head);
  font-size: 1.6rem; font-weight: 800;
  color: var(--text); line-height: 1;
}
.metric-label {
  font-size: 0.65rem; color: var(--text-tertiary);
  margin-top: 4px; letter-spacing: 0.06em;
  text-transform: uppercase; font-weight: 500;
}

/* ======================================================
   2. SKILLS / SPECIALIZATIONS
   ====================================================== */
.spec-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 16px;
}
.spec-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 20px 22px;
}
.spec-card h4 {
  font-family: var(--font-head);
  font-size: 0.82rem; font-weight: 700;
  color: var(--primary); margin-bottom: 10px;
  letter-spacing: 0.02em; text-transform: uppercase;
}
.spec-card ul { list-style: none; }
.spec-card li {
  font-size: 0.88rem; color: var(--text-secondary);
  padding: 3px 0; line-height: 1.5;
}

/* ======================================================
   3. EXPERIENCE
   ====================================================== */
.timeline { display: flex; flex-direction: column; }
.tl-item {
  display: grid; grid-template-columns: 180px 1fr;
  gap: 32px; padding: 28px 0;
  border-bottom: 1px solid var(--border);
}
.tl-item:last-child { border-bottom: none; }
.tl-dates {
  font-size: 0.78rem; font-weight: 600;
  color: var(--text-tertiary); padding-top: 4px;
  letter-spacing: 0.02em;
}
.tl-content h3 {
  font-family: var(--font-head);
  font-size: 1.05rem; font-weight: 700;
  color: var(--text);
}
.tl-company {
  font-size: 0.92rem; color: var(--primary);
  font-weight: 600; margin-top: 2px;
}
.tl-desc {
  font-size: 0.86rem; color: var(--text-secondary);
  margin-top: 10px; line-height: 1.7;
}
.tl-highlights { margin-top: 10px; }
.tl-highlights li {
  font-size: 0.84rem; color: var(--text-secondary);
  padding-left: 14px; position: relative;
  line-height: 1.6; margin-top: 4px; list-style: none;
}
.tl-highlights li::before {
  content: ''; position: absolute; left: 0; top: 9px;
  width: 4px; height: 4px; border-radius: 50%;
  background: var(--primary);
}

/* ======================================================
   4. PROJECTS / RESEARCH & PUBLICATIONS
   ====================================================== */
.pub-list { display: flex; flex-direction: column; gap: 16px; }
.pub-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 22px 26px;
}
.pub-card h3 {
  font-family: var(--font-head);
  font-size: 0.98rem; font-weight: 700;
  color: var(--text); line-height: 1.4;
}
.pub-card p {
  font-size: 0.84rem; color: var(--text-secondary);
  margin-top: 8px; line-height: 1.65;
}
.pub-meta {
  display: flex; gap: 12px; flex-wrap: wrap;
  margin-top: 12px;
}
.pub-meta span {
  font-size: 0.7rem; font-weight: 500;
  color: var(--text-tertiary); text-transform: uppercase;
  letter-spacing: 0.04em;
}
.pub-link {
  display: inline-block; margin-top: 10px;
  font-size: 0.8rem; font-weight: 600;
  color: var(--primary);
}

/* ======================================================
   5. CERTIFICATIONS / LICENSES
   ====================================================== */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 16px;
}
.cert-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 20px 22px;
  position: relative;
}
.cert-card h4 {
  font-family: var(--font-head);
  font-size: 0.92rem; font-weight: 700;
  color: var(--text);
}
.cert-issuer {
  font-size: 0.8rem; color: var(--text-secondary);
  margin-top: 4px;
}
.cert-date {
  font-size: 0.72rem; color: var(--text-tertiary);
  margin-top: 6px; font-weight: 500;
}
.cert-status {
  display: inline-block; margin-top: 8px;
  font-size: 0.65rem; font-weight: 700;
  letter-spacing: 0.06em; text-transform: uppercase;
  padding: 3px 10px; border-radius: 100px;
  background: var(--primary-dim); color: var(--primary);
}
.cert-status.active {
  background: rgba(239, 68, 68, 0.12);
  color: var(--accent-red);
}

/* ======================================================
   6. EDUCATION
   ====================================================== */
.edu-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
}
.edu-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 22px 24px;
}
.edu-card h3 {
  font-family: var(--font-head);
  font-size: 0.95rem; font-weight: 700;
  color: var(--text);
}
.edu-institution {
  font-size: 0.84rem; color: var(--primary);
  font-weight: 600; margin-top: 4px;
}
.edu-year {
  font-size: 0.74rem; color: var(--text-tertiary);
  margin-top: 6px; font-weight: 500;
}
.edu-desc {
  font-size: 0.82rem; color: var(--text-secondary);
  margin-top: 8px; line-height: 1.6;
}

/* ======================================================
   7. ENDORSEMENTS
   ====================================================== */
.endorsement-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px;
}
.endorsement-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 26px 24px;
}
.endorsement-quote {
  font-size: 2rem; line-height: 1;
  color: var(--primary); opacity: 0.4;
  font-family: var(--font-head);
  margin-bottom: 6px;
}
.endorsement-text {
  font-size: 0.88rem; color: var(--text-secondary);
  line-height: 1.75; font-style: italic;
  margin-bottom: 16px;
}
.endorsement-author {
  border-top: 1px solid var(--border);
  padding-top: 12px;
}
.endorsement-name {
  font-size: 0.82rem; font-weight: 700;
  color: var(--text); font-family: var(--font-head);
}
.endorsement-role {
  font-size: 0.72rem; color: var(--text-tertiary);
}

/* ======================================================
   8. CONTACT FOOTER
   ====================================================== */
.contact-section {
  background: var(--bg-deep);
  border-top: 1px solid var(--border);
  padding: 64px 0 40px;
}
.contact-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1px; background: var(--border);
  border-radius: var(--r); overflow: hidden;
}
.contact-cell {
  background: var(--bg-card);
  padding: 24px 18px; text-align: center;
}
.contact-cell svg {
  width: 20px; height: 20px; color: var(--primary);
  margin: 0 auto 10px; display: block;
}
.contact-cell h4 {
  font-family: var(--font-head);
  font-size: 0.76rem; font-weight: 700;
  color: var(--text); margin-bottom: 4px;
}
.contact-cell p, .contact-cell a {
  font-size: 0.78rem; color: var(--text-secondary);
  word-break: break-all;
}
.whatsapp-btn {
  display: inline-flex; align-items: center; gap: 6px;
  margin-top: 24px; padding: 10px 24px;
  background: #25D366; color: #fff;
  font-family: var(--font-body);
  font-size: 0.82rem; font-weight: 600;
  border-radius: 100px; border: none; cursor: pointer;
}

.footer-bottom {
  max-width: 1060px; margin: 32px auto 0;
  padding-top: 20px; border-top: 1px solid var(--border);
  text-align: center;
  font-size: 0.72rem; color: var(--text-tertiary);
}

/* ======================================================
   RESPONSIVE
   ====================================================== */
@media (max-width: 768px) {
  .container { padding: 0 20px; }
  .section { padding: 52px 0; }
  .hero { padding: 60px 0 48px; }
  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center; justify-items: center;
  }
  .hero-photo { width: 120px; height: 120px; }
  .hero-subtitle { max-width: 100%; }
  .hero-contact-row { justify-content: center; }
  .hero-metrics { grid-template-columns: repeat(2, 1fr); }
  .tl-item { grid-template-columns: 1fr; gap: 4px; }
  .spec-grid { grid-template-columns: 1fr 1fr; }
  .cert-grid { grid-template-columns: 1fr; }
  .edu-grid { grid-template-columns: 1fr; }
  .endorsement-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 480px) {
  .hero-info h1 { font-size: 1.8rem; }
  .hero-metrics { grid-template-columns: 1fr 1fr; }
  .spec-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
}

/* ======================================================
   RTL
   ====================================================== */
[dir="rtl"] .tl-item { direction: rtl; }
[dir="rtl"] .tl-highlights li { padding-left: 0; padding-right: 14px; }
[dir="rtl"] .tl-highlights li::before { left: auto; right: 0; }
[dir="rtl"] .hero-contact-row { direction: rtl; }

/* ======================================================
   PRINT — Critical for medical credential submissions
   ====================================================== */
@media print {
  @page { margin: 0.5in; size: A4; }
  * {
    -webkit-print-color-adjust: exact !important;
    print-color-adjust: exact !important;
  }
  html, body {
    background: #fff !important;
    color: #1a1a1a !important;
    font-size: 10pt;
  }
  .rv { opacity: 1 !important; transform: none !important; transition: none !important; }
  .no-print { display: none !important; }

  /* Override dark theme for print */
  .hero, .contact-section { background: #fff !important; border-color: #e2e8f0 !important; }
  .hero-info h1, .section-title, .metric-val,
  .tl-content h3, .pub-card h3, .cert-card h4,
  .edu-card h3, .endorsement-name, .contact-cell h4 { color: #111 !important; }
  .hero-title, .tl-company, .edu-institution, .spec-card h4,
  .section-label, .pub-link { color: #0891b2 !important; }
  .hero-subtitle, .tl-desc, .tl-highlights li,
  .pub-card p, .cert-issuer, .edu-desc,
  .endorsement-text, .metric-label, .spec-card li,
  .hero-contact-row a, .hero-contact-row span,
  .text-secondary, .contact-cell p, .contact-cell a { color: #444 !important; }
  .tl-dates, .cert-date, .edu-year, .pub-meta span,
  .endorsement-role, .footer-bottom, .text-tertiary { color: #888 !important; }

  /* Card backgrounds for print */
  .spec-card, .pub-card, .cert-card, .edu-card,
  .endorsement-card, .metric-card, .contact-cell {
    background: #fafafa !important;
    border-color: #e2e8f0 !important;
  }
  .hero-metrics, .contact-grid { background: #e2e8f0 !important; }
  .hero-photo { border-color: #0891b2 !important; background: #f0f0f0 !important; }
  .section-divider { background: #e2e8f0 !important; }

  /* Active badge in print */
  .cert-status.active { background: rgba(239, 68, 68, 0.1) !important; color: #ef4444 !important; }
  .cert-status { background: #f0f0f0 !important; color: #0891b2 !important; }

  /* Sizing */
  .hero { padding: 0 0 12px !important; }
  .section { padding: 14px 0 !important; }
  .section-title { font-size: 13pt !important; margin-bottom: 12px !important; }
  .section-label { font-size: 6pt; margin-bottom: 4px; }
  .hero-info h1 { font-size: 18pt !important; }
  .hero-title { font-size: 10pt; }
  .hero-photo { width: 80px; height: 80px; }
  .metric-val { font-size: 12pt; }
  .metric-label { font-size: 6pt; }
  .container { padding: 0 !important; }

  /* Avoid page-break inside cards */
  .spec-card, .pub-card, .cert-card, .edu-card,
  .endorsement-card, .tl-item, .metric-card,
  .contact-grid, .hero-metrics {
    page-break-inside: avoid !important;
    break-inside: avoid !important;
  }
  .section-label, .section-title {
    page-break-after: avoid !important;
    break-after: avoid !important;
  }

  /* Hide WhatsApp button in print */
  .whatsapp-btn { display: none !important; }
}
</style>
{{#if customization}}
<style>
{{#if customization.primaryColor}}
:root { --text: {{customization.primaryColor}}; }
{{/if}}
{{#if customization.accentColor}}
:root {
  --primary: {{customization.accentColor}};
  --primary-glow: {{customization.accentColor}}4d;
  --primary-dim: {{customization.accentColor}}1a;
  --border: {{customization.accentColor}}1a;
}
{{/if}}
{{#if customization.bgColor}}
:root { --bg: {{customization.bgColor}}; }
{{/if}}
{{#if customization.fontFamily}}
:root { --font-head: '{{customization.fontFamily}}', system-ui, sans-serif; }
{{/if}}
{{#if customization.bodyFont}}
:root { --font-body: '{{customization.bodyFont}}', system-ui, sans-serif; }
{{/if}}
</style>
{{/if}}
</head>
<body>

<!-- ====== 1. HERO ====== -->
<section class="hero">
  <div class="container">
    <div class="hero-grid rv">
      <div class="hero-photo">
        {{#if basics.photoUrl}}
        <img src="{{basics.photoUrl}}" alt="{{basics.fullName}}">
        {{else}}
        <span class="hero-photo-placeholder">Photo</span>
        {{/if}}
      </div>
      <div class="hero-info">
        <h1>{{basics.fullName}}</h1>
        <div class="hero-title">{{basics.title}}</div>
        {{#if basics.subtitle}}
        <p class="hero-subtitle">{{basics.subtitle}}</p>
        {{else}}
          {{#if basics.valueProposition}}
          <p class="hero-subtitle">{{basics.valueProposition}}</p>
          {{else}}
            {{#if basics.bio}}
            <p class="hero-subtitle">{{basics.bio}}</p>
            {{/if}}
          {{/if}}
        {{/if}}

        <div class="hero-contact-row">
          {{#if basics.location}}
          <span>
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
            {{basics.location}}
          </span>
          {{/if}}
          {{#if basics.email}}
          <a href="mailto:{{basics.email}}">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
            {{basics.email}}
          </a>
          {{/if}}
          {{#if basics.phone}}
          <a href="tel:{{basics.phone}}">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
            {{basics.phone}}
          </a>
          {{/if}}
          {{#if basics.linkedin}}
          <a href="{{basics.linkedin}}" target="_blank" rel="noopener">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/></svg>
            LinkedIn
          </a>
          {{/if}}
          {{#if basics.website}}
          <a href="{{basics.website}}" target="_blank" rel="noopener">
            <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"/></svg>
            Website
          </a>
          {{/if}}
        </div>
      </div>
    </div>

    {{#if metrics}}
    <div class="hero-metrics rv">
      {{#each metrics}}
      <div class="metric-card">
        <div class="metric-val">{{this.value}}</div>
        <div class="metric-label">{{this.label}}</div>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </div>
</section>

<!-- ====== 2. SKILLS / SPECIALIZATIONS ====== -->
{{#if skills}}
{{#unless (isHidden "specializations")}}
<section class="section" id="specializations">
  <div class="container">
    <div class="section-label rv">Specializations</div>
    <div class="section-title rv">Areas of Expertise</div>
    <div class="spec-grid">
      {{#each skills}}
      <div class="spec-card rv">
        <h4>{{this.category}}</h4>
        <ul>
          {{#each this.items}}<li>{{this}}</li>{{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="section-divider"></div>
{{/unless}}
{{/if}}

<!-- ====== 3. EXPERIENCE ====== -->
{{#if experience}}
{{#unless (isHidden "experience")}}
<section class="section" id="experience">
  <div class="container">
    <div class="section-label rv">Professional Experience</div>
    <div class="section-title rv">Clinical & Professional History</div>
    <div class="timeline">
      {{#each experience}}
      <div class="tl-item rv">
        <div class="tl-dates">{{this.startDate}} &mdash; {{#if this.endDate}}{{this.endDate}}{{else}}Present{{/if}}</div>
        <div class="tl-content">
          <h3>{{this.title}}</h3>
          <div class="tl-company">{{this.company}}</div>
          {{#if this.highlights}}
          <ul class="tl-highlights">
            {{#each this.highlights}}
            <li>{{this}}</li>
            {{/each}}
          </ul>
          {{else if this.description}}
          <p class="tl-desc">{{this.description}}</p>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="section-divider"></div>
{{/unless}}
{{/if}}

<!-- ====== 4. RESEARCH & PUBLICATIONS ====== -->
{{#if projects}}
{{#unless (isHidden "research")}}
<section class="section" id="research">
  <div class="container">
    <div class="section-label rv">Research & Publications</div>
    <div class="section-title rv">Selected Works</div>
    <div class="pub-list">
      {{#each projects}}
      <div class="pub-card rv">
        <h3>{{this.title}}</h3>
        {{#if this.description}}
        <p>{{this.description}}</p>
        {{/if}}
        {{#if this.technologies}}
        <div class="pub-meta">
          {{#each this.technologies}}<span>{{this}}</span>{{/each}}
        </div>
        {{/if}}
        {{#if this.url}}
        <a href="{{this.url}}" target="_blank" rel="noopener" class="pub-link">View Publication &rarr;</a>
        {{/if}}
        {{#if this.link}}
        <a href="{{this.link}}" target="_blank" rel="noopener" class="pub-link">View Publication &rarr;</a>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="section-divider"></div>
{{/unless}}
{{/if}}

<!-- ====== 5. CERTIFICATIONS & LICENSES ====== -->
{{#if certifications}}
{{#unless (isHidden "certifications")}}
<section class="section" id="certifications">
  <div class="container">
    <div class="section-label rv">Licenses & Certifications</div>
    <div class="section-title rv">Professional Credentials</div>
    <div class="cert-grid">
      {{#each certifications}}
      <div class="cert-card rv">
        <h4>{{this.name}}</h4>
        {{#if this.issuer}}
        <div class="cert-issuer">{{this.issuer}}</div>
        {{/if}}
        {{#if this.date}}
        <div class="cert-date">{{this.date}}</div>
        {{/if}}
        {{#if this.status}}
        {{#ifEq this.status "Active"}}
        <span class="cert-status active">{{this.status}}</span>
        {{else}}
        <span class="cert-status">{{this.status}}</span>
        {{/ifEq}}
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="section-divider"></div>
{{/unless}}
{{/if}}

<!-- ====== 6. EDUCATION ====== -->
{{#if education}}
{{#unless (isHidden "education")}}
<section class="section" id="education">
  <div class="container">
    <div class="section-label rv">Education</div>
    <div class="section-title rv">Academic Background</div>
    <div class="edu-grid">
      {{#each education}}
      <div class="edu-card rv">
        <h3>{{this.degree}}</h3>
        <div class="edu-institution">{{this.institution}}</div>
        {{#if this.year}}
        <div class="edu-year">{{this.year}}</div>
        {{/if}}
        {{#if this.description}}
        <p class="edu-desc">{{this.description}}</p>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="section-divider"></div>
{{/unless}}
{{/if}}

<!-- ====== 7. ENDORSEMENTS ====== -->
{{#if endorsements}}
{{#unless (isHidden "endorsements")}}
<section class="section" id="endorsements">
  <div class="container">
    <div class="section-label rv">Professional Endorsements</div>
    <div class="section-title rv">Colleague Testimonials</div>
    <div class="endorsement-grid">
      {{#each endorsements}}
      <div class="endorsement-card rv">
        <div class="endorsement-quote">&ldquo;</div>
        <p class="endorsement-text">{{this.quote}}</p>
        <div class="endorsement-author">
          <div class="endorsement-name">{{this.name}}</div>
          <div class="endorsement-role">{{this.title}}{{#if this.company}}, {{this.company}}{{/if}}</div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
<div class="section-divider"></div>
{{/unless}}
{{/if}}

<!-- ====== 8. CONTACT FOOTER ====== -->
{{#unless (isHidden "contact")}}
<section class="contact-section" id="contact">
  <div class="container">
    <div class="section-label rv">Contact</div>
    <div class="section-title rv">Get in Touch</div>
    <div class="contact-grid rv">
      {{#if basics.email}}
      <a href="mailto:{{basics.email}}" class="contact-cell">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/></svg>
        <h4>Email</h4>
        <p>{{basics.email}}</p>
      </a>
      {{/if}}
      {{#if basics.phone}}
      <a href="tel:{{basics.phone}}" class="contact-cell">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/></svg>
        <h4>Phone</h4>
        <p>{{basics.phone}}</p>
      </a>
      {{/if}}
      {{#if basics.phone}}
      <a href="https://wa.me/{{basics.phone}}" class="contact-cell" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        <h4>WhatsApp</h4>
        <p>Send Message</p>
      </a>
      {{/if}}
      {{#if basics.location}}
      <div class="contact-cell">
        <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 0 1 15 0Z"/></svg>
        <h4>Location</h4>
        <p>{{basics.location}}</p>
      </div>
      {{/if}}
    </div>
  </div>
  <div class="footer-bottom">
    &copy; {{basics.fullName}} &mdash; {{basics.title}}
  </div>
</section>
{{/unless}}

<script>
/* Subtle reveal on scroll — no fancy effects */
var ro = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) {
    if (e.isIntersecting) { e.target.classList.add('v'); ro.unobserve(e.target); }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -20px 0px' });
document.querySelectorAll('.rv').forEach(function(el) { ro.observe(el); });

/* Reduced motion */
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  document.querySelectorAll('.rv').forEach(function(el) {
    el.classList.add('v'); el.style.transition = 'none';
  });
}

/* Smooth scroll for anchor links */
document.querySelectorAll('a[href^="#"]').forEach(function(a) {
  a.addEventListener('click', function(e) {
    e.preventDefault();
    var t = document.querySelector(a.getAttribute('href'));
    if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});
</script>

</body>
</html>