<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{project.title}} — {{basics.fullName}}</title>
<meta name="description" content="{{#if project.tagline}}{{project.tagline}}{{else}}{{project.title}} by {{basics.fullName}}{{/if}}">
<meta name="theme-color" content="#1b1b1b">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: {{#if customization.bgColor}}{{customization.bgColor}}{{else}}#1b1b1b{{/if}};
  --bg-alt: #151515; --bg-card: #111111;
  --text: #e8e8e8; --text-dim: #a0a0a0; --text-muted: #6a6a6a; --border: #2a2a2a;
  --accent: {{#if customization.accentColor}}{{customization.accentColor}}{{else}}#DFFF00{{/if}};
  --font-head: 'Geist', system-ui, sans-serif; --font-mono: 'Geist Mono', ui-monospace, monospace;
}
body { font-family: var(--font-head); background: var(--bg); color: var(--text); min-height: 100dvh; overflow-x: hidden; -webkit-font-smoothing: antialiased; }
a { color: inherit; text-decoration: none; }
.nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; height: 60px; padding: 0 24px; background: rgba(27,27,27,0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
.nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; transition: color .25s; }
.nav-brand:hover { color: var(--accent); }
.nav-back { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); transition: color .25s; }
.nav-back:hover { color: var(--accent); }
.wrap { max-width: 900px; margin: 0 auto; padding: 90px 24px 40px; }
.back { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 32px; transition: color .25s; }
.back:hover { color: var(--accent); }
.phase { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 12px; }
.title { font-size: clamp(28px, 4vw, 48px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 8px; }
.tagline { font-size: 16px; color: var(--text-dim); margin-bottom: 16px; }
.meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-bottom: 32px; }
.meta-row span { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); }
.meta-row .dot { color: var(--accent); }
/* Plus crosshair */
.cross { position: relative; display: inline-block; width: 24px; height: 24px; color: var(--text-muted); }
.cross::before, .cross::after { content: ''; position: absolute; background: currentColor; }
.cross::before { left: 0; top: 50%; width: 100%; height: 1px; transform: translateY(-50%); }
.cross::after { top: 0; left: 50%; height: 100%; width: 1px; transform: translateX(-50%); }
/* Hero image */
.hero-img { position: relative; display: block; width: 100%; overflow: hidden; border: 1px solid var(--border); border-radius: 2px; margin-bottom: 40px; cursor: zoom-in; background: none; padding: 0; }
.hero-img img { width: 100%; height: auto; display: block; transition: transform .5s; }
.hero-img:hover img { transform: scale(1.02); }
.hero-img .cross { position: absolute; width: 16px; height: 16px; color: rgba(223,255,0,0.45); }
.hero-img .ic-tl { top: 12px; left: 12px; } .hero-img .ic-tr { top: 12px; right: 12px; }
.hero-img .ic-bl { bottom: 12px; left: 12px; } .hero-img .ic-br { bottom: 12px; right: 12px; }
.zoom-hint { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); padding: 4px 12px; font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: #1b1b1b; background: var(--accent); border-radius: 2px; opacity: 0; transition: opacity .3s; }
.hero-img:hover .zoom-hint { opacity: 1; }
.no-img { width: 100%; aspect-ratio: 16/10; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); border-radius: 2px; margin-bottom: 40px; background: linear-gradient(135deg, #222, #141414); font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); }
.desc { font-size: 15px; line-height: 1.7; color: var(--text-dim); margin-bottom: 32px; }
/* Content blocks */
.blocks { display: flex; flex-direction: column; gap: 28px; margin-bottom: 40px; }
.blk-text { font-size: 15px; line-height: 1.8; color: var(--text-dim); }
.blk-img { border: 1px solid var(--border); border-radius: 2px; overflow: hidden; }
.blk-img img { width: 100%; height: auto; display: block; }
.blk-img.full { margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); width: 100vw; max-width: 100vw; border-left: 0; border-right: 0; border-radius: 0; }
.blk-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
@media (min-width: 768px) { .blk-grid { grid-template-columns: repeat(3, 1fr); } }
.blk-grid figure { border: 1px solid var(--border); border-radius: 2px; overflow: hidden; }
.blk-grid img { width: 100%; height: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
figure figcaption { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-top: 8px; }
.blk-video .video-embed { position: relative; width: 100%; padding-top: 56.25%; border: 1px solid var(--border); border-radius: 2px; overflow: hidden; background: #000; }
.blk-video .video-embed iframe, .blk-video .video-embed video { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: contain; }
.metabox { display: grid; grid-template-columns: 1fr; gap: 24px; padding: 24px; background: var(--bg-alt); border: 1px solid var(--border); margin-bottom: 32px; }
@media (min-width: 768px) { .metabox { grid-template-columns: repeat(2, 1fr); } }
.metabox .k { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 8px; }
.metabox .v { font-size: 13px; color: var(--text-dim); }
.tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
.tag { padding: 6px 14px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 2px; }
.links { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 40px; }
.lnk { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); transition: gap .3s; }
.lnk:hover { gap: 14px; }
/* Plus-shape prev/next */
.pnav { display: flex; align-items: stretch; justify-content: space-between; gap: 16px; padding-top: 32px; border-top: 1px solid var(--border); }
.pnav-item { display: flex; align-items: center; gap: 16px; color: var(--text-muted); background: none; border: none; cursor: pointer; }
.pnav-item.next { flex-direction: row-reverse; text-align: right; }
.pnav-item .cross { transition: transform .3s, color .3s; }
.pnav-item:hover .cross { transform: rotate(90deg) scale(1.1); color: var(--accent); }
.pnav-item .pn-lbl { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; }
.pnav-item .pn-ttl { font-size: 14px; font-weight: 500; color: var(--text); transition: color .3s; }
.pnav-item:hover .pn-ttl { color: var(--accent); }
.footer { padding: 40px 24px; border-top: 1px solid var(--border); text-align: center; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); }
/* Lightbox */
.lb { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; background: rgba(17,17,17,0.97); }
.lb.open { display: flex; }
.lb .cross { position: absolute; width: 18px; height: 18px; color: rgba(223,255,0,0.4); }
.lb .lc-tl { top: 20px; left: 20px; } .lb .lc-tr { top: 20px; right: 20px; }
.lb .lc-bl { bottom: 20px; left: 20px; } .lb .lc-br { bottom: 20px; right: 20px; }
.lb-close { position: absolute; top: 20px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-dim); background: none; border: none; cursor: pointer; }
.lb-close:hover { color: var(--accent); }
.lb-stage { width: 90vw; height: 80vh; overflow: hidden; display: flex; align-items: center; justify-content: center; touch-action: none; }
.lb-stage img { max-width: 100%; max-height: 100%; user-select: none; transition: transform .15s ease-out; }
.lb-ctrl { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 20px; }
.lb-ctrl button { font-family: var(--font-mono); font-size: 16px; color: var(--text-dim); background: none; border: none; cursor: pointer; }
.lb-ctrl button:hover { color: var(--accent); }
.lb-ctrl .pct { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }
</style>
</head>
<body>

<header class="nav">
  <a href="{{portfolioUrl}}" class="nav-brand">{{basics.fullName}}</a>
  <a href="{{portfolioUrl}}#gallery" class="nav-back">[ All Work ]</a>
</header>

<div class="wrap">
  <a href="{{portfolioUrl}}#gallery" class="back"><span>&larr;</span><span>Back to Gallery</span></a>

  {{#if project.meta.type}}<p class="phase">{{project.meta.type}}{{#if project.meta.year}} &middot; {{project.meta.year}}{{/if}}</p>{{else}}{{#if project.technologies.[0]}}<p class="phase">{{project.technologies.[0]}}{{#if project.meta.year}} &middot; {{project.meta.year}}{{/if}}</p>{{/if}}{{/if}}
  <h1 class="title">{{project.title}}</h1>
  {{#if project.tagline}}<p class="tagline">{{project.tagline}}</p>{{/if}}

  {{#if project.coverUrl}}
  <button type="button" class="hero-img" id="zoomBtn" aria-label="Zoom image">
    <span class="cross ic-tl"></span><span class="cross ic-tr"></span>
    <span class="cross ic-bl"></span><span class="cross ic-br"></span>
    <img src="{{project.coverUrl}}" alt="{{project.title}}" id="heroImg">
    <span class="zoom-hint">Click to Zoom</span>
  </button>
  {{else}}
  <div class="no-img">{{project.title}}</div>
  {{/if}}

  {{#if project.description}}<p class="desc">{{project.description}}</p>{{/if}}

  {{#if (or project.meta.role project.meta.duration project.meta.institution project.meta.teamSize)}}
  <div class="metabox">
    {{#if project.meta.role}}<div><p class="k">Role</p><p class="v">{{project.meta.role}}</p></div>{{/if}}
    {{#if project.meta.duration}}<div><p class="k">Duration</p><p class="v">{{project.meta.duration}}</p></div>{{/if}}
    {{#if project.meta.institution}}<div><p class="k">For</p><p class="v">{{project.meta.institution}}</p></div>{{/if}}
    {{#if project.meta.teamSize}}<div><p class="k">Team</p><p class="v">{{project.meta.teamSize}}</p></div>{{/if}}
  </div>
  {{/if}}

  {{#if project.technologies}}
  <div class="tags">{{#each project.technologies}}<span class="tag">{{this}}</span>{{/each}}</div>
  {{/if}}

  {{#if project.blocks}}
  <div class="blocks">
    {{#each project.blocks}}
      {{#ifEq this.kind "paragraph"}}{{#if this.body}}<p class="blk-text">{{this.body}}</p>{{/if}}{{/ifEq}}
      {{#ifEq this.kind "image"}}{{#if this.url}}<figure class="blk-img{{#if this.fullBleed}} full{{/if}}"><img src="{{this.url}}" alt="{{#if this.caption}}{{this.caption}}{{else}}{{../project.title}}{{/if}}" loading="lazy">{{#if this.caption}}<figcaption>{{this.caption}}</figcaption>{{/if}}</figure>{{/if}}{{/ifEq}}
      {{#ifEq this.kind "imageGrid"}}{{#if this.images}}<div class="blk-grid">{{#each this.images}}{{#if this.url}}<figure><img src="{{this.url}}" alt="{{#if this.caption}}{{this.caption}}{{else}}image{{/if}}" loading="lazy">{{#if this.caption}}<figcaption>{{this.caption}}</figcaption>{{/if}}</figure>{{/if}}{{/each}}</div>{{/if}}{{/ifEq}}
      {{#ifEq this.kind "video"}}{{#if this.url}}<figure class="blk-video">{{videoEmbed this.url}}{{#if this.caption}}<figcaption>{{this.caption}}</figcaption>{{/if}}</figure>{{/if}}{{/ifEq}}
    {{/each}}
  </div>
  {{/if}}

  {{#if project.links}}
  <div class="links">{{#each project.links}}<a href="{{this.url}}" target="_blank" rel="noopener" class="lnk">{{this.label}} <span>&rarr;</span></a>{{/each}}</div>
  {{else}}{{#if project.link}}<div class="links"><a href="{{project.link}}" target="_blank" rel="noopener" class="lnk">View Project <span>&rarr;</span></a></div>{{/if}}{{/if}}

  {{#if (or prevProject nextProject)}}
  <div class="pnav">
    {{#if prevProject}}
    <a class="pnav-item prev" href="{{portfolioUrl}}/projects/{{prevProject.slug}}">
      <span class="cross"></span>
      <span><span class="pn-lbl">Previous</span><br><span class="pn-ttl">{{prevProject.title}}</span></span>
    </a>
    {{else}}<span></span>{{/if}}
    {{#if nextProject}}
    <a class="pnav-item next" href="{{portfolioUrl}}/projects/{{nextProject.slug}}">
      <span class="cross"></span>
      <span><span class="pn-lbl">Next</span><br><span class="pn-ttl">{{nextProject.title}}</span></span>
    </a>
    {{else}}<span></span>{{/if}}
  </div>
  {{/if}}
</div>

<footer class="footer">&copy; {{basics.fullName}} &middot; <a href="{{portfolioUrl}}">Back to Portfolio</a></footer>

{{#if project.coverUrl}}
<div class="lb" id="lb">
  <span class="cross lc-tl"></span><span class="cross lc-tr"></span>
  <span class="cross lc-bl"></span><span class="cross lc-br"></span>
  <button class="lb-close" id="lbClose">[ Close &times; ]</button>
  <div class="lb-stage" id="lbStage">
    <img src="{{project.coverUrl}}" alt="{{project.title}}" id="lbImg" draggable="false">
  </div>
  <div class="lb-ctrl">
    <button id="zOut" aria-label="Zoom out">[ &minus; ]</button>
    <span class="pct" id="zPct">100%</span>
    <button id="zIn" aria-label="Zoom in">[ + ]</button>
  </div>
</div>
<script>
(function () {
  var lb = document.getElementById('lb'), img = document.getElementById('lbImg'), stage = document.getElementById('lbStage');
  var pct = document.getElementById('zPct'), btn = document.getElementById('zoomBtn');
  var scale = 1, ox = 0, oy = 0, dragging = false, sx = 0, sy = 0, sox = 0, soy = 0;
  function apply() { img.style.transform = 'translate(' + ox + 'px,' + oy + 'px) scale(' + scale + ')'; pct.textContent = Math.round(scale * 100) + '%'; img.style.cursor = scale > 1 ? 'grab' : 'default'; }
  function zoom(d) { scale = Math.min(4, Math.max(1, +(scale + d).toFixed(2))); if (scale === 1) { ox = 0; oy = 0; } apply(); }
  function open() { lb.classList.add('open'); document.body.style.overflow = 'hidden'; scale = 1; ox = 0; oy = 0; apply(); }
  function close() { lb.classList.remove('open'); document.body.style.overflow = ''; }
  if (btn) btn.addEventListener('click', open);
  document.getElementById('lbClose').addEventListener('click', close);
  document.getElementById('zIn').addEventListener('click', function () { zoom(0.3); });
  document.getElementById('zOut').addEventListener('click', function () { zoom(-0.3); });
  lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
  stage.addEventListener('wheel', function (e) { e.preventDefault(); zoom(e.deltaY < 0 ? 0.3 : -0.3); }, { passive: false });
  stage.addEventListener('pointerdown', function (e) { if (scale <= 1) return; dragging = true; sx = e.clientX; sy = e.clientY; sox = ox; soy = oy; });
  stage.addEventListener('pointermove', function (e) { if (!dragging) return; ox = sox + (e.clientX - sx); oy = soy + (e.clientY - sy); apply(); });
  function up() { dragging = false; }
  stage.addEventListener('pointerup', up); stage.addEventListener('pointerleave', up);
  document.addEventListener('keydown', function (e) { if (!lb.classList.contains('open')) return; if (e.key === 'Escape') close(); else if (e.key === '+' || e.key === '=') zoom(0.3); else if (e.key === '-' || e.key === '_') zoom(-0.3); });
})();
</script>
{{/if}}
</body>
</html>
