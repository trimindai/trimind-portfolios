{{#if projects}}
<script>
(function () {
  var wrap = document.getElementById('cone');
  if (!wrap) return;
  var tilt = document.getElementById('cone-tilt');
  var spin = document.getElementById('cone-spin');
  var cards = Array.prototype.slice.call(wrap.querySelectorAll('.cone-card'));
  var N = cards.length;
  if (!N) { wrap.style.display = 'none'; return; }

  // Phone: replace the spinning cone with a static stacked photo-cube
  // cluster (calmer + easier to tap). Skip the cone rAF loop entirely.
  if (window.matchMedia('(max-width: 767px)').matches) { buildCubes(cards); return; }

  function buildCubes(srcCards) {
    var host = document.getElementById('cubeStack');
    if (!host) return;
    var picks = srcCards.slice(0, 6);
    if (!picks.length) { host.style.display = 'none'; return; }
    // nested pyramid: [left px, top px, z-index] — bottom row sits in front.
    var slots = [[108, 2, 1], [54, 78, 3], [162, 76, 2], [0, 158, 5], [108, 162, 6], [216, 156, 4]];
    picks.forEach(function (card, i) {
      var s = slots[i % slots.length];
      var img = card.querySelector('img');
      var src = img ? (img.getAttribute('src') || img.src) : '';
      var titleEl = card.querySelector('.info-title');
      var title = (titleEl ? titleEl.textContent : (img ? img.alt : '')) || '';
      var nImg = picks[(i + 1) % picks.length].querySelector('img');
      var side = nImg ? (nImg.getAttribute('src') || nImg.src) : src;
      var df = card.getAttribute('data-full');
      var esc = title.replace(/"/g, '&quot;');
      var cube = document.createElement('a');
      cube.className = 'cube';
      if (df) {
        // image-only artwork: open in the lightbox (no detail page)
        cube.href = '#'; cube.setAttribute('data-full', df);
        cube.setAttribute('data-cap', card.getAttribute('data-cap') || title);
      } else {
        // real project: go to its own page
        cube.href = card.getAttribute('href') || '#work';
        if (card.target) cube.target = card.target;
      }
      cube.style.setProperty('--cx', s[0] + 'px');
      cube.style.setProperty('--cy', s[1] + 'px');
      cube.style.setProperty('--delay', (i * 0.1).toFixed(2) + 's');
      cube.style.setProperty('--dur', (4.4 + (i % 3) * 0.7).toFixed(2) + 's');
      cube.style.zIndex = s[2];
      cube.setAttribute('aria-label', title || 'Artwork');
      cube.innerHTML =
        '<span class="shadow"></span>' +
        '<span class="cube-inner">' +
          '<span class="face f-top"></span>' +
          '<span class="face f-left">' + (side ? '<img src="' + side + '" alt="">' : '') + '</span>' +
          '<span class="face f-front"><img src="' + src + '" alt="' + esc + '"></span>' +
        '</span>';
      host.insertBefore(cube, host.firstChild);
    });
  }

  // Shrink the cone on small screens so it stays inside the viewport.
  var SMALL = window.matchMedia('(max-width: 1023px)').matches;
  var RS = SMALL ? 0.46 : 1;
  var PER_TURN = Math.max(6, Math.min(15, N));
  var TOP_R = 320 * RS, BOT_R = 220 * RS;
  var HEIGHT = Math.min(750, Math.max(160, N * 26)) * (SMALL ? 0.6 : 1);
  var BASE_TILT = -12, AUTO = 0.12, LERP = 0.07;

  cards.forEach(function (card, i) {
    var t = N > 1 ? i / N : 0.5;
    var angle = (i / PER_TURN) * Math.PI * 2;
    var y = t * HEIGHT - HEIGHT / 2;
    var r = TOP_R + (BOT_R - TOP_R) * t;
    var x = Math.sin(angle) * r;
    var z = Math.cos(angle) * r;
    var ry = -(angle * 180) / Math.PI;
    card.style.transform = 'translate3d(' + x + 'px,' + y + 'px,' + z + 'px) rotateY(' + ry + 'deg)';
  });

  var rotY = 0, scrollRot = 0, dragDelta = 0;
  var momentum = 0, prevDelta = 0, vel = 0;
  var curTiltX = BASE_TILT, curTiltZ = 0, tgtTiltX = BASE_TILT, tgtTiltZ = 0;
  var dragging = false, hasDragged = false, startX = 0, startRot = 0;

  function loop() {
    var hovering = wrap.querySelector('.cone-card:hover') !== null;
    rotY += hovering ? AUTO * 0.3 : AUTO;
    if (!dragging && momentum) { rotY += momentum; momentum *= 0.92; if (Math.abs(momentum) < 0.01) momentum = 0; }
    var sMax = document.documentElement.scrollHeight - window.innerHeight;
    scrollRot = (sMax > 0 ? window.scrollY / sMax : 0) * 720;
    curTiltX += (tgtTiltX - curTiltX) * LERP;
    curTiltZ += (tgtTiltZ - curTiltZ) * LERP;
    tilt.style.transform = 'translate(-50%,-50%) rotateX(' + curTiltX + 'deg) rotateZ(' + curTiltZ + 'deg)';
    spin.style.transform = 'rotateY(' + (rotY + scrollRot + dragDelta) + 'deg)';
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  window.addEventListener('mousemove', function (e) {
    var dx = (e.clientX - window.innerWidth / 2) / (window.innerWidth / 2);
    var dy = (e.clientY - window.innerHeight / 2) / (window.innerHeight / 2);
    tgtTiltZ = dx * 8; tgtTiltX = BASE_TILT + dy * -8;
  });

  wrap.addEventListener('pointerdown', function (e) {
    dragging = true; hasDragged = false; startX = e.clientX; startRot = rotY; dragDelta = 0;
    momentum = 0; prevDelta = 0; vel = 0;
    wrap.classList.add('dragging');
    try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
  });
  wrap.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    var dx = e.clientX - startX;
    if (Math.abs(dx) > 5) hasDragged = true;
    dragDelta = dx * 0.5;
    vel = dragDelta - prevDelta; prevDelta = dragDelta;
  });
  function endDrag() {
    if (!dragging) return;
    dragging = false; wrap.classList.remove('dragging');
    rotY = startRot + dragDelta; dragDelta = 0;
    momentum = vel; vel = 0; prevDelta = 0;
  }
  wrap.addEventListener('pointerup', endDrag);
  wrap.addEventListener('pointerleave', endDrag);
  cards.forEach(function (card) {
    card.addEventListener('click', function (e) { if (hasDragged) { e.preventDefault(); e.stopImmediatePropagation(); } });
  });
})();
</script>

<!-- Full collection overlay (opened by the Gallery button) -->
<div class="gallery-modal" id="galleryModal" aria-hidden="true" role="dialog" aria-label="The Collection">
  <div class="gm-head">
    <span class="gm-title">The Collection <span class="gm-count">{{projects.length}} works</span></span>
    <button class="gm-close" id="gmClose" aria-label="Close gallery">[ Close &times; ]</button>
  </div>
  <div class="gm-scroll">
    <div class="gm-grid">
      {{#each projects}}
      {{#if this.coverUrl}}
      <a class="gm-card"{{#if this.slug}} href="{{../portfolioUrl}}/projects/{{this.slug}}"{{else}}{{#if this.link}} href="{{safeUrl this.link}}" target="_blank" rel="noopener"{{else}} href="#" data-full="{{safeUrl this.coverUrl}}" data-cap="{{this.title}}"{{/if}}{{/if}}>
        <div class="gm-ph"><img src="{{safeUrl this.coverUrl}}" alt="{{this.title}}" loading="lazy" decoding="async"></div>
        <div class="gm-meta"><span class="gm-cat">{{#if this.meta.type}}{{this.meta.type}}{{else}}Work{{/if}}</span><span class="gm-ttl">{{this.title}}</span></div>
      </a>
      {{/if}}
      {{/each}}
    </div>
  </div>
</div>

<!-- Gallery quick-view lightbox (for image-only items, no detail page) -->
<div class="lb" id="galLb" aria-hidden="true">
  <span class="lcross lc-tl"></span><span class="lcross lc-tr"></span>
  <span class="lcross lc-bl"></span><span class="lcross lc-br"></span>
  <span class="lb-cap" id="galCap"></span>
  <button class="lb-close" id="galClose" aria-label="Close">[ Close &times; ]</button>
  <div class="lb-stage" id="galStage"><img src="" alt="" id="galImg" draggable="false"></div>
  <div class="lb-ctrl">
    <button id="galOut" aria-label="Zoom out">[ &minus; ]</button>
    <span class="pct" id="galPct">100%</span>
    <button id="galIn" aria-label="Zoom in">[ + ]</button>
  </div>
</div>
<script>
(function () {
  var lb = document.getElementById('galLb');
  var triggers = Array.prototype.slice.call(document.querySelectorAll('[data-full]'));
  if (!lb || !triggers.length) return;
  var img = document.getElementById('galImg'), stage = document.getElementById('galStage');
  var pct = document.getElementById('galPct'), cap = document.getElementById('galCap');
  var scale = 1, ox = 0, oy = 0, dragging = false, sx = 0, sy = 0, sox = 0, soy = 0;
  function apply() { img.style.transform = 'translate(' + ox + 'px,' + oy + 'px) scale(' + scale + ')'; pct.textContent = Math.round(scale * 100) + '%'; img.style.cursor = scale > 1 ? 'grab' : 'default'; }
  function zoom(d) { scale = Math.min(4, Math.max(1, +(scale + d).toFixed(2))); if (scale === 1) { ox = 0; oy = 0; } apply(); }
  function open(src, label) { if (!src) return; img.src = src; img.alt = label || ''; cap.textContent = label || ''; lb.classList.add('open'); lb.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; scale = 1; ox = 0; oy = 0; apply(); }
  function close() { lb.classList.remove('open'); lb.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }
  triggers.forEach(function (el) {
    el.addEventListener('click', function (e) { e.preventDefault(); open(el.getAttribute('data-full'), el.getAttribute('data-cap')); });
  });
  document.getElementById('galClose').addEventListener('click', close);
  document.getElementById('galIn').addEventListener('click', function () { zoom(0.3); });
  document.getElementById('galOut').addEventListener('click', function () { zoom(-0.3); });
  lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
  stage.addEventListener('wheel', function (e) { e.preventDefault(); zoom(e.deltaY < 0 ? 0.3 : -0.3); }, { passive: false });
  stage.addEventListener('pointerdown', function (e) { if (scale <= 1) return; dragging = true; sx = e.clientX; sy = e.clientY; sox = ox; soy = oy; });
  stage.addEventListener('pointermove', function (e) { if (!dragging) return; ox = sox + (e.clientX - sx); oy = soy + (e.clientY - sy); apply(); });
  function up() { dragging = false; }
  stage.addEventListener('pointerup', up); stage.addEventListener('pointerleave', up);
  document.addEventListener('keydown', function (e) { if (!lb.classList.contains('open')) return; if (e.key === 'Escape') { close(); e.stopImmediatePropagation(); } else if (e.key === '+' || e.key === '=') zoom(0.3); else if (e.key === '-' || e.key === '_') zoom(-0.3); });
})();
</script>

<!-- Full collection overlay open/close -->
<script>
(function () {
  var modal = document.getElementById('galleryModal');
  if (!modal) return;
  function openM() { modal.classList.add('open'); modal.setAttribute('aria-hidden', 'false'); document.body.style.overflow = 'hidden'; modal.querySelector('.gm-scroll').scrollTop = 0; }
  function closeM() { modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); if (!document.querySelector('.lb.open')) document.body.style.overflow = ''; }
  Array.prototype.slice.call(document.querySelectorAll('[data-open-gallery]')).forEach(function (el) {
    el.addEventListener('click', function (e) { e.preventDefault(); openM(); });
  });
  var cb = document.getElementById('gmClose');
  if (cb) cb.addEventListener('click', closeM);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && modal.classList.contains('open')) closeM(); });
})();
</script>
{{/if}}

<!-- Mobile nav toggle + scroll reveal -->
<script>
(function () {
  var t = document.getElementById('navToggle'), l = document.getElementById('navLinks');
  if (!t || !l) return;
  t.addEventListener('click', function () {
    var open = l.classList.toggle('open');
    t.classList.toggle('is-open', open);
    t.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  l.addEventListener('click', function (e) {
    if (e.target.closest('a')) { l.classList.remove('open'); t.classList.remove('is-open'); t.setAttribute('aria-expanded', 'false'); }
  });
})();
(function () {
  if (!('IntersectionObserver' in window)) return;
  var sel = '.sec-head, .sec-title, .gal-card, .quote-card, .xp-item, .award-item, .skill-group, .contact-grid > div';
  var els = Array.prototype.slice.call(document.querySelectorAll(sel));
  if (!els.length) return;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  els.forEach(function (el, i) { el.classList.add('reveal'); el.style.transitionDelay = ((i % 6) * 50) + 'ms'; io.observe(el); });
})();
</script>
</body>
</html>
