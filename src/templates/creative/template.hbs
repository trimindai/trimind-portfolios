      <img src="{{safeUrl basics.photoUrl}}" alt="{{basics.fullName}}" width="200" height="240" loading="eager" decoding="async">
      <span class="corner c-tl"></span><span class="corner c-tr"></span>
      <span class="corner c-bl"></span><span class="corner c-br"></span>
    </div>
    {{/if}}
    <h1 class="hero-name">{{basics.fullName}}</h1>
    {{#if basics.subtitle}}<p class="hero-tag">{{basics.subtitle}}</p>{{else}}<p class="hero-tag">{{basics.title}}</p>{{/if}}
    {{#if basics.location}}<p class="hero-loc">{{basics.location}}{{#if basics.nationality}} &middot; {{basics.nationality}}{{/if}}</p>{{/if}}
    {{#if basics.bio}}<p class="hero-bio">{{basics.bio}}</p>{{else}}{{#if basics.valueProposition}}<p class="hero-bio">{{basics.valueProposition}}</p>{{/if}}{{/if}}
    <div class="hero-actions">
      {{#if basics.email}}<a href="mailto:{{basics.email}}" class="cta">Get in Touch <span>&rarr;</span></a>{{/if}}
      {{#if projects}}<a href="#" class="cta cta-ghost" data-open-gallery>View Work <span>&rarr;</span></a>{{/if}}
      {{#if basics.resumeUrl}}<a href="{{safeUrl basics.resumeUrl}}" target="_blank" rel="noopener" class="cta cta-ghost">Download CV <span>&darr;</span></a>{{/if}}
    </div>
  </div>
  <div class="hero-right" id="work">
    {{#if projects}}
    <div class="cone-wrap" id="cone">
      <div class="cone-tilt" id="cone-tilt">
        <div class="cone-spin" id="cone-spin">
          {{#each projects}}
          {{#if this.coverUrl}}
          <a class="cone-card"{{#if this.slug}} href="{{../portfolioUrl}}/projects/{{this.slug}}"{{else}}{{#if this.link}} href="{{safeUrl this.link}}" target="_blank" rel="noopener"{{else}} href="#" data-full="{{safeUrl this.coverUrl}}" data-cap="{{this.title}}"{{/if}}{{/if}}>
            <img src="{{safeUrl this.coverUrl}}" alt="{{this.title}}" loading="lazy" decoding="async" width="148" height="197">
            <div class="overlay"></div>
