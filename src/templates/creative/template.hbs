<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="{{safeColor customization.bgColor "#1b1b1b"}}">
<link rel="canonical" href="{{portfolioUrl}}">
{{{faviconLink basics.fullName customization.accentColor customization.bgColor}}}
<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{basics.fullName}}">
<meta property="og:url" content="{{portfolioUrl}}">
<meta property="og:title" content="{{basics.fullName}} | {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}{{/if}}">
{{#if basics.photoUrl}}<meta property="og:image" content="{{safeUrl basics.photoUrl}}">{{else}}{{#if projects.[0].coverUrl}}<meta property="og:image" content="{{safeUrl projects.[0].coverUrl}}">{{/if}}{{/if}}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{basics.fullName}} | {{basics.title}}">
<meta name="twitter:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{/if}}">
{{#if basics.photoUrl}}<meta name="twitter:image" content="{{safeUrl basics.photoUrl}}">{{else}}{{#if projects.[0].coverUrl}}<meta name="twitter:image" content="{{safeUrl projects.[0].coverUrl}}">{{/if}}{{/if}}
{{{personJsonLd basics portfolioUrl}}}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════════════════
   CREATIVE PORTFOLIO — "Atelier" Warm Editorial Theme
   Four-role palette: Cloud Dancer paper, deep-slate ink,
   Blue Slate (structure/links), Cinnamon Wood (actions),
   Desert Sand (bands, cards, frames). Cone gallery on
   desktop/tablet; stacked photo-cubes on phone.
   ══════════════════════════════════════════════════════ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: {{safeColor customization.bgColor "#EFEEEA"}};   /* Cloud Dancer — paper */
  --bg-alt: #E6DAC6;        /* Desert Sand band */
  --bg-card: #F5F0E7;       /* warm off-white card, lets art pop */
  --sand: #EBBEAA;          /* Desert Sand — frames, dividers, cube tops */
  --text: #1E2A44;          /* deep slate ink (Blue Slate hue, darkened) */
  --text-dim: #4C587A;      /* mid slate */
  --text-muted: #8B8473;    /* warm taupe — mono labels */
  --border: #D8C7AE;        /* sand-tinted hairline */
  --accent: {{safeColor customization.accentColor "#B86F52"}};  /* Cinnamon Wood — actions/labels */
  --accent-dim: rgba(184,111,82,.14);
  --link: #496AB1;          /* Blue Slate — headings, structure, nav, links */
  --blue-band: #3A5489;     /* deep Blue Slate — inverted bands (contact/footer) */
  --font-head: 'Geist', system-ui, sans-serif;
  --font-mono: 'Geist Mono', ui-monospace, monospace;
}
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-head);
  background: var(--bg);
  color: var(--text);
  min-height: 100dvh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
.mono { font-family: var(--font-mono); }
.section-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--link); }

/* ── Navbar ── */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  height: 60px; padding: 0 24px;
  background: rgba(239,238,234,0.82); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--link); transition: color .25s; }
.nav-brand:hover { color: var(--accent); }
.nav-links { display: flex; align-items: center; gap: 24px; }
.nav-link { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); transition: color .25s; }
.nav-link:hover { color: var(--link); }
.nav-link .bk { color: var(--link); }
.nav-toggle { display: none; }
@media (max-width: 768px) {
  .nav-toggle { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 40px; height: 40px; padding: 0; background: none; border: none; cursor: pointer; z-index: 60; }
  .nav-toggle span { display: block; width: 22px; height: 2px; background: var(--text); transition: transform .3s, opacity .3s; }
  .nav-toggle.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .nav-links {
    position: fixed; top: 60px; left: 0; right: 0;
    flex-direction: column; align-items: stretch; gap: 0;
    background: rgba(239,238,234,0.98); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    transform: translateY(-130%); transition: transform .35s cubic-bezier(.16,1,.3,1);
    max-height: calc(100dvh - 60px); overflow-y: auto;
  }
  .nav-links.open { transform: translateY(0); }
  .nav-link { padding: 18px 24px; border-top: 1px solid var(--border); font-size: 14px; }
}

/* ── Hero ── */
.hero {
  position: relative; width: 100%; min-height: 100dvh;
  display: flex; flex-direction: column; align-items: center;
  background: var(--bg);
}
@media (min-width: 1024px) { .hero { flex-direction: row; } }
.hero-left {
  width: 100%; display: flex; flex-direction: column; justify-content: center;
  padding: 96px 24px 48px; order: 1;
}
@media (min-width: 1024px) { .hero-left { width: 36%; padding: 0 40px; order: 1; } }
/* Hero portrait — optional. Renders only when basics.photoUrl is set;
   otherwise the hero is text-led (no empty placeholder). */
.hero-portrait {
  position: relative; width: 200px; height: 240px; margin-bottom: 30px;
  background: var(--sand); padding: 10px; border-radius: 2px;
  box-shadow: 0 18px 40px -20px rgba(72,58,40,0.45);
}
.hero-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 1px; }
.hero-portrait .corner { position: absolute; width: 16px; height: 16px; }
.hero-portrait .c-tl { top: 18px; left: 18px; border-top: 1px solid var(--link); border-left: 1px solid var(--link); }
.hero-portrait .c-tr { top: 18px; right: 18px; border-top: 1px solid var(--link); border-right: 1px solid var(--link); }
.hero-portrait .c-bl { bottom: 18px; left: 18px; border-bottom: 1px solid var(--link); border-left: 1px solid var(--link); }
.hero-portrait .c-br { bottom: 18px; right: 18px; border-bottom: 1px solid var(--link); border-right: 1px solid var(--link); }
.hero-name { font-size: clamp(40px, 6vw, 68px); font-weight: 800; text-transform: uppercase; letter-spacing: -0.04em; line-height: 1.05; margin-bottom: 12px; color: var(--link); }
.hero-tag { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 8px; }
.hero-loc { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 20px; }
.hero-bio { font-size: 13px; color: var(--text-dim); line-height: 1.7; max-width: 340px; margin-bottom: 28px; overflow-wrap: anywhere; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
.cta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); transition: gap .3s; }
.cta:hover { gap: 16px; }
.cta-ghost { color: var(--text-dim); }
.cta-ghost:hover { color: var(--accent); }
/* The cone shows at every size; on mobile it sits below the hero text (order 2)
   and is scaled down (smaller radius via JS + smaller cards below) so it stays
   contained. On desktop it's the 64% side column. */
.hero-right { width: 100%; order: 2; }
@media (min-width: 1024px) { .hero-right { width: 64%; margin-left: -5%; } }

/* ── 3D Cone ── */
.cone-wrap { position: relative; width: 100%; height: 620px; perspective: 1600px; overflow: hidden; cursor: grab; touch-action: pan-y; }
.cone-wrap.dragging { cursor: grabbing; }
@media (max-width: 1023px) {
  .cone-wrap { height: 380px; }
  .cone-card { width: 104px; height: 138px; margin: -69px 0 0 -52px; }
  .cone-hint { font-size: 8px; bottom: 8px; }
}
.cone-tilt { position: absolute; top: 50%; left: 50%; transform-style: preserve-3d; }
.cone-spin { position: relative; transform-style: preserve-3d; }
.cone-card {
  position: absolute; top: 0; left: 0; width: 148px; height: 197px; margin: -98px 0 0 -74px;
  border-radius: 3px; overflow: hidden; transform-style: preserve-3d; backface-visibility: hidden;
  border: 1px solid rgba(30,42,68,0.10); background: var(--bg-card);
  box-shadow: 0 14px 34px -8px rgba(72,58,40,0.40);
}
.cone-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cone-card .overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent 60%); opacity: 0; transition: opacity .3s; }
.cone-card:hover .overlay { opacity: 1; }
.cone-card .info { position: absolute; left: 10px; right: 10px; bottom: 10px; opacity: 0; transform: translateY(6px); transition: all .3s; }
.cone-card:hover .info { opacity: 1; transform: translateY(0); }
.cone-card .info-cat { font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); }
.cone-card .info-title { font-size: 12px; font-weight: 600; line-height: 1.2; }
.cone-hint { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); pointer-events: none; }

/* ── Phone photo-cube cluster (replaces the cone < 768px) ── */
.cube-stack { display: none; }
@media (max-width: 767px) {
  .cone-wrap { display: none !important; }
  .cube-stack {
    display: block; position: relative;
    width: 340px; height: 392px; margin: 10px auto 0;
    perspective: 1150px; perspective-origin: 50% 40%;
  }
}
.cube-stack .cube-hint {
  position: absolute; left: 0; right: 0; bottom: -10px; text-align: center;
  font-family: var(--font-mono); font-size: 10px; text-transform: uppercase;
  letter-spacing: 1.6px; color: var(--text-muted);
}
.cube-stack .cube-hint a { color: var(--link); font-weight: 600; }
.cube {
  --s: 124px;
  position: absolute; width: var(--s); height: var(--s);
  left: var(--cx, 0); top: var(--cy, 0);
  cursor: pointer; -webkit-tap-highlight-color: transparent;
  animation: cubeFloat var(--dur, 5s) ease-in-out var(--delay, 0s) infinite;
}
.cube-inner {
  position: relative; display: block; width: 100%; height: 100%;
  transform-style: preserve-3d;
  transform: rotateX(-26deg) rotateY(-30deg);
  transition: transform .4s cubic-bezier(.16,1,.3,1);
  animation: cubeIn .6s cubic-bezier(.16,1,.3,1) var(--delay, 0s) backwards;
}
.cube:active .cube-inner { transform: rotateX(-26deg) rotateY(-30deg) scale(.93); }
.cube .face {
  position: absolute; width: var(--s); height: var(--s); overflow: hidden;
  background: var(--bg-card); backface-visibility: hidden;
  box-shadow: inset 0 0 0 1px rgba(245,240,231,0.9);
}
.cube .face img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cube .f-front { transform: translateZ(calc(var(--s) / 2)); }
.cube .f-left  { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2)); filter: brightness(.8) saturate(.95); }
.cube .f-top   { transform: rotateX(90deg) translateZ(calc(var(--s) / 2)); background: linear-gradient(135deg, #FBF8F2 0%, var(--sand) 120%); }
.cube .shadow {
  position: absolute; left: 50%; top: 94%; width: 124%; height: 34px;
  transform: translate(-50%, 4px) rotateX(80deg); transform-origin: center top;
  background: radial-gradient(ellipse at center, rgba(72,58,40,0.32), transparent 72%);
  filter: blur(3px); pointer-events: none;
}
@keyframes cubeFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
@keyframes cubeIn { from { opacity: 0; transform: rotateX(-26deg) rotateY(-30deg) scale(.84); } to { opacity: 1; transform: rotateX(-26deg) rotateY(-30deg) scale(1); } }
@media (prefers-reduced-motion: reduce) { .cube { animation: none; } .cube-inner { animation: none; } }

/* ── Marquee ── */
.marquee-row { width: 100%; padding: 20px 0; overflow: hidden; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg); }
.marquee { display: flex; white-space: nowrap; will-change: transform; }
.marquee.rev { animation: marquee-rev 40s linear infinite; }
.marquee:not(.rev) { animation: marquee-fwd 40s linear infinite; }
@keyframes marquee-fwd { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes marquee-rev { from { transform: translateX(-50%); } to { transform: translateX(0); } }
.marquee span { margin: 0 32px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); }
.marquee span .sep { margin-left: 32px; color: var(--border); }

/* ── Section ── */
.section { width: 100%; padding: 80px 24px; }
@media (min-width: 1024px) { .section { padding: 112px 40px; } }
.container { max-width: 1200px; margin: 0 auto; }
.sec-head { display: flex; align-items: center; gap: 16px; margin-bottom: 48px; }
.sec-head .line { flex: 1; height: 1px; background: var(--border); }
.sec-title { font-size: clamp(28px, 4vw, 44px); font-weight: 800; letter-spacing: -0.03em; color: var(--link); }

/* ── Gallery grid ── */
.gal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
@media (min-width: 640px) { .gal-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1024px) { .gal-grid { grid-template-columns: repeat(4, 1fr); } }
.gal-card { position: relative; display: block; overflow: hidden; border: 1px solid var(--border); border-radius: 2px; background: var(--bg-card); }
.gal-card .ph { aspect-ratio: 3/4; overflow: hidden; }
.gal-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.gal-card:hover img { transform: scale(1.05); }
.gal-ov { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; opacity: 0; transition: opacity .3s; background: linear-gradient(to top, rgba(17,17,17,0.94), rgba(17,17,17,0.35) 55%, transparent); }
.gal-card:hover .gal-ov { opacity: 1; }
.gal-ov .cat { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 4px; }
.gal-ov .ttl { font-size: 14px; font-weight: 600; line-height: 1.2; }
.gal-corner { position: absolute; width: 12px; height: 12px; opacity: 0; transition: opacity .3s; }
.gal-card:hover .gal-corner { opacity: 1; }
.gc-tl { top: 8px; left: 8px; border-top: 1px solid var(--accent); border-left: 1px solid var(--accent); }
.gc-tr { top: 8px; right: 8px; border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); }
.gc-bl { bottom: 8px; left: 8px; border-bottom: 1px solid var(--accent); border-left: 1px solid var(--accent); }
.gc-br { bottom: 8px; right: 8px; border-bottom: 1px solid var(--accent); border-right: 1px solid var(--accent); }

/* ── Skills ── */
.skills-wrap { display: flex; flex-direction: column; gap: 32px; }
@media (min-width: 1024px) { .skills-wrap { flex-direction: row; flex-wrap: wrap; gap: 48px; } }
.skill-group { flex: 1; min-width: 240px; }
.skill-group h4 { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); margin-bottom: 16px; }
.pill-row { display: flex; flex-wrap: wrap; gap: 10px; }
.pill { padding: 8px 16px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 2px; transition: all .25s; }
.pill:hover { border-color: var(--accent); color: var(--accent); }

/* ── Experience ── */
.xp-item { padding: 24px 0; border-top: 1px solid var(--border); }
.xp-item h4 { font-size: 18px; font-weight: 700; }
.xp-meta { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin: 4px 0 8px; }
.xp-item p { font-size: 14px; color: var(--text-dim); line-height: 1.6; }

/* ── Awards ── */
.awards-grid { display: flex; flex-direction: column; }
.award-item { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; padding: 20px 0; border-top: 1px solid var(--border); }
.award-item:last-child { border-bottom: 1px solid var(--border); }
.award-name { font-size: 18px; font-weight: 600; }
.award-issuer { font-size: 13px; color: var(--text-muted); margin-left: 12px; font-weight: 400; }
.award-year { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); white-space: nowrap; }

/* ── Contact ── */
.contact-grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
@media (min-width: 768px) { .contact-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .contact-grid { grid-template-columns: repeat(4, 1fr); } }
.contact-grid a, .contact-grid p { font-size: 14px; color: var(--text-dim); transition: color .25s; }
.contact-grid a:hover { color: var(--link); }
.contact-grid .lbl { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); margin-bottom: 12px; }
.contact-flex { display: flex; flex-direction: column; gap: 8px; }

/* ── Footer ── */
.footer { padding: 40px 24px; border-top: 1px solid var(--border); text-align: center; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); }
.footer a:hover { color: var(--sand); }

/* ── Blue Slate closing band (contact + footer) ── */
#contact { background: var(--blue-band); color: #E7E9F0; }
#contact .sec-title { color: #F2EFE8; }
#contact .contact-grid a, #contact .contact-grid p { color: #E9EAF1; }
#contact .contact-grid .lbl { color: var(--sand); }
#contact .contact-grid a:hover { color: var(--sand); }
.footer.footer { background: var(--blue-band); color: rgba(242,239,232,0.6); border-top-color: rgba(255,255,255,0.14); }

/* ── Testimonials ── */
.quotes-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
@media (min-width: 768px) { .quotes-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
.quote-card { position: relative; padding: 32px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 2px; transition: border-color .35s, transform .35s; }
.quote-card:hover { border-color: var(--accent); transform: translateY(-3px); }
.quote-card .mark { font-family: Georgia, 'Times New Roman', serif; font-size: 60px; line-height: .5; color: var(--accent); opacity: .35; }
.quote-card blockquote { font-size: 16px; line-height: 1.65; color: var(--text); margin: 14px 0 22px; }
.quote-card .by { display: flex; flex-direction: column; gap: 3px; }
.quote-card .by .nm { font-size: 14px; font-weight: 600; }
.quote-card .by .rl { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); }

/* ── Scroll reveal (JS adds .reveal then .in; safe-degrades) ── */
.reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }
.reveal.in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1 !important; transform: none !important; transition: none !important; } }

/* ── Motion polish ── */
.marquee:hover { animation-play-state: paused; }
.gal-card img { transition: transform .6s cubic-bezier(.16,1,.3,1); }
.gal-zoom { cursor: zoom-in; border: 1px solid var(--border); background: var(--bg-card); padding: 0; text-align: left; font: inherit; color: inherit; width: 100%; }

/* ── Full collection overlay (Gallery button) ── */
.gallery-modal { position: fixed; inset: 0; z-index: 90; display: none; flex-direction: column; background: var(--bg); }
.gallery-modal.open { display: flex; animation: gmFade .3s ease-out; }
@keyframes gmFade { from { opacity: 0; } to { opacity: 1; } }
.gm-head { display: flex; align-items: center; justify-content: space-between; padding: 18px 24px; border-bottom: 1px solid var(--border); background: rgba(239,238,234,0.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 2; }
.gm-title { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: var(--link); font-weight: 600; }
.gm-count { color: var(--text-muted); margin-left: 8px; }
.gm-close { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-dim); background: none; border: none; cursor: pointer; padding: 6px; }
.gm-close:hover { color: var(--accent); }
.gm-scroll { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.gm-grid { max-width: 1200px; margin: 0 auto; padding: 20px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
@media (min-width: 640px) { .gm-grid { grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 32px; } }
@media (min-width: 1024px) { .gm-grid { grid-template-columns: repeat(4, 1fr); } }
.gm-card { display: block; position: relative; border: 1px solid var(--border); border-radius: 2px; overflow: hidden; background: var(--bg-card); }
.gm-ph { aspect-ratio: 3 / 4; overflow: hidden; }
.gm-card img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.16,1,.3,1); }
.gm-card:hover img { transform: scale(1.05); }
.gm-meta { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 12px; gap: 2px; opacity: 0; transition: opacity .3s; background: linear-gradient(to top, rgba(28,34,52,0.92), transparent 60%); }
.gm-card:hover .gm-meta, .gm-card:focus-visible .gm-meta { opacity: 1; }
.gm-cat { font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--sand); }
.gm-ttl { font-size: 13px; font-weight: 600; color: #F2EFE8; line-height: 1.2; }

/* ── Lightbox (main gallery quick-view) ── */
.lb { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; background: rgba(17,17,17,0.97); }
.lb.open { display: flex; }
.lb .lcross { position: absolute; width: 18px; height: 18px; color: rgba(235,190,170,0.45); }
.lb .lcross::before, .lb .lcross::after { content: ''; position: absolute; background: currentColor; }
.lb .lcross::before { left: 0; top: 50%; width: 100%; height: 1px; transform: translateY(-50%); }
.lb .lcross::after { top: 0; left: 50%; height: 100%; width: 1px; transform: translateX(-50%); }
.lb .lc-tl { top: 20px; left: 20px; } .lb .lc-tr { top: 20px; right: 20px; }
.lb .lc-bl { bottom: 20px; left: 20px; } .lb .lc-br { bottom: 20px; right: 20px; }
.lb-cap { position: absolute; top: 22px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-dim); max-width: 70vw; text-align: center; }
.lb-close { position: absolute; top: 18px; right: 22px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-dim); background: none; border: none; cursor: pointer; }
.lb-close:hover { color: var(--accent); }
.lb-stage { width: 90vw; height: 80vh; display: flex; align-items: center; justify-content: center; overflow: hidden; touch-action: none; }
.lb-stage img { max-width: 100%; max-height: 100%; user-select: none; transition: transform .15s ease-out; }
.lb-ctrl { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 20px; }
.lb-ctrl button { font-family: var(--font-mono); font-size: 16px; color: var(--text-dim); background: none; border: none; cursor: pointer; }
.lb-ctrl button:hover { color: var(--accent); }
.lb-ctrl .pct { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }
</style>
</head>
<body>

<!-- Navbar -->
<header class="nav">
  <a href="#top" class="nav-brand">{{basics.fullName}}</a>
  <button class="nav-toggle" id="navToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
  <nav class="nav-links" id="navLinks">
    {{#if projects}}<a href="#" class="nav-link" data-open-gallery><span class="bk">[</span> Gallery <span class="bk">]</span></a>{{/if}}
    {{#if skills}}<a href="#skills" class="nav-link"><span class="bk">[</span> Skills <span class="bk">]</span></a>{{/if}}
    {{#if certifications}}<a href="#awards" class="nav-link"><span class="bk">[</span> Awards <span class="bk">]</span></a>{{/if}}
    {{#if endorsements}}<a href="#testimonials" class="nav-link"><span class="bk">[</span> Words <span class="bk">]</span></a>{{/if}}
    <a href="#contact" class="nav-link"><span class="bk">[</span> Contact <span class="bk">]</span></a>
  </nav>
</header>

<!-- Hero -->
