<!DOCTYPE html>
<html lang="{{locale}}" dir="{{#if isRTL}}rtl{{else}}ltr{{/if}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{basics.fullName}} — {{basics.title}}</title>
<meta name="description" content="{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}.{{#if basics.subtitle}} {{basics.subtitle}}{{/if}}">
<meta name="theme-color" content="#1b1b1b">
<meta property="og:title" content="{{basics.fullName}} | {{basics.title}}">
<meta property="og:description" content="{{#if basics.subtitle}}{{basics.subtitle}}{{else}}{{basics.title}}{{#if basics.location}} based in {{basics.location}}{{/if}}{{/if}}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════════════════════════
   CREATIVE PORTFOLIO — "My Eye Brain" Dark + Lime Theme
   3D spiral cone gallery for artists & creative pros
   ══════════════════════════════════════════════════════ */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
:root {
  --bg: {{safeColor customization.bgColor "#1b1b1b"}};
  --bg-alt: #151515;
  --bg-card: #111111;
  --text: #e8e8e8;
  --text-dim: #a0a0a0;
  --text-muted: #6a6a6a;
  --border: #2a2a2a;
  --accent: {{safeColor customization.accentColor "#DFFF00"}};
  --font-head: 'Geist', system-ui, sans-serif;
  --font-mono: 'Geist Mono', ui-monospace, monospace;
}
html { scroll-behavior: smooth; }
body {
  font-family: var(--font-head);
  background: var(--bg);
  color: var(--text);
  min-height: 100dvh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
.mono { font-family: var(--font-mono); }
.section-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); }

/* ── Navbar ── */
.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between;
  height: 60px; padding: 0 24px;
  background: rgba(27,27,27,0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}
.nav-brand { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; transition: color .25s; }
.nav-brand:hover { color: var(--accent); }
.nav-links { display: flex; align-items: center; gap: 24px; }
.nav-link { font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); transition: color .25s; }
.nav-link:hover { color: var(--accent); }
.nav-link .bk { color: var(--text-muted); }
@media (max-width: 768px) { .nav-links { display: none; } }

/* ── Hero ── */
.hero {
  position: relative; width: 100%; min-height: 100dvh;
  display: flex; flex-direction: column; align-items: center;
  background: var(--bg);
}
@media (min-width: 1024px) { .hero { flex-direction: row; } }
.hero-left {
  width: 100%; display: flex; flex-direction: column; justify-content: center;
  padding: 96px 24px 48px; order: 1;
}
@media (min-width: 1024px) { .hero-left { width: 36%; padding: 0 40px; order: 1; } }
.monogram {
  position: relative; width: 220px; height: 290px; margin-bottom: 28px;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-card); border: 1px solid var(--border); border-radius: 2px;
}
.monogram .corner { position: absolute; width: 16px; height: 16px; }
.monogram .c-tl { top: 12px; left: 12px; border-top: 1px solid var(--accent); border-left: 1px solid var(--accent); }
.monogram .c-tr { top: 12px; right: 12px; border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); }
.monogram .c-bl { bottom: 12px; left: 12px; border-bottom: 1px solid var(--accent); border-left: 1px solid var(--accent); }
.monogram .c-br { bottom: 12px; right: 12px; border-bottom: 1px solid var(--accent); border-right: 1px solid var(--accent); }
.monogram span { font-size: 72px; font-weight: 900; letter-spacing: -2px; color: var(--accent); opacity: 0.32; user-select: none; }
.hero-name { font-size: clamp(40px, 6vw, 68px); font-weight: 800; text-transform: uppercase; letter-spacing: -0.04em; line-height: 1.05; margin-bottom: 12px; }
.hero-tag { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 8px; }
.hero-loc { font-family: var(--font-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 20px; }
.hero-bio { font-size: 13px; color: var(--text-dim); line-height: 1.7; max-width: 340px; margin-bottom: 28px; overflow-wrap: anywhere; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; }
.cta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); transition: gap .3s; }
.cta:hover { gap: 16px; }
.cta-ghost { color: var(--text-dim); }
.cta-ghost:hover { color: var(--accent); }
.hero-right { width: 100%; order: 2; }
@media (max-width: 767px) { .hero-right { display: none; } }
@media (min-width: 1024px) { .hero-right { width: 64%; order: 2; margin-left: -5%; } }

/* ── 3D Cone ── */
.cone-wrap { position: relative; width: 100%; height: 620px; perspective: 1600px; overflow: hidden; cursor: grab; touch-action: pan-y; }
.cone-wrap.dragging { cursor: grabbing; }
@media (max-width: 1023px) { .cone-wrap { height: 460px; } }
.cone-tilt { position: absolute; top: 50%; left: 50%; transform-style: preserve-3d; }
.cone-spin { position: relative; transform-style: preserve-3d; }
.cone-card {
  position: absolute; top: 0; left: 0; width: 148px; height: 197px; margin: -98px 0 0 -74px;
  border-radius: 3px; overflow: hidden; transform-style: preserve-3d; backface-visibility: hidden;
  border: 1px solid rgba(255,255,255,0.06); background: var(--bg-card);
  box-shadow: 0 12px 30px rgba(0,0,0,0.5);
}
.cone-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cone-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 10px; background: linear-gradient(135deg, #222, #141414); }
.cone-fallback span { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }
.cone-card .overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), transparent 60%); opacity: 0; transition: opacity .3s; }
.cone-card:hover .overlay { opacity: 1; }
.cone-card .info { position: absolute; left: 10px; right: 10px; bottom: 10px; opacity: 0; transform: translateY(6px); transition: all .3s; }
.cone-card:hover .info { opacity: 1; transform: translateY(0); }
.cone-card .info-cat { font-family: var(--font-mono); font-size: 8px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); }
.cone-card .info-title { font-size: 12px; font-weight: 600; line-height: 1.2; }
.cone-hint { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); pointer-events: none; }

/* ── Marquee ── */
.marquee-row { width: 100%; padding: 20px 0; overflow: hidden; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg); }
.marquee { display: flex; white-space: nowrap; will-change: transform; }
.marquee.rev { animation: marquee-rev 40s linear infinite; }
.marquee:not(.rev) { animation: marquee-fwd 40s linear infinite; }
@keyframes marquee-fwd { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes marquee-rev { from { transform: translateX(-50%); } to { transform: translateX(0); } }
.marquee span { margin: 0 32px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: var(--text-muted); }
.marquee span .sep { margin-left: 32px; color: var(--border); }

/* ── Section ── */
.section { width: 100%; padding: 80px 24px; }
@media (min-width: 1024px) { .section { padding: 112px 40px; } }
.container { max-width: 1200px; margin: 0 auto; }
.sec-head { display: flex; align-items: center; gap: 16px; margin-bottom: 48px; }
.sec-head .line { flex: 1; height: 1px; background: var(--border); }
.sec-title { font-size: clamp(28px, 4vw, 44px); font-weight: 800; letter-spacing: -0.03em; }

/* ── Gallery grid ── */
.gal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
@media (min-width: 640px) { .gal-grid { grid-template-columns: repeat(3, 1fr); } }
@media (min-width: 1024px) { .gal-grid { grid-template-columns: repeat(4, 1fr); } }
.gal-card { position: relative; display: block; overflow: hidden; border: 1px solid var(--border); border-radius: 2px; background: var(--bg-card); }
.gal-card .ph { aspect-ratio: 3/4; overflow: hidden; }
.gal-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s; }
.gal-card:hover img { transform: scale(1.05); }
.gal-fallback { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; text-align: center; padding: 16px; background: linear-gradient(135deg, #222, #141414); }
.gal-fallback span { font-family: var(--font-mono); font-size: 12px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }
.gal-ov { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; opacity: 0; transition: opacity .3s; background: linear-gradient(to top, rgba(17,17,17,0.94), rgba(17,17,17,0.35) 55%, transparent); }
.gal-card:hover .gal-ov { opacity: 1; }
.gal-ov .cat { font-family: var(--font-mono); font-size: 9px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent); margin-bottom: 4px; }
.gal-ov .ttl { font-size: 14px; font-weight: 600; line-height: 1.2; }
.gal-corner { position: absolute; width: 12px; height: 12px; opacity: 0; transition: opacity .3s; }
.gal-card:hover .gal-corner { opacity: 1; }
.gc-tl { top: 8px; left: 8px; border-top: 1px solid var(--accent); border-left: 1px solid var(--accent); }
.gc-tr { top: 8px; right: 8px; border-top: 1px solid var(--accent); border-right: 1px solid var(--accent); }
.gc-bl { bottom: 8px; left: 8px; border-bottom: 1px solid var(--accent); border-left: 1px solid var(--accent); }
.gc-br { bottom: 8px; right: 8px; border-bottom: 1px solid var(--accent); border-right: 1px solid var(--accent); }

/* ── Skills ── */
.skills-wrap { display: flex; flex-direction: column; gap: 32px; }
@media (min-width: 1024px) { .skills-wrap { flex-direction: row; flex-wrap: wrap; gap: 48px; } }
.skill-group { flex: 1; min-width: 240px; }
.skill-group h4 { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); margin-bottom: 16px; }
.pill-row { display: flex; flex-wrap: wrap; gap: 10px; }
.pill { padding: 8px 16px; font-family: var(--font-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 2px; transition: all .25s; }
.pill:hover { border-color: var(--accent); color: var(--accent); }

/* ── Experience ── */
.xp-item { padding: 24px 0; border-top: 1px solid var(--border); }
.xp-item h4 { font-size: 18px; font-weight: 700; }
.xp-meta { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); margin: 4px 0 8px; }
.xp-item p { font-size: 14px; color: var(--text-dim); line-height: 1.6; }

/* ── Awards ── */
.awards-grid { display: flex; flex-direction: column; }
.award-item { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; padding: 20px 0; border-top: 1px solid var(--border); }
.award-item:last-child { border-bottom: 1px solid var(--border); }
.award-name { font-size: 18px; font-weight: 600; }
.award-issuer { font-size: 13px; color: var(--text-muted); margin-left: 12px; font-weight: 400; }
.award-year { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--accent); white-space: nowrap; }

/* ── Contact ── */
.contact-grid { display: grid; grid-template-columns: 1fr; gap: 32px; }
@media (min-width: 768px) { .contact-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .contact-grid { grid-template-columns: repeat(4, 1fr); } }
.contact-grid a, .contact-grid p { font-size: 14px; color: var(--text-dim); transition: color .25s; }
.contact-grid a:hover { color: var(--accent); }
.contact-grid .lbl { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); margin-bottom: 12px; }
.contact-flex { display: flex; flex-direction: column; gap: 8px; }

/* ── Footer ── */
.footer { padding: 40px 24px; border-top: 1px solid var(--border); text-align: center; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); }
.footer a:hover { color: var(--accent); }
</style>
</head>
<body>

<!-- Navbar -->
<header class="nav">
  <a href="#top" class="nav-brand">{{basics.fullName}}</a>
  <nav class="nav-links">
    {{#if projects}}<a href="#gallery" class="nav-link"><span class="bk">[</span> Gallery <span class="bk">]</span></a>{{/if}}
    {{#if skills}}<a href="#skills" class="nav-link"><span class="bk">[</span> Skills <span class="bk">]</span></a>{{/if}}
    {{#if certifications}}<a href="#awards" class="nav-link"><span class="bk">[</span> Awards <span class="bk">]</span></a>{{/if}}
    <a href="#contact" class="nav-link"><span class="bk">[</span> Contact <span class="bk">]</span></a>
  </nav>
</header>

<!-- Hero -->
<section class="hero" id="top">
  <div class="hero-left">
    <div class="monogram">
      <span class="corner c-tl"></span><span class="corner c-tr"></span>
      <span class="corner c-bl"></span><span class="corner c-br"></span>
      <span>{{initials basics.fullName}}</span>
    </div>
    <h1 class="hero-name">{{basics.fullName}}</h1>
    {{#if basics.subtitle}}<p class="hero-tag">{{basics.subtitle}}</p>{{else}}<p class="hero-tag">{{basics.title}}</p>{{/if}}
    {{#if basics.location}}<p class="hero-loc">{{basics.location}}{{#if basics.nationality}} &middot; {{basics.nationality}}{{/if}}</p>{{/if}}
    {{#if basics.bio}}<p class="hero-bio">{{basics.bio}}</p>{{else}}{{#if basics.valueProposition}}<p class="hero-bio">{{basics.valueProposition}}</p>{{/if}}{{/if}}
    <div class="hero-actions">
      {{#if basics.email}}<a href="mailto:{{basics.email}}" class="cta">Get in Touch <span>&rarr;</span></a>{{/if}}
      {{#if projects}}<a href="#gallery" class="cta cta-ghost">View Work <span>&rarr;</span></a>{{/if}}
    </div>
  </div>
  <div class="hero-right">
    {{#if projects}}
    <div class="cone-wrap" id="cone">
      <div class="cone-tilt" id="cone-tilt">
        <div class="cone-spin" id="cone-spin">
          {{#each projects}}
          <a class="cone-card"{{#if this.slug}} href="{{../portfolioUrl}}/projects/{{this.slug}}"{{else}}{{#if this.link}} href="{{safeUrl this.link}}" target="_blank" rel="noopener"{{/if}}{{/if}}>
            {{#if this.coverUrl}}<img src="{{safeUrl this.coverUrl}}" alt="{{this.title}}" loading="lazy">{{else}}<div class="cone-fallback"><span>{{this.title}}</span></div>{{/if}}
            <div class="overlay"></div>
            <div class="info">
              <div class="info-cat">{{#if this.meta.type}}{{this.meta.type}}{{else}}{{#if this.technologies.[0]}}{{this.technologies.[0]}}{{else}}Work{{/if}}{{/if}}</div>
              <div class="info-title">{{this.title}}</div>
            </div>
          </a>
          {{/each}}
        </div>
      </div>
      <div class="cone-hint">Drag to explore</div>
    </div>
    {{/if}}
  </div>
</section>

{{#if skills}}
<!-- Skills marquee -->
<div class="marquee-row">
  <div class="marquee">
    {{#each skills}}{{#each this.items}}<span>{{this}}<span class="sep">//</span></span>{{/each}}{{/each}}
    {{#each skills}}{{#each this.items}}<span>{{this}}<span class="sep">//</span></span>{{/each}}{{/each}}
  </div>
</div>
{{/if}}

{{#if projects}}
{{#unless (isHidden "portfolio-showcase")}}
<!-- Gallery grid -->
<section class="section" id="gallery" style="background: var(--bg-alt);">
  <div class="container">
    <div class="sec-head"><span class="section-label">The Collection</span><span class="line"></span></div>
    <h2 class="sec-title" style="margin-bottom: 8px;">Selected Work</h2>
    <p class="mono" style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--text-muted);margin-bottom:40px;">{{projects.length}} Projects</p>
    <div class="gal-grid">
      {{#each projects}}
      <a class="gal-card"{{#if this.slug}} href="{{../portfolioUrl}}/projects/{{this.slug}}"{{else}}{{#if this.link}} href="{{safeUrl this.link}}" target="_blank" rel="noopener"{{/if}}{{/if}}>
        <div class="ph">
          {{#if this.coverUrl}}<img src="{{safeUrl this.coverUrl}}" alt="{{this.title}}" loading="lazy">{{else}}<div class="gal-fallback"><span>{{this.title}}</span></div>{{/if}}
        </div>
        <div class="gal-ov">
          <div class="cat">{{#if this.meta.type}}{{this.meta.type}}{{else}}{{#if this.technologies.[0]}}{{this.technologies.[0]}}{{else}}Work{{/if}}{{/if}}</div>
          <div class="ttl">{{this.title}}</div>
        </div>
        <span class="gal-corner gc-tl"></span><span class="gal-corner gc-tr"></span>
        <span class="gal-corner gc-bl"></span><span class="gal-corner gc-br"></span>
      </a>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

{{#if skills}}
{{#unless (isHidden "skills")}}
<!-- Skills -->
<section class="section" id="skills">
  <div class="container">
    <div class="sec-head"><span class="section-label">Skills &amp; Tools</span><span class="line"></span></div>
    <div class="skills-wrap">
      {{#each skills}}
      <div class="skill-group">
        <h4>{{this.category}}</h4>
        <div class="pill-row">{{#each this.items}}<span class="pill">{{this}}</span>{{/each}}</div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

{{#if experience}}
{{#unless (isHidden "experience")}}
<!-- Experience -->
<section class="section" id="experience" style="background: var(--bg-alt);">
  <div class="container">
    <div class="sec-head"><span class="section-label">Journey</span><span class="line"></span></div>
    {{#each experience}}
    <div class="xp-item">
      <h4>{{this.title}}</h4>
      <div class="xp-meta">{{this.company}}{{#if this.startDate}} &middot; {{this.startDate}}{{#if this.endDate}} – {{this.endDate}}{{else}} – Present{{/if}}{{/if}}</div>
      {{#if this.description}}<p>{{this.description}}</p>{{/if}}
    </div>
    {{/each}}
  </div>
</section>
{{/unless}}
{{/if}}

{{#if certifications}}
{{#unless (isHidden "awards")}}
<!-- Awards & Certifications -->
<section class="section" id="awards">
  <div class="container">
    <div class="sec-head"><span class="section-label">Recognition</span><span class="line"></span></div>
    <h2 class="sec-title" style="margin-bottom: 40px;">Awards &amp; Certifications</h2>
    <div class="awards-grid">
      {{#each certifications}}
      <div class="award-item">
        <div><span class="award-name">{{this.name}}</span>{{#if this.issuer}}<span class="award-issuer">{{this.issuer}}</span>{{/if}}</div>
        {{#if this.year}}<span class="award-year">{{this.year}}</span>{{/if}}
      </div>
      {{/each}}
    </div>
  </div>
</section>
{{/unless}}
{{/if}}

{{#if metrics}}
<!-- Metrics marquee -->
<div class="marquee-row">
  <div class="marquee rev">
    {{#each metrics}}<span>{{this.value}} {{this.label}}<span class="sep">//</span></span>{{/each}}
    {{#each metrics}}<span>{{this.value}} {{this.label}}<span class="sep">//</span></span>{{/each}}
  </div>
</div>
{{/if}}

<!-- Contact -->
<section class="section" id="contact">
  <div class="container">
    <h2 class="sec-title" style="margin-bottom: 12px;">Let's create something together</h2>
    <p class="mono" style="font-size:11px;text-transform:uppercase;letter-spacing:1.5px;color:var(--accent);margin-bottom:48px;">Open for work</p>
    <div class="contact-grid">
      {{#if basics.email}}<div><p class="lbl">Email</p><a href="mailto:{{basics.email}}">{{basics.email}}</a></div>{{/if}}
      {{#if basics.phone}}<div><p class="lbl">Phone</p><a href="tel:{{basics.phone}}">{{basics.phone}}</a></div>{{/if}}
      {{#if (or basics.instagram basics.linkedin basics.github basics.website)}}
      <div><p class="lbl">Social</p><div class="contact-flex">
        {{#if basics.instagram}}<a href="{{safeUrl basics.instagram}}" target="_blank" rel="noopener">Instagram</a>{{/if}}
        {{#if basics.linkedin}}<a href="{{safeUrl basics.linkedin}}" target="_blank" rel="noopener">LinkedIn</a>{{/if}}
        {{#if basics.github}}<a href="{{safeUrl basics.github}}" target="_blank" rel="noopener">GitHub</a>{{/if}}
        {{#if basics.website}}<a href="{{safeUrl basics.website}}" target="_blank" rel="noopener">Website</a>{{/if}}
      </div></div>
      {{/if}}
      {{#if basics.location}}<div><p class="lbl">Location</p><p>{{basics.location}}</p></div>{{/if}}
    </div>
  </div>
</section>

<footer class="footer">
  &copy; {{basics.fullName}} &middot; <a href="{{portfolioUrl}}">{{portfolioUrl}}</a>
</footer>

{{#if projects}}
<script>
(function () {
  var wrap = document.getElementById('cone');
  if (!wrap) return;
  var tilt = document.getElementById('cone-tilt');
  var spin = document.getElementById('cone-spin');
  var cards = Array.prototype.slice.call(wrap.querySelectorAll('.cone-card'));
  var N = cards.length;
  if (!N) return;

  var PER_TURN = Math.max(6, Math.min(15, N));
  var TOP_R = 320, BOT_R = 220;
  var HEIGHT = Math.min(750, Math.max(160, N * 26));
  var BASE_TILT = -12, AUTO = 0.12, LERP = 0.07;

  cards.forEach(function (card, i) {
    var t = N > 1 ? i / N : 0.5;
    var angle = (i / PER_TURN) * Math.PI * 2;
    var y = t * HEIGHT - HEIGHT / 2;
    var r = TOP_R + (BOT_R - TOP_R) * t;
    var x = Math.sin(angle) * r;
    var z = Math.cos(angle) * r;
    var ry = -(angle * 180) / Math.PI;
    card.style.transform = 'translate3d(' + x + 'px,' + y + 'px,' + z + 'px) rotateY(' + ry + 'deg)';
  });

  var rotY = 0, scrollRot = 0, dragDelta = 0;
  var curTiltX = BASE_TILT, curTiltZ = 0, tgtTiltX = BASE_TILT, tgtTiltZ = 0;
  var dragging = false, hasDragged = false, startX = 0, startRot = 0;

  function loop() {
    var hovering = wrap.querySelector('.cone-card:hover') !== null;
    rotY += hovering ? AUTO * 0.3 : AUTO;
    var sMax = document.documentElement.scrollHeight - window.innerHeight;
    scrollRot = (sMax > 0 ? window.scrollY / sMax : 0) * 720;
    curTiltX += (tgtTiltX - curTiltX) * LERP;
    curTiltZ += (tgtTiltZ - curTiltZ) * LERP;
    tilt.style.transform = 'translate(-50%,-50%) rotateX(' + curTiltX + 'deg) rotateZ(' + curTiltZ + 'deg)';
    spin.style.transform = 'rotateY(' + (rotY + scrollRot + dragDelta) + 'deg)';
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(loop);

  window.addEventListener('mousemove', function (e) {
    var dx = (e.clientX - window.innerWidth / 2) / (window.innerWidth / 2);
    var dy = (e.clientY - window.innerHeight / 2) / (window.innerHeight / 2);
    tgtTiltZ = dx * 8; tgtTiltX = BASE_TILT + dy * -8;
  });

  wrap.addEventListener('pointerdown', function (e) {
    dragging = true; hasDragged = false; startX = e.clientX; startRot = rotY; dragDelta = 0;
    wrap.classList.add('dragging');
    try { e.target.setPointerCapture(e.pointerId); } catch (_) {}
  });
  wrap.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    var dx = e.clientX - startX;
    if (Math.abs(dx) > 5) hasDragged = true;
    dragDelta = dx * 0.5;
  });
  function endDrag() {
    if (!dragging) return;
    dragging = false; wrap.classList.remove('dragging');
    rotY = startRot + dragDelta; dragDelta = 0;
  }
  wrap.addEventListener('pointerup', endDrag);
  wrap.addEventListener('pointerleave', endDrag);
  cards.forEach(function (card) {
    card.addEventListener('click', function (e) { if (hasDragged) { e.preventDefault(); } });
  });
})();
</script>
{{/if}}
</body>
</html>
